# 仅供本机开发；复制到 backend/.env。生产环境文件单独管理，禁止复制本文件到服务器。
# 推荐用 `pnpm setup` 一键安装：选择数据库→自动生成下列 DATABASE_URL / DB_PROVIDER 并建表。
ENTERPRISE_ENV=development
NODE_ENV=development
# 数据库二选一（Prisma 一方言一 Client，安装时按所选生成）：
#   DB_PROVIDER=mysql     DATABASE_URL=mysql://user:pass@127.0.0.1:3306/enterprise
#   DB_PROVIDER=postgres  DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/enterprise?schema=public
# DB_PROVIDER 缺省时由 DATABASE_URL 协议自动推断。
DB_PROVIDER=mysql
DATABASE_URL=mysql://enterprise:change-me@127.0.0.1:3306/enterprise
PORT=1690
JWT_ISSUER=aipdd-java-core
# 必须与所选 Java 环境的 JWT 签发配置匹配；下列占位值不能用于线上账号验签，缺失时后端拒绝启动。
JWT_SECRET=change-this-local-development-secret
# 默认使用线上 Java；核对 JWT 验签配置。本机上游仅在明确需要时覆盖（见 README）。
JAVA_BASE_URL=https://api.aipdd.work
INTERNAL_TOKEN=aipdd-internal-dev-token-change-me
JAVA_REQUEST_TIMEOUT_MS=5000
# 默认使用线上 AIworkin；平台写操作会作用于线上，使用专用测试账号。
AIWORKIN_BASE_URL=https://api.aiworkin.com
AIWORKIN_ENABLED=true
AIWORKIN_REQUEST_TIMEOUT_MS=5000
AIWORKIN_RETRY_COUNT=2
# AIworkin 社交（SNS）：给职员/代理人发私信、把 SNS 通知合并进本系统铃铛。
# 令牌用同一 JWT_SECRET 按当前账号临时签发（5 分钟），本系统不保存 SNS 密码或长期令牌。
# SNS 前台地址只用于通知里的「去处理」链接，留空则不给链接。
SNS_BASE_URL=http://127.0.0.1:1692
SNS_WEB_URL=
# 应用市场：只读代理外部公开应用目录（不落库、不代上架/评价）。地址留空即用默认目录。
APP_DIRECTORY_URL=https://app.chandler.work
# 以下三项留空即用默认：上游超时 6000ms、缓存新鲜期 60000ms、熔断 30000ms。
APP_DIRECTORY_TIMEOUT_MS=
APP_DIRECTORY_CACHE_TTL_MS=
APP_DIRECTORY_BREAKER_MS=
# 外报凭据（CA/UKey、服务商密钥）加密密钥：AES-256-GCM 派生来源，必须单独配置（不回退 JWT_SECRET）
EXTERNAL_CRED_KEY=change-this-external-credential-key
CORS_ORIGIN_PATTERNS=http://localhost:15890,http://127.0.0.1:15890
# 站点对外访问地址兜底（可选，只认 http/https）：MCP / API 接入端点、IM 与支付回调地址、
# 客服嵌入脚本、活码入口、邀请链接等绝对地址统一用它拼接。
# 优先级：「平台管理后台 → 站点设置 → 站点域名」 > 本变量 > 访客当前访问地址（前端）。
# 本机开发留空即可（绝对地址跟访客当前访问地址拼）。
SITE_URL=

# 发票 OCR 通过企享云 REST API，复用后台「系统配置」的企享云 AppKey/Secret；未保存时使用下列部署凭据。
# 企享云 MCP（报税=企税申报服务 / 开票=数电开票服务）：凭据在每次工具调用参数里传 client_appkey + client_secret
QXY_MCP_BASE=https://mcp.qixiangyun.com
QXY_APPKEY=
QXY_SECRET=

# 附件存储（阿里云 OSS）：优先使用「平台管理后台 → 系统配置 → 文件存储」保存的加密配置；
# 这里的值仅作未保存时的回退，源码不写死。
# 建议该 AccessKey 的 RAM 权限收敛到 aiworkinenterprise/asset/* 的 PUT / GET
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 使用 STS 临时凭据时，与上述 AccessKey 成套配置；长期 AccessKey 留空
OSS_SECURITY_TOKEN=

# GEO 采集平台（营销服务 → 📊 GEO 分析）：十二家平台的 API Key 与模型 / 接口地址
# 一律在「平台管理后台 → GEO管理设置」里配置（AES-256-GCM 密文落库、保存即生效、任何接口都不回显）。
# 本文件不再放 GEO 平台密钥，也不存在 .env 回落：后台没配过的平台前台就不可用。
# 「观测解析」默认用豆包文本模型，同样在管理后台填模型名或接入点 ep-xxxxxxxx。

# 测试用平台 Key（可选）：格式 `账号或userId:sk-Key`，只在账号自己的「API Key 管理」查不到 Key 时兜底。
# 仅开发/测试环境生效，生产（ENTERPRISE_ENV=production）强制忽略；正式环境用户自带 Key。
CONTENT_TEST_AIPDD_KEY=

# AIPDD 注册引导（可选）：推荐码仅在全新库（管理员从未在站点设置保存过）时作默认值；注册地址仅认 http/https。
# AIPDD_REFERRAL_CODE=
# AIPDD_REGISTER_URL=https://www.aipdd.work

# 平台级 AIPDD APIKey（可选兜底）：用于省市字典、平台字典项等基础数据调用。
# 首选在「平台管理后台 → 系统配置 → AIPDD 平台 Key」保存（AES-256-GCM 密文落库、只回掩码），
# 后台保存过即以库内密文为准，本变量仅作未保存时的部署兜底；用户业务动作仍用各自绑定的 Key。
# AIPDD_PLATFORM_KEY=

# 默认语言（可选，仅全新库时作默认值）：zh-CN / en / vi / ja / ar / fr / es / ru；管理员可在站点设置里改，前台访客可随时切换
# SITE_DEFAULT_LANGUAGE=zh-CN

# SkillHub 技能中心（Agent → 技能 → 技能中心）的上游地址，默认 https://api.skillhub.cn。
# 公开只读目录，无需 Key；只有镜像/代理时才需要改。
SKILLHUB_BASE_URL=

# 会话与独立 Worker
DEV_AUTO_LOGIN=false
DEV_SESSION_USER=demo_enterprise
AUTH_COOKIE_SECURE=false
# 跨站登录：www.aiworkin.com / app.aipdd.work 跳到 enterprise.aiworkin.com 时带过来的会话令牌
# 用本系统向平台换取用户标识；地址留空则跟随 JAVA_BASE_URL。
SSO_PLATFORM_API_URL=
SSO_PLATFORM_USERINFO_PATH=/info
# 换成「本系统会话」后的有效期（秒），默认 172800（48 小时）；到期后需重新从平台进入或登录。
SSO_SESSION_TTL_SECONDS=172800
GEO_WORKER_PORT=1695
# API 默认 10、Worker 默认 4；同时核算其他服务及维护连接。
# DB_POOL_SIZE=10
GEO_AUTO_COLLECT_TICK_MS=60000
