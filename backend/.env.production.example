# 生产部署模板：请复制为服务器上的受控文件（如 shared/backend.env.production，权限 600）后填写真实值。
# 禁止从开发 .env 复制凭据 / 加密密钥 / 数据库连接覆盖本配置；下列均为占位符，不含任何真实密钥。
ENTERPRISE_ENV=production
NODE_ENV=production

# 数据库：MySQL 8 连接串，替换为生产库账号密码
DATABASE_URL=mysql://ae_prod:REPLACE_WITH_PRODUCTION_PASSWORD@127.0.0.1:3306/enterprise

HOST=127.0.0.1
PORT=1690

# 本地会话 JWT 签名：生产必须替换为强随机值（缺失或非随机时后端拒绝启动）
JWT_ISSUER=oem-enterprise
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET

# AIPDD Key / 外报凭据的 AES-256-GCM 派生密钥：单独生成、永不回退 JWT_SECRET；
# 若已有环境必须保留原值，否则无法解密库中已存的凭据。
EXTERNAL_CRED_KEY=REPLACE_WITH_EXISTING_PRODUCTION_CREDENTIAL_KEY

# 上游市场（AIworkin）：不需要上游联动时可置 AIWORKIN_ENABLED=false，仅保留本地闭环
JAVA_BASE_URL=https://api.aipdd.work
INTERNAL_TOKEN=
JAVA_REQUEST_TIMEOUT_MS=5000
AIWORKIN_BASE_URL=https://api.aiworkin.com
AIWORKIN_ENABLED=true
AIWORKIN_REQUEST_TIMEOUT_MS=5000
AIWORKIN_RETRY_COUNT=2

# 本地账户：AIPDD Key 绑定在线验真开关（on 会调用上游核验；离线演示可置 off）
AIPDD_KEY_VERIFY=on
# 平台级 AIPDD APIKey（基础数据：省市字典、平台字典项）：建议直接在
# 「平台管理后台 → 系统配置 → AIPDD 平台 Key」保存（加密落库、只回掩码，优先级高于本变量）；
# 本变量仅供无法进入后台的首次部署使用，与 EXTERNAL_CRED_KEY 无依赖关系。
# AIPDD_PLATFORM_KEY=
# AIPDD 注册引导默认值（可选）：推荐码仅在全新库（管理员从未在站点设置保存过）时生效，
# 管理员在「站点设置」保存过任意值（含清空）后以库内值为准；注册地址仅认 http/https。
# AIPDD_REFERRAL_CODE=
# AIPDD_REGISTER_URL=https://www.aipdd.work
# 首次启动种子出的平台管理员（生产请务必登录后改密，或部署前替换）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_PRODUCTION_ADMIN_PASSWORD

# 应用市场只读目录：留空即用默认
APP_DIRECTORY_URL=

# CORS：替换为实际对外域名（逗号分隔），生产建议开启安全 Cookie
CORS_ORIGIN_PATTERNS=https://your-enterprise-domain.example
AUTH_COOKIE_SECURE=true

# 站点对外访问地址（只认 http/https）：IM 卡片「去处理」链接、MCP / API 端点展示、
# 客服嵌入脚本等绝对地址的拼接基础地址；管理员在「站点设置 → 站点域名」填过则以库内值为准。
# 后台填的域名会自动并入 CORS 白名单（保存即生效），本变量改动后需重启。
SITE_URL=https://your-enterprise-domain.example

# 跨站登录（可选，不使用平台 SSO 时留空）
SSO_PLATFORM_API_URL=
SSO_PLATFORM_USERINFO_PATH=/info
SSO_SESSION_TTL_SECONDS=172800

# 企享云 / OSS / GEO 平台密钥：一律在「平台管理后台 → 系统设置」里配置（密文落库、不回显），
# 本文件不放这些密钥；如需以环境变量兜底，请在部署环境单独注入。
QXY_MCP_BASE=https://mcp.qixiangyun.com
QXY_APPKEY=
QXY_SECRET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=

# 社交前台地址仅用于通知「去处理」链接，留空则不给链接
SNS_BASE_URL=http://127.0.0.1:1692
SNS_WEB_URL=

# GEO 采集 Worker
GEO_WORKER_PORT=1695
GEO_AUTO_COLLECT_TICK_MS=60000
