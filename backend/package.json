{
  "name": "aiworkin-enterprise-api",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node ../scripts/run-with-environment.mjs --environment production -- node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config ./test/jest-unit.json",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "node ../scripts/gen-prisma-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push": "prisma db push",
    "db:push:pg": "node ../scripts/gen-prisma-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "node ../scripts/prisma-migrate-deploy.mjs",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "db:normalize-usernames": "tsx scripts/normalize-usernames.ts",
    "postinstall": "node ../scripts/prisma-generate-auto.mjs",
    "worker": "tsx src/geo/worker.ts",
    "worker:dev": "tsx watch src/geo/worker.ts",
    "worker:prod": "node ../scripts/run-with-environment.mjs --environment production -- node dist/geo/worker.js"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@enterprise/contracts": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "imap": "^0.8.19",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/imap": "^0.8.43",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
