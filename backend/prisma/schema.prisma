  answer     String   @default("") @db.Text
  model      String   @default("") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("assistant_page_queries")
}

/// 会议/面试录音转写（B2#16）：音频只做转写不长期落盘，正文与摘要落库
model AiTranscript {
