/// 资产交易需求（资产租售与居间服务，界面与流程参照物流服务）
model AssetRequest {
  id                   Int      @id @default(autoincrement())
  requestNo            String   @unique @map("request_no") @db.VarChar(32)
  contractId           Int      @default(0) @map("contract_id")
  enterpriseId         Int      @default(0) @map("enterprise_id")
  createdBy            String   @map("created_by") @db.VarChar(64)
  providerUserId       String   @default("") @map("provider_user_id") @db.VarChar(64)
  staffUserId          String   @default("") @map("staff_user_id") @db.VarChar(64)
  brokerName           String   @default("") @map("broker_name") @db.VarChar(200)
  /// 二级类目（AIworkin 资产租售与居间服务子类目 UUID，发布需求必填）
  subCategoryId        String   @default("") @map("sub_category_id") @db.VarChar(64)
  title                String   @db.VarChar(200)
  description          String   @db.Text
  tags                 String   @default("") @db.VarChar(200)
  budget               String   @default("") @db.VarChar(120)
  expectedResult       String   @default("") @map("expected_result") @db.VarChar(300)
  mustConditions       String   @default("") @map("must_conditions") @db.VarChar(300)
  expectStart          String   @default("") @map("expect_start") @db.VarChar(32)
  deadline             String   @default("") @db.VarChar(32)
  regionScope          String   @default("") @map("region_scope") @db.VarChar(200)
  /// 地域范围三态（NONE 不限制 / REGION 指定地区 / RADIUS 经纬度坐标），跟着需求本身走
  regionMode           String   @default("NONE") @map("region_mode") @db.VarChar(16)
  /// 需求所在地省、市（RADIUS 由经纬度解析得到；不限制时为空）
  province             String   @default("") @db.VarChar(48)
  city                 String   @default("") @db.VarChar(48)
  longitude            Float?
  latitude             Float?
  radiusKm             Float?   @map("radius_km")
  emailSync            Int      @default(0) @map("email_sync")
  contactName          String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String   @default("") @map("contact_phone") @db.VarChar(32)
  contactWechat        String   @default("") @map("contact_wechat") @db.VarChar(64)
  contactEmail         String   @default("") @map("contact_email") @db.VarChar(120)
  /// 居间/经纪执行人联系方式（系统按承办人档案自动带出，临时换人可改）
  providerContactName  String   @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String   @default("") @map("provider_contact_phone") @db.VarChar(32)
  status               String   @default("OPEN") @db.VarChar(16)
  aiworkinPublished    Int      @default(0) @map("aiworkin_published")
  platformListingId    String   @default("") @map("platform_listing_id") @db.VarChar(64)
  platformMatchRunId   String   @default("") @map("platform_match_run_id") @db.VarChar(64)
  aiworkinSyncStatus   String   @default("PENDING") @map("aiworkin_sync_status") @db.VarChar(16)
  aiworkinSyncError    String   @default("") @map("aiworkin_sync_error") @db.VarChar(500)
  events               Json     @default("[]")
  messages             Json     @default("[]")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([createdBy])
  @@index([providerUserId, status])
  @@index([province, city])
  @@index([enterpriseId, id], map: "asset_requests_enterprise_id_id_idx")
  @@index([staffUserId, id], map: "asset_requests_staff_user_id_id_idx")
  @@map("asset_requests")
}

/// 服务商发布的服务（AIworkin direction=SUPPLY）：六个业务域共用一张表。
model ProviderServiceListing {
  id                 Int      @id @default(autoincrement())
  serviceNo          String   @unique @map("service_no") @db.VarChar(32)
  /// 业务域：LOGISTICS / IP / LEGAL / FLEX / MARKETING / ASSET
  domain             String   @db.VarChar(16)
  createdBy          String   @map("created_by") @db.VarChar(64)
  providerUserId     String   @map("provider_user_id") @db.VarChar(64)
  staffUserId        String   @default("") @map("staff_user_id") @db.VarChar(64)
  /// 二级类目（AIworkin 子类目 UUID，发布服务必填）
  subCategoryId      String   @map("sub_category_id") @db.VarChar(64)
  title              String   @db.VarChar(200)
  description        String   @db.Text
  tags               String   @default("") @db.VarChar(300)
  /// 计价方式：FIXED / STARTING / RANGE / NEGOTIABLE（AIworkin moneyMode）
  moneyMode          String   @default("NEGOTIABLE") @map("money_mode") @db.VarChar(16)
  currency           String   @default("AWCOIN") @db.VarChar(16)
  amountMin          Int      @default(0) @map("amount_min")
  amountMax          Int      @default(0) @map("amount_max")
  unitLabel          String   @default("") @map("unit_label") @db.VarChar(32)
  /// 报价说明（平台发布服务必填）
  priceDescription   String   @default("") @map("price_description") @db.VarChar(300)
  /// 服务范围三态：NATIONWIDE 不限制 / REGION 指定地区（省、市）/ RADIUS 经纬度坐标（AIworkin serviceArea.mode）
  serviceAreaMode    String   @default("NATIONWIDE") @map("service_area_mode") @db.VarChar(16)
  province           String   @default("") @db.VarChar(48)
  city               String   @default("") @db.VarChar(48)
  /// RADIUS 模式的坐标与半径（公里）；REGION 与不限制时为空
  longitude          Float?
  latitude           Float?
  radiusKm           Float?   @map("radius_km")
  /// 交付方式：REMOTE / ONSITE / HYBRID（AIworkin deliveryMode）
  deliveryMode       String   @default("") @map("delivery_mode") @db.VarChar(16)
  responseTime       String   @default("") @map("response_time") @db.VarChar(64)
  qualifications     String   @default("") @db.VarChar(300)
  /// 服务亮点（一行一条）
  highlights         String   @db.Text
  cases              String   @db.Text
  referenceLinks     String   @map("reference_links") @db.Text
  contactName        String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone       String   @default("") @map("contact_phone") @db.VarChar(32)
  contactWechat      String   @default("") @map("contact_wechat") @db.VarChar(64)
  contactEmail       String   @default("") @map("contact_email") @db.VarChar(120)
  /// 该二级类目平台要求的资质类型（展示用，逗号分隔）
  credentialTypes    String   @default("") @map("credential_types") @db.VarChar(300)
  /// 平台状态：DRAFT（草稿）/ ONLINE（已发布）
  status             String   @default("DRAFT") @db.VarChar(16)
  aiworkinPublished  Int      @default(0) @map("aiworkin_published")
  platformListingId  String   @default("") @map("platform_listing_id") @db.VarChar(64)
  platformMatchRunId String   @default("") @map("platform_match_run_id") @db.VarChar(64)
  aiworkinSyncStatus String   @default("PENDING") @map("aiworkin_sync_status") @db.VarChar(16)
  aiworkinSyncError  String   @default("") @map("aiworkin_sync_error") @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([providerUserId, domain])
  @@index([domain, status])
  @@index([province, city])
  @@map("provider_service_listings")
}

/// 平台直连板块（财税 / 供销 / 出海 / 供需市场）的本地发布台账。
/// 平台把写出收口到 MCP（REST 写一律 401），且没有「按属主读回挂单」的接口
/// （`/market/listings/mine` 对 API Key 一律 401），因此「我发布的」以本表为准：
/// 提交时经 MCP 发布拿到平台挂单号（listingId）后落一行，列表按 listingId 逐个读回平台挂单，
/// 平台读不回（草稿 / 已下架）时回落到 snapshot 快照。
model MarketListingRecord {
  id            Int      @id @default(autoincrement())
  /// 发布人（本系统账号 id，String 形态）
  userId        String   @map("user_id") @db.VarChar(64)
  /// 发布板块：TAX / SUPPLY / OVERSEAS / HUB
  domain        String   @db.VarChar(16)
  /// DEMAND 需求 / SUPPLY 服务
  direction     String   @db.VarChar(16)
  /// AIworkin 平台挂单 UUID（内容 ID）
  listingId     String   @map("listing_id") @db.VarChar(64)
  matchRunId    String   @default("") @map("match_run_id") @db.VarChar(64)
  /// 平台状态：DRAFT（草稿）/ ONLINE（已发布并进入匹配）
  status        String   @default("ONLINE") @db.VarChar(16)
  title         String   @default("") @db.VarChar(200)
  subCategoryId String   @default("") @map("sub_category_id") @db.VarChar(64)
  /// 提交报文快照（平台读不回时回显；含提交时的联系方式明文）
  snapshot      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, listingId])
  @@index([userId, domain, direction])
  @@map("market_listing_records")
}

model TaxDeclaration {
  id                   Int      @id @default(autoincrement())
  declNo               String   @unique @map("decl_no") @db.VarChar(32)
  contractId           Int      @map("contract_id")
  enterpriseId         Int      @map("enterprise_id")
  providerUserId       String   @map("provider_user_id") @db.VarChar(64)
  staffUserId          String   @default("") @map("staff_user_id") @db.VarChar(64)
  /// 报税联系方式：企业侧 + 承办职员（系统自动带出，临时换人可改）
  contactName          String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String   @default("") @map("contact_phone") @db.VarChar(32)
  providerContactName  String   @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String   @default("") @map("provider_contact_phone") @db.VarChar(32)
  materialId           Int      @default(0) @map("material_id")
  taxType              String   @map("tax_type") @db.VarChar(32)
  period               String   @default("") @db.VarChar(16)
  title                String   @default("") @db.VarChar(200)
  formData             Json     @default("{}") @map("form_data")
  taxAmount            Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  status               String   @default("DRAFT") @db.VarChar(16)
  aiSteps              Json     @default("[]") @map("ai_steps")
  advisorConfirms      Json     @default("[]") @map("advisor_confirms")
  qcStatus             String   @default("PENDING") @map("qc_status") @db.VarChar(16)
  qcNote               String   @default("") @map("qc_note") @db.VarChar(500)
  receiptNo            String   @default("") @map("receipt_no") @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // 申报单列表按可见性过滤；材料包提报后按 material_id 批量取申报单
  @@index([enterpriseId])
  @@index([staffUserId])
  @@index([providerUserId, status])
  @@index([materialId])
  @@map("tax_declarations")
}

model TaxMaterialPack {
  id                   Int       @id @default(autoincrement())
  packNo               String    @unique @map("pack_no") @db.VarChar(32)
  contractId           Int       @map("contract_id")
  enterpriseId         Int       @map("enterprise_id")
  providerUserId       String    @map("provider_user_id") @db.VarChar(64)
  staffUserId          String    @default("") @map("staff_user_id") @db.VarChar(64)
  /// 报税材料联系方式：企业报税经办人 + 承办职员（系统自动带出，临时换人可改）
  contactName          String    @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String    @default("") @map("contact_phone") @db.VarChar(32)
  providerContactName  String    @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String    @default("") @map("provider_contact_phone") @db.VarChar(32)
  title                String    @default("") @db.VarChar(200)
  // 材料所属期（YYYY-MM）
  period               String    @default("") @db.VarChar(16)
  // 三步材料明细：{ payroll: [], invoices: [], bank: [] }，逐条添加
  payload              Json
  files                Json
  status               String    @default("DRAFT") @db.VarChar(16)
  // 提交时刻与 AI 分析完成时刻（详情页「提交时间 / 分析时间」，提交后固化）
  submittedAt          DateTime? @map("submitted_at")
  analyzedAt           DateTime? @map("analyzed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([enterpriseId, period])
  @@map("tax_material_packs")
}

model TaxPlan {
  id             Int      @id @default(autoincrement())
  enterpriseId   Int      @map("enterprise_id")
  providerUserId String   @map("provider_user_id") @db.VarChar(64)
  staffUserId    String   @default("") @map("staff_user_id") @db.VarChar(64)
  accountSetId   Int      @default(0) @map("account_set_id")
  taxType        String   @map("tax_type") @db.VarChar(32)
  period         String   @db.VarChar(16)
  status         String   @default("DUE") @db.VarChar(16)
  declarationId  Int      @default(0) @map("declaration_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([enterpriseId, taxType, period])
  @@index([providerUserId, period, id], map: "tax_plans_provider_user_id_period_id_idx")
  @@index([staffUserId, period, id], map: "tax_plans_staff_user_id_period_id_idx")
  @@index([accountSetId, period, id], map: "tax_plans_account_set_id_period_id_idx")
  @@map("tax_plans")
}

model TaxRecord {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  kind      String   @db.VarChar(32)
  title     String   @db.VarChar(200)
  snapshot  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tax_records")
}

model AccountSet {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(120)
  enterpriseId   Int      @map("enterprise_id")
  providerUserId String   @map("provider_user_id") @db.VarChar(64)
  staffUserId    String   @default("") @map("staff_user_id") @db.VarChar(64)
  status         String   @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("account_sets")
}

model Consultation {
  id             Int      @id @default(autoincrement())
  contractId     Int      @map("contract_id")
  enterpriseId   Int      @map("enterprise_id")
  providerUserId String   @map("provider_user_id") @db.VarChar(64)
  staffUserId    String   @default("") @map("staff_user_id") @db.VarChar(64)
  question       String   @db.Text
  answer         String   @db.Text
  status         String   @default("OPEN") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("consultations")
}

/// 企业能力开通（服务商按服务企业配置 → 平台管理员审核通过后企业/财务人员才有对应功能）
/// code: E_TAX_FILING（电子报税·自动申报）| E_INVOICING（电子开票·自动开票）
/// status: REQUESTED（服务商已配置·待平台审核）| OPEN（已开通）| CLOSED（已关闭）
model EnterpriseCapability {
  id           Int      @id @default(autoincrement())
  enterpriseId Int      @map("enterprise_id")
  code         String   @db.VarChar(32)
  status       String   @default("REQUESTED") @db.VarChar(16)
  note         String   @default("") @db.VarChar(300)
  requestedBy  String   @default("") @map("requested_by") @db.VarChar(64)
  openedBy     String   @default("") @map("opened_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([enterpriseId, code])
  @@map("enterprise_capabilities")
}

/// 本系统自建的用户目录快照：账号服务（Java）没有目录接口，
/// 由每次带 token 的请求即时登记（JIT），并用 /user/info 补全昵称/邮箱/头像。
model UserDirectory {
  userId      String    @id @map("user_id") @db.VarChar(64)
  username    String    @default("") @db.VarChar(120)
  displayName String    @default("") @map("display_name") @db.VarChar(120)
  email       String    @default("") @db.VarChar(160)
  avatarUrl   String    @default("") @map("avatar_url") @db.VarChar(300)
  role        String    @default("") @db.VarChar(32)
  enabled     Int       @default(1)
  syncedAt    DateTime? @map("synced_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("user_directory")
}

/// 外报通道注册与开关：MANUAL（人工，默认启用）/ TAX_SP（持牌税务服务商）/ TAX_DIRECT（税企直连）/ CUSTOMS_SP（报关服务商）
model ExternalChannel {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(120)
  /// TAX | CUSTOMS
  bizType   String   @map("biz_type") @db.VarChar(16)
  enabled   Int      @default(1)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("external_channels")
}

/// 企业维度外报凭据（CA / 电子税务局子账号 / 电子口岸 IC 卡）：仅存密文，禁止明文落库与落日志
model ExternalCredential {
  id           Int       @id @default(autoincrement())
  enterpriseId Int       @map("enterprise_id")
  channelCode  String    @map("channel_code") @db.VarChar(32)
  /// CA | SERVICE_ACCOUNT | IC_CARD
  credType     String    @map("cred_type") @db.VarChar(24)
  label        String    @default("") @db.VarChar(120)
  /// AES-256-GCM 密文（iv:tag:payload，base64）
  secretCipher String    @map("secret_cipher") @db.Text
  extra        Json      @default("{}")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([enterpriseId, channelCode, credType, label])
  @@map("external_credentials")
}

/// 外报任务：幂等键 refType + refId + period 唯一
model ExternalSubmission {
  id             Int       @id @default(autoincrement())
  /// TAX | CUSTOMS
  bizType        String    @map("biz_type") @db.VarChar(16)
  /// TAX_DECLARATION | EXPORT_REFUND | CUSTOMS_DECL
  refType        String    @map("ref_type") @db.VarChar(32)
  refId          Int       @map("ref_id")
  refNo          String    @default("") @map("ref_no") @db.VarChar(32)
  enterpriseId   Int       @map("enterprise_id")
  providerUserId String    @default("") @map("provider_user_id") @db.VarChar(64)
  staffUserId    String    @default("") @map("staff_user_id") @db.VarChar(64)
  channelCode    String    @default("MANUAL") @map("channel_code") @db.VarChar(32)
  period         String    @default("") @db.VarChar(16)
  taxType        String    @default("") @map("tax_type") @db.VarChar(32)
  /// 外报目标系统（如「全国统一规范电子税务局」「自然人电子税务局（扣缴端）」）
  targetSystem   String    @default("") @map("target_system") @db.VarChar(120)
  payload        Json      @default("{}")
  payloadHash    String    @default("") @map("payload_hash") @db.VarChar(64)
  /// QUEUED | SUBMITTING | ACCEPTED | RECEIPT | PAID | REJECTED | CANCELLED
  status         String    @default("QUEUED") @db.VarChar(16)
  acceptNo       String    @default("") @map("accept_no") @db.VarChar(64)
  receiptNo      String    @default("") @map("receipt_no") @db.VarChar(64)
  errorCode      String    @default("") @map("error_code") @db.VarChar(32)
  errorMsg       String    @default("") @map("error_msg") @db.VarChar(500)
  attempts       Int       @default(0)
  /// 人工通道作业指引：{ system, entry, credential, steps[], fields[], notice }
  guide          Json      @default("{}")
  timeline       Json      @default("[]")
  submittedBy    String    @default("") @map("submitted_by") @db.VarChar(64)
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([refType, refId, period])
  @@index([enterpriseId, status])
  @@index([staffUserId, status])
  @@map("external_submissions")
}

/// 回执/回调原文留痕，不可篡改
model ExternalCallback {
  id             Int      @id @default(autoincrement())
  submissionId   Int      @map("submission_id")
  source         String   @default("MANUAL") @db.VarChar(32)
  rawBody        String   @db.Text
  signatureValid Int      @default(0) @map("signature_valid")
  receivedAt     DateTime @default(now()) @map("received_at")

  @@index([submissionId])
  @@map("external_callbacks")
}

/// 开发票申请（需求 6.4）：企业申请开票 → 财税承办人/财务专员审核 → 走企享云自动开票。
model InvoiceRequest {
  id                   Int       @id @default(autoincrement())
  reqNo                String    @unique @map("req_no") @db.VarChar(32)
  enterpriseId         Int       @map("enterprise_id")
  enterpriseName       String    @default("") @map("enterprise_name") @db.VarChar(200)
  requestedBy          String    @map("requested_by") @db.VarChar(64)
  providerUserId       String    @default("") @map("provider_user_id") @db.VarChar(64)
  staffUserId          String    @default("") @map("staff_user_id") @db.VarChar(64)
  /// 开票联系方式：企业申请人 + 财税承办人（系统自动带出，临时换人可改）
  contactName          String    @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String    @default("") @map("contact_phone") @db.VarChar(32)
  providerContactName  String    @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String    @default("") @map("provider_contact_phone") @db.VarChar(32)
  /// 发票类型代码（01/03/04）
  invoiceType          String    @default("04") @map("invoice_type") @db.VarChar(8)
  /// 购买方类型（1 企业 / 2 个人）
  buyerType            String    @default("1") @map("buyer_type") @db.VarChar(8)
  buyerName            String    @default("") @map("buyer_name") @db.VarChar(200)
  buyerTaxNo           String    @default("") @map("buyer_tax_no") @db.VarChar(64)
  orderNo              String    @default("") @map("order_no") @db.VarChar(64)
  remark               String    @default("") @map("remark") @db.VarChar(500)
  items                Json      @default("[]")
  amount               Decimal   @default(0) @map("amount") @db.Decimal(18, 2)
  tax                  Decimal   @default(0) @map("tax") @db.Decimal(18, 2)
  /// REQUESTED | ISSUING | SUBMITTED | ISSUE_UNKNOWN | ISSUED | REJECTED | CANCELLED
  status               String    @default("REQUESTED") @db.VarChar(16)
  reviewedBy           String    @default("") @map("reviewed_by") @db.VarChar(64)
  reviewedAt           DateTime? @map("reviewed_at")
  rejectReason         String    @default("") @map("reject_reason") @db.VarChar(500)
  issueCode            String    @default("") @map("issue_code") @db.VarChar(64)
  issueMessage         String    @default("") @map("issue_message") @db.VarChar(500)
  issueTaskId          String    @default("") @map("issue_task_id")
  issuedAt             DateTime? @map("issued_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([enterpriseId, status])
  @@index([staffUserId, status])
  @@map("invoice_requests")
}

/// 供销网络 · 服务站（B2B 供需网络最小经营单元，固定地理位置）
model SupplyStation {
  id             Int      @id @default(autoincrement())
  providerUserId String   @map("provider_user_id") @db.VarChar(64)
  name           String   @db.VarChar(120)
  /// 所在地区（省/市/区）
  region         String   @default("") @db.VarChar(64)
  /// 服务站详细地址（固定地理位置）
  address        String   @default("") @db.VarChar(300)
  contactName    String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone   String   @default("") @map("contact_phone") @db.VarChar(32)
  /// ACTIVE 启用 | FROZEN 停用
  status         String   @default("ACTIVE") @db.VarChar(16)
  remark         String   @default("") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([providerUserId, status])
  @@map("supply_stations")
}

/// 供销网络 · 商品 SPU（本地交易数据，营销展示字段单独留痕）
model SupplyProduct {
  id                 Int      @id @default(autoincrement())
  providerUserId     String   @map("provider_user_id") @db.VarChar(64)
  name               String   @db.VarChar(200)
  /// 所属品类
  category           String   @default("") @db.VarChar(64)
  /// 供货基准价格（未选规格时的参考价）
  basePrice          Decimal  @default(0) @map("base_price") @db.Decimal(14, 2)
  unit               String   @default("件") @db.VarChar(16)
  /// 基础属性 [{ name, value }]
  attrs              Json     @default("[]")
  /// 商品整体状态：ONLINE 在售 | OFFLINE 已下架
  status             String   @default("ONLINE") @db.VarChar(16)
  /// AIworkin GEO 独立站：营销标题
  marketingTitle     String   @default("") @map("marketing_title") @db.VarChar(200)
  /// AIworkin GEO 独立站：产品摘要
  marketingSummary   String   @default("") @map("marketing_summary") @db.VarChar(500)
  /// AIworkin GEO 独立站：详细正文
  marketingContent   String   @map("marketing_content") @db.Text
  /// AIworkin GEO 独立站：封面展示图
  coverUrl           String   @default("") @map("cover_url") @db.VarChar(500)
  /// AIworkin GEO 独立站：首页推荐标签
  featured           Boolean  @default(false)
  aiworkinListingId  String   @default("") @map("aiworkin_listing_id") @db.VarChar(64)
  /// PENDING 待同步 | SYNCED 已同步 | SKIPPED 未启用通道 | FAILED 同步失败
  aiworkinSyncStatus String   @default("SKIPPED") @map("aiworkin_sync_status") @db.VarChar(16)
  aiworkinSyncNote   String   @default("") @map("aiworkin_sync_note") @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([providerUserId, status])
  @@map("supply_products")
}

/// 供销网络 · 商品与服务站归属（一个商品可归属多个站点，站点维度独立上下架）
model SupplyProductStation {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  stationId Int      @map("station_id")
  /// ONLINE 已上架 | OFFLINE 已下架
  status    String   @default("ONLINE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, stationId])
  @@index([stationId, status])
  @@map("supply_product_stations")
}

/// 供销网络 · 商品 SKU 规格（独立供货价 / 单位 / 适配场景）
model SupplySku {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  specName    String   @map("spec_name") @db.VarChar(120)
  supplyPrice Decimal  @default(0) @map("supply_price") @db.Decimal(14, 2)
