// ---------------------------------------------------------------------------
// 问题大厅（工作台）：企业内问题按组织+签约链路可见，公开问题对所有登录账号可见；
// 结案＝AI 对全部楼层出总结（可反复），关闭＝下架，删除＝发布者与管理员（软删）
// ---------------------------------------------------------------------------

/// 问题：scope 决定可见范围，status 与 deletedAt 分离（结案 / 关闭 / 删除是三个动作）
model QuestionHallQuestion {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(200)
  body            String    @db.Text
  /// ENTERPRISE（企业内） | PUBLIC（公开）
  scope           String    @db.VarChar(16)
  /// OPEN（进行中） | RESOLVED（已结案） | CLOSED（已关闭）
  status          String    @default("OPEN") @db.VarChar(16)
  /// 发布时所属组织：ENTERPRISE | PROVIDER；orgUserId 为该组织账号（无组织时＝自己）
  orgKind         String    @default("ENTERPRISE") @map("org_kind") @db.VarChar(16)
  orgUserId       String    @default("") @map("org_user_id") @db.VarChar(64)
  authorUserId    String    @map("author_user_id") @db.VarChar(64)
  /// 发布人昵称快照（公开问题不展示组织名，也不展示身份类型）
  authorName      String    @map("author_name") @db.VarChar(60)
  replyCount      Int       @default(0) @map("reply_count")
  lastReplyAt     DateTime  @default(now()) @map("last_reply_at")
  resolvedAt      DateTime? @map("resolved_at")
  /// 最新一次结案的总结 id（0＝还没结案 / 总结没生成成功）
  latestSummaryId Int       @default(0) @map("latest_summary_id")
  closedAt        DateTime? @map("closed_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([scope, status, lastReplyAt])
  @@index([orgKind, orgUserId, status])
  @@index([authorUserId, status])
  @@map("question_hall_questions")
}

/// 楼层：parentId＝0 为顶层回复，>0 为「回复的回复」（只做两层）
model QuestionHallMessage {
  id           Int       @id @default(autoincrement())
  questionId   Int       @map("question_id")
  parentId     Int       @default(0) @map("parent_id")
  body         String    @db.Text
  /// PERSON（真实个人） | AVATAR（数字分身，仅署名与口吻，内容由本人写）
  authorKind   String    @default("PERSON") @map("author_kind") @db.VarChar(8)
  personaId    Int       @default(0) @map("persona_id")
  /// 昵称；用分身时形如「昵称 · 分身名」。改名/删分身不影响历史楼层
  authorLabel  String    @map("author_label") @db.VarChar(80)
  authorUserId String    @map("author_user_id") @db.VarChar(64)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([questionId, parentId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("question_hall_messages")
}

/// 结案记录：每次结案/重新结案新增一行，不覆盖历史
model QuestionHallSummary {
  id           Int      @id @default(autoincrement())
  questionId   Int      @map("question_id")
  /// 第几次结案（1 起）
  seq          Int
  content      String   @db.Text
  /// 参与统计的楼层数；truncated＝只读了最近若干条
  messageCount Int      @map("message_count")
  truncated    Boolean  @default(false)
  /// 生成时用的模型标签；空＝未取到
  model        String   @default("") @db.VarChar(128)
  createdBy    String   @map("created_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([questionId, seq])
  @@map("question_hall_summaries")
}

// ---------------------------------------------------------------------------
// IM 连接（飞书 / 企业微信）：组织级连接器，一套凭据服务本组织；
// 通讯录以本系统为准（推为主、拉只用于建立绑定），通知单向推送，OA/OKR 做镜像。
// ---------------------------------------------------------------------------

model ImConnector {
  id                Int       @id @default(autoincrement())
  /// ENTERPRISE | PROVIDER
  orgType           String    @map("org_type") @db.VarChar(16)
  orgUserId         String    @map("org_user_id") @db.VarChar(64)
  /// FEISHU | WECOM
  provider          String    @db.VarChar(16)
  name              String    @db.VarChar(80)
  /// 飞书 tenant_key / 企微 corpid
  corpId            String    @default("") @map("corp_id") @db.VarChar(120)
  appId             String    @default("") @map("app_id") @db.VarChar(120)
  appSecretEnc      String    @default("") @map("app_secret_enc") @db.Text
  /// 企微自建应用 AgentId
  agentId           String    @default("") @map("agent_id") @db.VarChar(64)
  /// 企微「通讯录同步」Secret（独立一份）
  contactSecretEnc  String    @default("") @map("contact_secret_enc") @db.Text
  verificationToken String    @default("") @map("verification_token") @db.VarChar(120)
  encryptKeyEnc     String    @default("") @map("encrypt_key_enc") @db.Text
  /// 回调路径里的随机串（32 hex），一条连接器一个
  webhookToken      String    @unique @map("webhook_token") @db.VarChar(32)
  status            String    @default("active") @db.VarChar(16)
  scopes            Json      @default("[]")
  lastVerifiedAt    DateTime? @map("last_verified_at")
  createdBy         String    @default("") @map("created_by") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, provider, corpId])
  @@index([orgType, orgUserId])
  @@map("im_connectors")
}

model ImMemberLink {
  id                   Int       @id @default(autoincrement())
  connectorId          Int       @map("connector_id")
  /// 已绑定时有值；未绑定（从 IM 拉到的陌生成员）为空串
  memberUserId         String    @default("") @map("member_user_id") @db.VarChar(64)
  externalUserId       String    @map("external_user_id") @db.VarChar(120)
  unionId              String    @default("") @map("union_id") @db.VarChar(120)
  nameSnapshot         String    @default("") @map("name_snapshot") @db.VarChar(120)
  mobileSnapshot       String    @default("") @map("mobile_snapshot") @db.VarChar(40)
  departmentExternalId String    @default("") @map("department_external_id") @db.VarChar(120)
  /// MANUAL | IM_PULL | LOCAL_PUSH
  source               String    @default("MANUAL") @db.VarChar(16)
  /// LINKED | PENDING | DISABLED
  status               String    @default("PENDING") @db.VarChar(16)
  lastSyncedAt         DateTime? @map("last_synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([connectorId, externalUserId])
  @@index([connectorId, memberUserId])
  @@map("im_member_links")
}

model ImDeptLink {
  id               Int      @id @default(autoincrement())
  connectorId      Int      @map("connector_id")
  department       String   @db.VarChar(64)
  externalDeptId   String   @map("external_dept_id") @db.VarChar(120)
  name             String   @default("") @db.VarChar(120)
  parentExternalId String   @default("") @map("parent_external_id") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([connectorId, department])
  @@map("im_dept_links")
}

model ImObjectBinding {
  id          Int       @id @default(autoincrement())
  connectorId Int       @map("connector_id")
  /// APPROVAL | TASK | BASE | LOWCODE | DRIVE | BI
  module      String    @db.VarChar(16)
  objectKey   String    @map("object_key") @db.VarChar(120)
  /// PUSH | PULL | BOTH
  direction   String    @default("PUSH") @db.VarChar(8)
  config      Json      @default("{}")
  fieldMap    Json      @default("{}") @map("field_map")
  enabled     Boolean   @default(true)
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([connectorId, module, objectKey])
  @@map("im_object_bindings")
}

model ImObjectLink {
  id            Int       @id @default(autoincrement())
  bindingId     Int       @map("binding_id")
  module        String    @db.VarChar(16)
  localId       String    @map("local_id") @db.VarChar(120)
  externalId    String    @map("external_id") @db.VarChar(120)
  localHash     String    @default("") @map("local_hash") @db.VarChar(64)
  externalHash  String    @default("") @map("external_hash") @db.VarChar(64)
  lastDirection String    @default("") @map("last_direction") @db.VarChar(8)
  status        String    @default("LINKED") @db.VarChar(16)
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([bindingId, localId])
  @@index([bindingId, externalId])
  @@map("im_object_links")
}

model ImEvent {
  id          Int       @id @default(autoincrement())
  connectorId Int       @map("connector_id")
  /// IN | OUT
  direction   String    @db.VarChar(8)
  /// EVENT | SYNC | NOTIFY
  kind        String    @db.VarChar(8)
  eventId     String    @map("event_id") @db.VarChar(160)
  objectType  String    @default("") @map("object_type") @db.VarChar(40)
  objectId    String    @default("") @map("object_id") @db.VarChar(120)
  payload     Json      @default("{}")
  /// RECEIVED | DONE | FAILED | SKIPPED
  status      String    @default("RECEIVED") @db.VarChar(16)
  attempts    Int       @default(0)
  error       String    @default("") @db.VarChar(500)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([connectorId, eventId])
  @@index([connectorId, status])
  @@map("im_events")
}

model ImNotifyRule {
  id          Int      @id @default(autoincrement())
  connectorId Int      @unique @map("connector_id")
  /// [{ event: string, target: "OFF"|"USER"|"CHAT", chatId: string }]
  rules       Json     @default("[]")
  quietHours  Json     @default("{}") @map("quiet_hours")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("im_notify_rules")
}

// ==================== SNS 社交板块（原 sns 仓模型，表名 sns_ 前缀；ApiKey 已并入上方 api_keys）====================

/// SNS 资料扩展：头像/昵称/简介等基础身份在本地 users 表
model SnsProfile {
  id         Int      @id @default(autoincrement())
  userId     String   @unique @map("user_id") @db.VarChar(64)
  title      String   @default("") @db.VarChar(120)
  city       String   @default("") @db.VarChar(64)
  gender     String   @default("UNSPECIFIED") @db.VarChar(16)
  bio        String   @default("") @db.Text
  lang       String   @default("zh") @db.VarChar(8)
  visibility Json     @default("{}")
  /// 自填联系方式：{ phone, email, wechat, douyin, xiaohongshu, blog, x, tiktok, facebook }
  contacts   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("sns_profiles")
}

model FriendRequest {
  id                Int       @id @default(autoincrement())
  fromUserId        String    @map("from_user_id") @db.VarChar(64)
  toUserId          String    @map("to_user_id") @db.VarChar(64)
  message           String    @default("") @db.VarChar(500)
  status            String    @default("PENDING") @db.VarChar(16)
  /// LOCAL | AIWORKIN
  source            String    @default("LOCAL") @db.VarChar(16)
  /// 上游申请 ID；只有 AIWORKIN 来源或已成功出站同步时才有值
  upstreamRequestId String    @default("") @map("upstream_request_id") @db.VarChar(64)
  /// NONE | PENDING | SYNCED | FAILED | SKIPPED
  syncState         String    @default("NONE") @map("sync_state") @db.VarChar(16)
  createdAt         DateTime  @default(now()) @map("created_at")
  handledAt         DateTime? @map("handled_at")

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("sns_friend_requests")
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userAId   String   @map("user_a_id") @db.VarChar(64)
  userBId   String   @map("user_b_id") @db.VarChar(64)
  /// LOCAL | AIWORKIN | BOTH
  source    String   @default("LOCAL") @db.VarChar(16)
  /// NONE | PENDING | SYNCED | FAILED | SKIPPED
  syncState String   @default("NONE") @map("sync_state") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("sns_friendships")
}

model Follow {
  id         Int      @id @default(autoincrement())
  followerId String   @map("follower_id") @db.VarChar(64)
  followeeId String   @map("followee_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("sns_follows")
}

model Block {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id") @db.VarChar(64)
  blockedUserId String   @map("blocked_user_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, blockedUserId])
  @@index([blockedUserId])
  @@map("sns_blocks")
}

model Mailbox {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  address   String   @unique @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sns_mailboxes")
}

/// 双人会话；同一对用户的多封邮件在此聚合
model MailThread {
  id            Int      @id @default(autoincrement())
  userAId       String   @map("user_a_id") @db.VarChar(64)
  userBId       String   @map("user_b_id") @db.VarChar(64)
  subject       String   @default("") @db.VarChar(200)
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  messages SnsMessage[]

  @@unique([userAId, userBId])
  @@index([userBId, lastMessageAt])
  @@index([userAId, lastMessageAt])
  @@map("sns_mail_threads")
}

model SnsMessage {
  id                Int      @id @default(autoincrement())
  threadId          Int      @map("thread_id")
  fromUserId        String   @map("from_user_id") @db.VarChar(64)
  toUserId          String   @map("to_user_id") @db.VarChar(64)
  subject           String   @default("") @db.VarChar(200)
  body              String   @db.Text
  linkCards         Json     @default("[]") @map("link_cards")
  aiGenerated       Boolean  @default(false) @map("ai_generated")
  inReplyToId       Int?     @map("in_reply_to_id")
  readUserIds       Json     @default("[]") @map("read_user_ids")
  /// LOCAL | AIWORKIN
  source            String   @default("LOCAL") @db.VarChar(16)
  upstreamMessageId String   @default("") @map("upstream_message_id") @db.VarChar(120)
  /// NONE | PENDING | SYNCED | FAILED | SKIPPED
  syncState         String   @default("NONE") @map("sync_state") @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at")

  thread MailThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@index([toUserId, createdAt])
  @@map("sns_messages")
}

/// 本地用户 ↔ AIworkin SNS 身份映射；只信 UUID，不按昵称/手机号自动匹配。
model SocialUpstreamIdentity {
  id               Int       @id @default(autoincrement())
  userId           String    @unique @map("user_id") @db.VarChar(64)
  keyId            Int       @map("key_id")
  upstreamUserId   String    @default("") @map("upstream_user_id") @db.VarChar(64)
  upstreamUsername String    @default("") @map("upstream_username") @db.VarChar(120)
  /// UNBOUND | KEY_INACTIVE | PLACEHOLDER_ID | SNS_GRANT_MISSING | READY | REVOKED
  state            String    @default("UNBOUND") @db.VarChar(24)
  profileSnapshot  Json      @default("{}") @map("profile_snapshot")
  verifiedAt       DateTime? @map("verified_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  lastError        String    @default("") @map("last_error") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([upstreamUserId])
  @@map("social_upstream_identities")
}

/// 每个用户的跨站同步偏好；关闭后立即停止新的 outbox 入队。
model SocialSyncPreference {
  id                     Int      @id @default(autoincrement())
  userId                 String   @unique @map("user_id") @db.VarChar(64)
  discoverable           Boolean  @default(true)
  recommendEnabled       Boolean  @default(true) @map("recommend_enabled")
  businessReasonVisible  Boolean  @default(true) @map("business_reason_visible")
  friendRequestOutbound  Boolean  @default(true) @map("friend_request_outbound")
  friendRelationOutbound Boolean  @default(true) @map("friend_relation_outbound")
  friendRelationInbound  Boolean  @default(false) @map("friend_relation_inbound")
  mailOutboundDefault    Boolean  @default(false) @map("mail_outbound_default")
  mailInbound            Boolean  @default(false) @map("mail_inbound")
  /// AUTO | MCP | LEGACY
  channel                String   @default("AUTO") @db.VarChar(16)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("social_sync_preferences")
}

/// 事务性 outbox：所有跨站写先入队，再由调度器执行。
model SocialSyncJob {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  keyId          Int       @map("key_id")
  /// OUTBOUND | INBOUND
  direction      String    @default("OUTBOUND") @db.VarChar(16)
  /// FRIEND_REQUEST_SEND | FRIEND_REQUEST_HANDLE | MAIL_SEND | RELATION_PULL | MAIL_PULL | BACKFILL_FRIEND
  action         String    @db.VarChar(32)
  localType      String    @default("") @map("local_type") @db.VarChar(32)
  localId        String    @default("") @map("local_id") @db.VarChar(64)
  payload        Json      @default("{}")
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(100)
  /// PENDING | RUNNING | SUCCEEDED | FAILED | DEAD
  status         String    @default("PENDING") @db.VarChar(16)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  lockedAt       DateTime? @map("locked_at")
  lastError      String    @default("") @map("last_error") @db.VarChar(1000)
  remoteId       String    @default("") @map("remote_id") @db.VarChar(120)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([keyId, createdAt])
  @@map("social_sync_jobs")
}

/// 本地对象 ↔ 上游对象映射，兼做去重表。
model SocialSyncLink {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  /// FRIEND_REQUEST | FRIENDSHIP | MAIL_THREAD | MAIL_MESSAGE
  kind           String    @db.VarChar(24)
  localId        String    @map("local_id") @db.VarChar(64)
  remoteId       String    @default("") @map("remote_id") @db.VarChar(120)
  remoteParentId String    @default("") @map("remote_parent_id") @db.VarChar(120)
  /// OUTBOUND | INBOUND
  direction      String    @default("OUTBOUND") @db.VarChar(16)
  /// ACTIVE | CONFLICT | STALE
  state          String    @default("ACTIVE") @db.VarChar(16)
  contentHash    String    @default("") @map("content_hash") @db.VarChar(64)
  lastSyncedAt   DateTime? @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, kind, localId])
  @@index([userId, kind, remoteId])
  @@map("social_sync_links")
}

/// 推荐快照：懒计算 + TTL，避免每次请求都全量聚合。
model SocialAffinitySnapshot {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  targetUserId String   @map("target_user_id") @db.VarChar(64)
  score        Int      @default(0)
  reasons      Json     @default("[]")
  signals      Json     @default("{}")
  computedAt   DateTime @default(now()) @map("computed_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([userId, targetUserId])
  @@index([userId, score])
  @@map("social_affinity_snapshots")
}

/// 「不再推荐」等负反馈；到期后自动失效。
model SocialRecommendationFeedback {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  targetUserId String    @map("target_user_id") @db.VarChar(64)
  /// DISMISS | INVITED | ADDED
  action       String    @db.VarChar(16)
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([userId, targetUserId])
  @@map("social_recommendation_feedback")
}

/// 经历与学历：用户自填；org_key 为归一化机构名，同历匹配与同机构屏蔽按 (kind, org_key)
model Experience {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id") @db.VarChar(64)
  kind          String   @default("WORK") @db.VarChar(8)
  organization  String   @db.VarChar(120)
  title         String   @default("") @db.VarChar(120)
  startYear     Int?     @map("start_year")
  endYear       Int?     @map("end_year")
  description   String   @default("") @db.Text
  hideFromPeers Boolean  @default(false) @map("hide_from_peers")
  orgKey        String   @map("org_key") @db.VarChar(120)
  sort          Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, sort])
  @@index([kind, orgKey])
  @@map("sns_experiences")
}

/// 职场专业简历：与主页资料、经历完全分叉；同步只单向写入一次初始值
model Resume {
  id            Int      @id @default(autoincrement())
  userId        String   @unique @map("user_id") @db.VarChar(64)
  headline      String   @default("") @db.VarChar(120)
  location      String   @default("") @db.VarChar(64)
  summary       String   @default("") @db.Text
  objectiveRole String   @default("") @map("objective_role") @db.VarChar(120)
  objectiveCity String   @default("") @map("objective_city") @db.VarChar(64)
  objectiveType String   @default("") @map("objective_type") @db.VarChar(16)
  additional    String   @default("") @db.Text
  contacts      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("sns_resumes")
}

/// 简历条目：按 kind 分组（工作/教育/项目/技能/特长/语言/计算机/证书/荣誉/作品）
model ResumeItem {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  kind        String   @db.VarChar(16)
  title       String   @db.VarChar(120)
  subtitle    String   @default("") @db.VarChar(120)
  startYear   Int?     @map("start_year")
  endYear     Int?     @map("end_year")
  description String   @default("") @db.Text
  url         String   @default("") @db.VarChar(200)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, sort])
  @@map("sns_resume_items")
}

/// 动态：纯文字短内容，可见性 PUBLIC / FRIENDS
model Post {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  body       String   @db.Text
  visibility String   @default("PUBLIC") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([visibility, createdAt])
  @@index([createdAt])
  @@map("sns_posts")
}

/// 豆瓣式讨论组：公开/私密；加入机制建组时选定（自由加入/组长审批）
model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(30)
  avatar      String   @default("") @db.VarChar(500)
  description String   @default("") @db.Text
  rules       String   @default("") @db.Text
  category    String   @default("") @db.VarChar(30)
  visibility  String   @default("PUBLIC") @db.VarChar(16)
  joinPolicy  String   @default("FREE") @map("join_policy") @db.VarChar(16)
  ownerId     String   @map("owner_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, createdAt])
  @@index([visibility, createdAt])
  @@index([ownerId])
  @@map("sns_groups")
}

/// 组成员：role=OWNER 即组长，status=PENDING 为待审批入组申请
model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  userId    String   @map("user_id") @db.VarChar(64)
  role      String   @default("MEMBER") @db.VarChar(16)
  status    String   @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status])
  @@map("sns_group_members")
}

/// 小组主题帖；anonymous 逐条匿名：真实 userId 只留库内用于删除权限，读接口不回显
/// pinned 置顶 / featured 加精（组长与管理员操作）；tag 为发帖分类；likeCount 推荐数
model GroupTopic {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  userId      String   @map("user_id") @db.VarChar(64)
  title       String   @db.VarChar(120)
  body        String   @db.Text
  tag         String   @default("") @db.VarChar(30)
  anonymous   Boolean  @default(false)
  pinned      Boolean  @default(false)
  featured    Boolean  @default(false)
  likeCount   Int      @default(0) @map("like_count")
  replyCount  Int      @default(0) @map("reply_count")
  lastReplyAt DateTime @default(now()) @map("last_reply_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([groupId, lastReplyAt])
  @@index([groupId, pinned, featured])
  @@index([userId])
  @@map("sns_group_topics")
}

/// 楼层：floor 发帖时按当前回复数分配，删楼不重编号；likeCount 为豆瓣式「推荐」数
model GroupReply {
  id            Int      @id @default(autoincrement())
  topicId       Int      @map("topic_id")
  groupId       Int      @map("group_id")
  userId        String   @map("user_id") @db.VarChar(64)
  floor         Int      @default(0)
  body          String   @db.Text
  anonymous     Boolean  @default(false)
  likeCount     Int      @default(0) @map("like_count")
  replyToUserId String?  @map("reply_to_user_id") @db.VarChar(64)
  replyToFloor  Int?     @map("reply_to_floor")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([topicId, floor])
  @@index([userId])
  @@map("sns_group_replies")
}

/// 主题「推荐」去重表：一人一贴只算一次，取消即删行（豆瓣式）
model TopicLike {
  id        Int      @id @default(autoincrement())
  topicId   Int      @map("topic_id")
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([topicId, userId])
  @@index([userId])
  @@map("sns_topic_likes")
}

/// 回复「推荐」去重表
model ReplyLike {
  id        Int      @id @default(autoincrement())
  replyId   Int      @map("reply_id")
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([replyId, userId])
  @@index([userId])
  @@map("sns_reply_likes")
}

/// 招聘专区（商务人脉 → 招聘）：只做发布与对接，沟通走站内私信；
/// 本地免 Key 发布进招聘广场信息流，勾选则按「灵活用工」类目同步为 AIworkin 用工需求。
model HiringPost {
  id                Int      @id @default(autoincrement())
  userId            String   @map("user_id") @db.VarChar(64)
  type              String   @default("FULL_TIME") @db.VarChar(16)
  title             String   @db.VarChar(100)
  description       String   @db.Text
  headCount         Int      @default(1) @map("head_count")
  salaryMode        String?  @map("salary_mode") @db.VarChar(16)
  salaryMin         Int?     @map("salary_min")
  salaryMax         Int?     @map("salary_max")
  currency          String   @default("AWCOIN") @db.VarChar(16)
  tags              Json     @default("[]")
  province          String   @default("") @db.VarChar(50)
  city              String   @default("") @db.VarChar(50)
  contactNote       String   @default("") @map("contact_note") @db.VarChar(500)
  deadline          String   @default("") @db.VarChar(64)
  status            String   @default("LOCAL_PUBLISHED") @db.VarChar(24)
  subcategoryId     String   @default("") @map("subcategory_id") @db.VarChar(64)
  aiworkinDemandNo  String   @default("") @map("aiworkin_demand_no") @db.VarChar(64)
  aiworkinListingNo String   @default("") @map("aiworkin_listing_no") @db.VarChar(64)
  publishedUpstream Boolean  @default(false) @map("published_upstream")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("sns_hiring_posts")
}

model Report {
  id           Int       @id @default(autoincrement())
  reporterId   String    @map("reporter_id") @db.VarChar(64)
  targetType   String    @map("target_type") @db.VarChar(16)
  targetId     String    @map("target_id") @db.VarChar(64)
  targetUserId String    @map("target_user_id") @db.VarChar(64)
  reason       String    @default("") @db.VarChar(500)
  status       String    @default("PENDING") @db.VarChar(16)
  note         String    @default("") @db.VarChar(500)
  handledBy    String    @default("") @map("handled_by") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  handledAt    DateTime? @map("handled_at")

  @@index([status, createdAt])
  @@index([targetUserId])
  @@map("sns_reports")
}

/// 社交板块级封禁：与平台级封禁（users.status=BANNED）分层
model UserSuspension {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.VarChar(64)
  reason      String    @default("") @db.VarChar(500)
  suspendedBy String    @default("") @map("suspended_by") @db.VarChar(64)
  liftedAt    DateTime? @map("lifted_at")
  liftedBy    String    @default("") @map("lifted_by") @db.VarChar(64)
  liftNote    String    @default("") @map("lift_note") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, liftedAt])
  @@index([createdAt])
  @@map("sns_user_suspensions")
}

/// AI 代理（MCP/API）发送类动作授权白名单
model AiGrant {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.VarChar(64)
  name           String   @db.VarChar(100)
  allowedActions Json     @default("[]") @map("allowed_actions")
  status         String   @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("sns_ai_grants")
}

/// 供求广场帖（设计 §4.2）：社交板通用发布需求/服务，本地免 Key 发布，勾选则同步 AIworkin。
model Listing {
  id                Int      @id @default(autoincrement())
  authorUserId      String   @map("author_user_id") @db.VarChar(64)
  type              String   @db.VarChar(16)
  title             String   @db.VarChar(120)
  description       String   @db.Text
  tags              Json     @default("[]")
  moneyMode         String?  @map("money_mode") @db.VarChar(16)
  amountMin         Int?     @map("amount_min")
  amountMax         Int?     @map("amount_max")
  currency          String   @default("AWCOIN") @db.VarChar(16)
  province          String   @default("") @db.VarChar(50)
  city              String   @default("") @db.VarChar(50)
  contactNote       String   @default("") @map("contact_note") @db.VarChar(500)
  status            String   @default("LOCAL_PUBLISHED") @db.VarChar(24)
  aiworkinDemandNo  String   @default("") @map("aiworkin_demand_no") @db.VarChar(64)
  aiworkinListingNo String   @default("") @map("aiworkin_listing_no") @db.VarChar(64)
  publishedUpstream Boolean  @default(false) @map("published_upstream")
  subcategoryId     String   @default("") @map("subcategory_id") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([authorUserId, createdAt])
  @@index([type, status, createdAt])
  @@index([createdAt])
  @@map("sns_listings")
}

/// 开放能力调用审计（区分 rest / mcp 通道）
model ApiCallLog {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  apiKeyId   Int?     @map("api_key_id")
  channel    String   @default("rest") @db.VarChar(16)
  endpoint   String   @db.VarChar(200)
  method     String   @db.VarChar(10)
  statusCode Int      @map("status_code")
  ip         String   @default("") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("sns_api_call_logs")
}

/// 邀请归因：邀请码＝邀请人用户名，只记归因不涉币
model InviteAccept {
  id        Int      @id @default(autoincrement())
  inviterId String   @map("inviter_id") @db.VarChar(64)
  inviteeId String   @unique @map("invitee_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([inviterId, createdAt])
  @@map("sns_invite_accepts")
}

/// 批任务台账：(job, day) 唯一键防多实例/重启重跑；day 存本地日期字符串
model BatchRun {
  id         Int       @id @default(autoincrement())
  job        String    @db.VarChar(64)
  day        String    @db.VarChar(10)
  status     String    @default("RUNNING") @db.VarChar(16)
  trigger    String    @default("auto") @db.VarChar(16)
  attempts   Int       @default(1)
  units      Int       @default(0)
  affected   Int       @default(0)
  detail     String    @default("") @db.VarChar(500)
  lastError  String?   @map("last_error") @db.VarChar(500)
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@unique([job, day])
  @@index([day])
  @@map("sns_batch_runs")
}

/// 名录镜像（开源版改由本地 users 生成，鉴权仍走实时查询）
model UserMirror {
  id            Int       @id @default(autoincrement())
  userId        String    @unique @map("user_id") @db.VarChar(64)
  username      String    @default("") @db.VarChar(64)
  displayName   String    @default("") @map("display_name") @db.VarChar(120)
  email         String?   @db.VarChar(190)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  personalIntro String?   @map("personal_intro") @db.VarChar(500)
  enabled       Boolean   @default(true)
  sourceCreated DateTime? @map("source_created") @db.DateTime(3)
  syncedAt      DateTime  @default(now()) @map("synced_at")

  @@index([enabled, userId])
  @@map("sns_user_mirror")
}

/// 六度关系物化：查看者→目标的度数/引荐人/共同好友数/排序分
model UserAffinity {
  id          Int      @id @default(autoincrement())
  viewerId    String   @map("viewer_id") @db.VarChar(64)
  targetId    String   @map("target_id") @db.VarChar(64)
  degree      Int
  viaUserId   String?  @map("via_user_id") @db.VarChar(64)
  mutualCount Int      @default(0) @map("mutual_count")
  score       Int      @default(0)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@unique([viewerId, targetId])
  @@index([viewerId, score])
  @@map("sns_user_affinity")
}

/// 社交站内通知（与 Enterprise 既有 Notification 分层，M5 代码层评估合并）
model SnsNotification {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.VarChar(64)
  type      String    @db.VarChar(32)
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("sns_notifications")
}

// ---------- M2：本地账户体系（开源版独立用户库，脱离上游账号服务） ----------

/// 本地用户账户：id 的字符串形式即全系统 userId（与各业务表 user_id VarChar(64) 兼容）
model Account {
  id                 Int       @id @default(autoincrement())
  username           String    @unique @db.VarChar(64)
  email              String?   @unique @db.VarChar(160)
  phone              String?   @unique @db.VarChar(32)
  /// bcrypt 哈希；纯手机验证码注册时可为空
  passwordHash       String?   @map("password_hash") @db.VarChar(128)
  emailVerified      Int       @default(0) @map("email_verified") @db.TinyInt
  phoneVerified      Int       @default(0) @map("phone_verified") @db.TinyInt
  /// ACTIVE | BANNED | DELETED
  status             String    @default("ACTIVE") @db.VarChar(16)
  banReason          String?   @map("ban_reason") @db.VarChar(255)
  /// 管理员重置密码后首登强制改密
  mustChangePassword Int       @default(0) @map("must_change_password") @db.TinyInt
  /// 改密/重置后 +1，旧会话即时失效
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  /// 注销冷静期起点（status=DELETED 时生效）
  deletedAt          DateTime? @map("deleted_at")
  avatar             String?   @db.VarChar(512)
  intro              String?   @db.VarChar(500)
  lang               String    @default("zh") @db.VarChar(16)
  /// USER | PLATFORM_ADMIN
  role               String    @default("USER") @db.VarChar(24)
  /// 自己的邀请码（大写字母数字）：注册时他人填写即可建立邀请关系；存量账户首次访问邀请页时懒生成。
  inviteCode         String?   @unique @map("invite_code") @db.VarChar(16)
  /// 被谁邀请注册（邀请人的 Account.id；空＝非邀请注册）
  invitedBy          Int?      @map("invited_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

/// 统一验证码 / 重置令牌：只存 SHA-256 哈希，不存明文
model VerifyCode {
  id        Int       @id @default(autoincrement())
  /// REGISTER | LOGIN | RESET_PASSWORD | REBIND
  scene     String    @db.VarChar(24)
  /// EMAIL | SMS
  channel   String    @db.VarChar(12)
  /// 目标邮箱/手机号（RESET_PASSWORD 链接场景为小写邮箱）
  target    String    @db.VarChar(160)
  codeHash  String    @map("code_hash") @db.VarChar(64)
  failCount Int       @default(0) @map("fail_count")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([channel, target, scene])
  @@map("verify_codes")
}

/// 登录审计：成功/失败都记，连错锁定与风控取数用
model LoginLog {
  id        Int      @id @default(autoincrement())
  /// 登录输入串（用户名/邮箱/手机）
  account   String   @db.VarChar(160)
  userId    String?  @map("user_id") @db.VarChar(64)
  success   Int      @db.TinyInt
  /// 失败原因：密码错误 / 已封禁 / 锁定中 等
  reason    String?  @db.VarChar(120)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([account, createdAt])
  @@index([userId])
  @@map("login_logs")
}

/// AIPDD APIKey 池：按指纹归并，一把 Key 可被多个本地用户绑定（N:1）
model AipddKey {
  id             Int       @id @default(autoincrement())
  /// SHA-256(明文 Key)，用于多用户归并
  keyFingerprint String    @unique @map("key_fingerprint") @db.VarChar(64)
  /// AES-256-GCM 密文（EXTERNAL_CRED_KEY 派生密钥），接口永不回显
  keyCipher      String    @map("key_cipher") @db.Text
  aipddUserId    String?   @map("aipdd_user_id") @db.VarChar(64)
  /// 上游昵称/头像等快照
  aipddProfile   Json?     @map("aipdd_profile")
  status         String    @default("ACTIVE") @db.VarChar(16)
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("aipdd_keys")
}

/// 本地用户 ↔ AIPDD Key 绑定：一个用户只绑一把，一把可被多人绑
model UserAipddBinding {
  id      Int      @id @default(autoincrement())
  userId  String   @unique @map("user_id") @db.VarChar(64)
  keyId   Int      @map("key_id")
  boundAt DateTime @default(now()) @map("bound_at")

  @@index([keyId])
  @@map("user_aipdd_bindings")
}

/// 第三方登录绑定（微信等）：一个账号可绑多个来源，同一来源内 openid 唯一。
/// userId 存 Account.id 的字符串形式（与全系统 userId 口径一致）；不建外键，MySQL/PG 通用。
model AccountBinding {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  /// WECHAT_OPEN（开放平台网站应用扫码）等
  provider  String   @db.VarChar(24)
  openId    String   @map("open_id") @db.VarChar(64)
  /// 开放平台下同一用户的统一身份（跨应用去重用）
  unionId   String?  @map("union_id") @db.VarChar(64)
  nickname  String?  @db.VarChar(64)
  avatarUrl String?  @map("avatar_url") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, openId])
  @@index([userId])
  @@index([provider, unionId])
  @@map("account_bindings")
}

// ============================================================
// 积分体系（设计：docs/积分体系与OSS存储底座设计方案.md）
// 站内唯一计费钱包：充值入 / 行为奖励 / 功能消耗 / 账号间赠送，
// 一切余额变动必过 point_transactions 总账；赚分/花分数量全部管理员可配。
// 精度约定：积分一律 Decimal(18,4)；微信金额一律整数分 amountCents。
// ============================================================

/// 积分账户：与 Account 一对一（首次入账/首次查询懒建）
model PointAccount {
  id                  Int       @id @default(autoincrement())
  userId              String    @unique @map("user_id") @db.VarChar(64)
  /// 可用余额（可小数）
  balanceAmount       Decimal   @default(0) @map("balance_amount") @db.Decimal(18, 4)
  totalRechargeAmount Decimal   @default(0) @map("total_recharge_amount") @db.Decimal(18, 4)
  totalEarnAmount     Decimal   @default(0) @map("total_earn_amount") @db.Decimal(18, 4)
  totalSpendAmount    Decimal   @default(0) @map("total_spend_amount") @db.Decimal(18, 4)
  /// ACTIVE | ARREARS（欠费宽限中：资产只读不可新增）
  status              String    @default("ACTIVE") @db.VarChar(16)
  arrearsSince        DateTime? @map("arrears_since")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("point_accounts")
}

/// 积分总账：只追加不可改删；每条消费一行一账单，Σamount 与账户余额全量可对账
model PointTransaction {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.VarChar(64)
  /// RECHARGE | RECHARGE_BONUS | EARN | SPEND | TRANSFER_IN | TRANSFER_OUT | ADMIN_ADJUST
  type           String   @db.VarChar(24)
  /// register/invite/asset_storage/crm/bi/oa/ai_service/gift/admin…（奖励与消耗场景）
  scene          String   @default("") @db.VarChar(32)
  /// 有符号积分：正＝入账，负＝扣减
  amount         Decimal  @db.Decimal(18, 4)
  /// 入账后余额快照
  balanceAmount  Decimal  @map("balance_amount") @db.Decimal(18, 4)
  /// 赠送对手方 userId（TRANSFER 两条流水互指，其余为空）
  counterparty   String   @default("") @db.VarChar(64)
  refType        String   @default("") @map("ref_type") @db.VarChar(32)
  refId          String   @default("") @map("ref_id") @db.VarChar(64)
  /// 手动调整时记录操作管理员
  operator       String   @default("") @db.VarChar(64)
  remark         String   @default("") @db.VarChar(500)
  /// 结算幂等键（如 recharge:<orderId>:principal）：非空即受唯一约束保护，
  /// 重复入账被数据库原子拒绝；同时也是资金结算的对账锚（可恢复结算，§12.6）。
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(96)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type, scene])
  @@map("point_transactions")
}

/// 充值订单：建单锁定汇率与档位赠送；微信 transactionId 唯一索引＝回调幂等键
model RechargeOrder {
  id                Int       @id @default(autoincrement())
  orderNo           String    @unique @map("order_no") @db.VarChar(32)
  userId            String    @map("user_id") @db.VarChar(64)
  /// 微信金额（整数分）
  amountCents       Int       @map("amount_cents")
  /// 成交时汇率（1 元 = N 积分）
  rateAmount        Decimal   @map("rate_amount") @db.Decimal(18, 4)
  pointsAmount      Decimal   @map("points_amount") @db.Decimal(18, 4)
  bonusPointsAmount Decimal   @default(0) @map("bonus_points_amount") @db.Decimal(18, 4)
  channel           String    @default("WECHAT") @db.VarChar(16)
  /// CREATED | PAID | CLOSED | FAILED
  status            String    @default("CREATED") @db.VarChar(16)
  transactionId     String?   @unique @map("transaction_id") @db.VarChar(64)
  prepayId          String    @default("") @map("prepay_id") @db.VarChar(128)
  codeUrl           String    @default("") @map("code_url") @db.VarChar(512)
  paidAt            DateTime? @map("paid_at")
  notifyPayload     Json?     @map("notify_payload")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("recharge_orders")
}

/// 积分与计费设置键值：汇率/充值档位/奖励数量/赠送限额/欠费策略等；敏感键（微信商户私钥等）密文入库
model PointSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("point_settings")
}

/// 模块计费配置：每个功能模块独立“免费/计量”；单价设 0 即免费，管理员随意改
model ModulePricing {
  id              Int      @id @default(autoincrement())
  /// asset_storage/crm/bi/oa/ai_service/ai_customer…
  code            String   @unique @db.VarChar(32)
  /// FREE | METERED
  mode            String   @default("FREE") @db.VarChar(16)
  /// gb_day/query/session/seat_month/instance…
  unit            String   @default("") @db.VarChar(32)
  unitPriceAmount Decimal  @default(0) @map("unit_price_amount") @db.Decimal(18, 4)
  /// 月免费额（单位同 unit）
  freeQuotaAmount Decimal  @default(0) @map("free_quota_amount") @db.Decimal(18, 4)
  /// 最低起扣，防微账单噪声
  minChargeAmount Decimal  @default(0.01) @map("min_charge_amount") @db.Decimal(18, 4)
  enabled         Int      @default(1) @db.TinyInt
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("module_pricing")
}

/// 计量出账原始数据：按天聚合出账类（存储/查询量）落这张表，实时扣费幂等也记这里
model UsageEvent {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.VarChar(64)
  code           String   @db.VarChar(32)
  quantityAmount Decimal  @map("quantity_amount") @db.Decimal(18, 4)
  occurredAt     DateTime @map("occurred_at")
  /// 0=待出账 1=已出账
  billed         Int      @default(0) @db.TinyInt
  billTxId       Int      @default(0) @map("bill_tx_id")
  remark         String   @default("") @db.VarChar(200)
  /// 统一 AI 用量事实（§4.4）：哪个板块、哪个动作、走的哪个模型，未配价目也照记
  module         String   @default("") @db.VarChar(32)
  operation      String   @default("") @db.VarChar(64)
  model          String   @default("") @db.VarChar(128)
  tokenInAmount  Decimal  @default(0) @map("token_in_amount") @db.Decimal(18, 4)
  tokenOutAmount Decimal  @default(0) @map("token_out_amount") @db.Decimal(18, 4)
  /// 本笔实际扣减积分（0＝免费额内/未配科目）
  pointsAmount   Decimal  @default(0) @map("points_amount") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([code, billed, occurredAt])
  @@index([userId, occurredAt])
  @@index([module, occurredAt])
  @@map("usage_events")
}

/// 数字资产每日存储快照：按 GB·天出账的账单源，兼作趋势图
model StorageDailySnapshot {
  id          BigInt   @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  /// 当日占用字节（BigInt：百 GB 级不溢出）
  bytesAmount BigInt   @map("bytes_amount")
  assetCount  Int      @default(0) @map("asset_count")
  /// 快照日（当日 00:00，与 userId 组成幂等键）
  snapshotAt  DateTime @map("snapshot_at")

  @@unique([userId, snapshotAt])
  @@index([snapshotAt])
  @@map("storage_daily_snapshots")
}

// ---------------------------------------------------------------------------
// 创意社区（Comfy Cloud 工作流市场）
//   表间一律用 id 松散关联、不建 Prisma 关系：与 content_* / points 模块同一口径，
//   跨模块读写都在服务层按 userId 收口，避免级联删除误伤社区内容。
// ---------------------------------------------------------------------------

/// 社区工作流：官方模板（source=OFFICIAL）与用户发布（source=USER）同表共陈。
/// format=api 才能站内直接运行；format=ui 只做浏览与下载（Comfy Cloud 拒收 UI 格式）。
model CommunityWorkflow {
  id            Int       @id @default(autoincrement())
  /// 官方＝模板名（与 comfy.org/hub 一一对应），用户＝wf_<uuid8>；发布后不变，作幂等重导入的键
  code          String    @unique @db.VarChar(64)
  /// OFFICIAL | USER
  source        String    @default("USER") @db.VarChar(16)
  /// 归属账号；官方条目为空串（无作者账号，只展示出处）
  ownerUserId   String    @default("") @map("owner_user_id") @db.VarChar(64)
  /// 作者显示名：官方＝模板 author 字段，用户＝发布时昵称
  ownerName     String    @default("") @map("owner_name") @db.VarChar(64)
  title         String    @db.VarChar(200)
  summary       String    @default("") @db.VarChar(500)
  description   String    @default("") @db.Text
  /// image | video | audio | 3d | llm | tools（社区页签分类）
  category      String    @default("image") @db.VarChar(16)
  /// 二级场景名：对应官方 Applied 分组或「文生图」等自定义分组
  groupLabel    String    @default("") @map("group_label") @db.VarChar(64)
  tags          Json      @default("[]")
  /// 产物媒体类型：image | video | audio | file（决定转存限额与前端展示）
  mediaType     String    @default("image") @map("media_type") @db.VarChar(16)
  /// api＝站内可直接运行；ui＝仅浏览（workflow_json 存原文供下载）
  format        String    @default("api") @db.VarChar(8)
  /// 工作流正文：format 对应的原始 JSON（api 格式已经导入期转换固化）
  workflowJson  Json      @map("workflow_json")
  /// 运行表单槽位：[{ key, label, type, nodeId, field, defaultValue, options, min, max }]
  slots         Json      @default("[]")
  /// 封面与示例图：本站 OSS 对象键数组（官方种子由 seed 上传自有桶后回落）
  coverKeys     Json      @default("[]") @map("cover_keys")
  /// 上游出处链接（comfy.org/hub 模板页），卡片保留来源
  comfyUrl      String    @default("") @map("comfy_url") @db.VarChar(500)
  /// PENDING | APPROVED | REJECTED | RECOMMENDED | REMOVED
  status        String    @default("PENDING") @db.VarChar(16)
  auditNote     String    @default("") @map("audit_note") @db.VarChar(500)
  auditedAt     DateTime? @map("audited_at")
  /// 审核人 userId
  auditBy       String    @default("") @map("audit_by") @db.VarChar(64)
  /// 推荐发奖幂等标记：非空＝已就这条工作流给过作者推荐积分，重推不再发
  rewardedAt    DateTime? @map("rewarded_at")
  runCount      Int       @default(0) @map("run_count")
  favoriteCount Int       @default(0) @map("favorite_count")
  likeCount     Int       @default(0) @map("like_count")
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([category, status])
  @@index([source, status])
  @@index([ownerUserId, status])
  @@map("community_workflows")
}

/// 社区运行记录：一次提交＝一个 Comfy Cloud job；产物由调度器转存进自有 OSS
model CommunityRun {
  id              Int       @id @default(autoincrement())
  workflowId      Int       @map("workflow_id")
  userId          String    @map("user_id") @db.VarChar(64)
  /// 上游 job uuid（提交未成功时为空串，只留本地失败记录）
  jobId           String    @default("") @map("job_id") @db.VarChar(64)
  /// queued | running | succeeded | failed | canceled（跟上游 v2 状态同名）
  status          String    @default("queued") @db.VarChar(16)
  progressCurrent Int       @default(0) @map("progress_current")
  progressTotal   Int       @default(0) @map("progress_total")
  /// 排队位（上游 queue_position，0＝不在队首信息内）
  queuePosition   Int       @default(0) @map("queue_position")
  /// 用户填写的槽位值：{ slotKey: value }（图片槽存本站资产 id）
  inputs          Json      @default("{}")
  errorText       String    @default("") @map("error_text") @db.VarChar(500)
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([workflowId])
  @@index([jobId])
  @@index([status, updatedAt])
  @@map("community_runs")
}

/// 运行产物：已从 Comfy Cloud 签名 URL 转存进本站 OSS（签名约 6 小时过期，不落自有桶就必失效）
model CommunityRunOutput {
  id        Int      @id @default(autoincrement())
  runId     Int      @map("run_id")
  /// image | video | audio | file
  kind      String   @default("image") @db.VarChar(16)
  name      String   @default("") @db.VarChar(200)
  /// 本站 OSS 对象键（空＝转存失败，仅留 url 快照）
  ossKey    String   @default("") @map("oss_key") @db.VarChar(500)
  /// 转存后的可访问地址（本站 OSS，非上游短命签名 URL）
  url       String   @default("") @db.Text
  sizeBytes BigInt   @default(0) @map("size_bytes")
  /// 关联的本站数字资产 id（DigitalAssetEntry.id，0＝未入台账）
  assetId   Int      @default(0) @map("asset_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@map("community_run_outputs")
}

/// 社区收藏：按账号唯一，重复收藏幂等
model CommunityFavorite {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  workflowId Int      @map("workflow_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, workflowId])
  @@index([workflowId])
  @@map("community_favorites")
}

/// 社区点赞：与收藏分表，便于后续单独统计与开关
model CommunityLike {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  workflowId Int      @map("workflow_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, workflowId])
  @@index([workflowId])
  @@map("community_likes")
}

/// Comfy Cloud 凭据：纯 BYOK，一个账号一把 Key；AES-256-GCM 密文入库，keyMask 仅供展示
model ComfyCredential {
  userId     String    @id @map("user_id") @db.VarChar(64)
  keyCipher  String    @map("key_cipher") @db.Text
  /// 掩码展示（前4…后4），任何接口不回传原文
  keyMask    String    @default("") @map("key_mask") @db.VarChar(64)
  /// 最后一次校验通过时间；为空＝存了但未验证通过
  verifiedAt DateTime? @map("verified_at")
  /// 最近一次校验失败原因（已中文化，供引导弹窗展示）
  lastError  String    @default("") @map("last_error") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("comfy_credentials")
}

/// 跨境电商商品页优化：一次「商品简报 → 卖点规划 → 主图/详情页图包」的运行台账
model EcomPdpPack {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  productName String   @map("product_name") @db.VarChar(191)
  category    String   @default("") @db.VarChar(64)
  market      String   @default("US") @db.VarChar(32)
  /// draft | planning | planned | generating | completed | failed
  status      String   @default("draft") @db.VarChar(16)
  /// 商品简报全量（含参考图与主图/详情页数量）
  input       Json     @default("{}")
  /// 规划结果：转化驱动 / Buyer Reason Card / Style Lock / 假设与禁用表述
  plan        Json     @default("{}")
  error       String   @default("") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets EcomPdpAsset[]

  @@index([userId, updatedAt])
  @@map("ecom_pdp_packs")
}

/// 图包里的一张图：主图（hero）或详情页（detail），提示词可逐张改后再生成
model EcomPdpAsset {
  id        Int      @id @default(autoincrement())
  packId    Int      @map("pack_id")
  /// hero | detail
  kind      String   @db.VarChar(16)
  position  Int
  title     String   @default("") @db.VarChar(191)
  purpose   String   @default("") @db.VarChar(191)
  /// 场景模板键（把参考仓库的 25 个场景归并后的注册表键）
  sceneKey  String   @default("") @map("scene_key") @db.VarChar(64)
  /// 图面文案（英文基线 + 本地化层），逐条一行
  copy      String   @default("") @db.Text
  /// 完整出图提示词（Style Lock 前缀 + 场景正文 + 负面清单）
  prompt    String   @default("") @db.Text
  size      String   @default("") @db.VarChar(16)
  /// pending | generating | done | failed
  status    String   @default("pending") @db.VarChar(16)
  url       String   @default("") @db.Text
  /// 平台数字资产 id（登记失败为空，不影响出图）
  assetId   String   @default("") @map("asset_id") @db.VarChar(64)
  error     String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pack EcomPdpPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, kind, position])
  @@index([packId])
  @@map("ecom_pdp_assets")
}

/// 国内电商商品页优化：一次「商品简报 → 卖点规划 → 主图/详情页图包」的运行台账
model DomesticPdpPack {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  productName String   @map("product_name") @db.VarChar(191)
  category    String   @default("") @db.VarChar(64)
  /// 淘宝/天猫、京东、拼多多、抖音商城、1688
  platform    String   @default("") @db.VarChar(32)
  /// brand | pro | grass | promo
  tone        String   @default("brand") @db.VarChar(16)
  /// draft | planning | planned | generating | completed | failed
  status      String   @default("draft") @db.VarChar(16)
  /// 商品简报全量（含参考图与主图/详情页数量）
  input       Json     @default("{}")
  /// 规划结果：转化驱动 / 购买理由卡 / Style Lock / 假设与禁用表述
  plan        Json     @default("{}")
  error       String   @default("") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets DomesticPdpAsset[]

  @@index([userId, updatedAt])
  @@map("domestic_pdp_packs")
}

/// 国内图包里的一张图：主图（hero）或详情页（detail），提示词可逐张改后再生成
model DomesticPdpAsset {
  id        Int      @id @default(autoincrement())
  packId    Int      @map("pack_id")
  /// hero | detail
  kind      String   @db.VarChar(16)
  position  Int
  title     String   @default("") @db.VarChar(191)
  purpose   String   @default("") @db.VarChar(191)
  /// 场景模板键（国内电商场景注册表：白底 / 卖点 / 场景 / 参数 / 信任…）
  sceneKey  String   @default("") @map("scene_key") @db.VarChar(64)
  /// 图面文案（中文，逐条一行）
  copy      String   @default("") @db.Text
  /// 完整出图提示词（Style Lock 前缀 + 场景正文 + 中文文案 + 负面清单）
  prompt    String   @default("") @db.Text
  size      String   @default("") @db.VarChar(16)
  /// pending | generating | done | failed
  status    String   @default("pending") @db.VarChar(16)
  url       String   @default("") @db.Text
  /// 平台数字资产 id（登记失败为空，不影响出图）
  assetId   String   @default("") @map("asset_id") @db.VarChar(64)
  error     String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pack DomesticPdpPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, kind, position])
  @@index([packId])
  @@map("domestic_pdp_assets")
}

/// 多平台内容分发（营销工具）：内容台账按登录账号归属，实际发布由浏览器插件在本地完成
model DistributionContent {
  id                Int       @id @default(autoincrement())
  /// 归属登录账号（与潜客线索 / 大数据任务同口径：只按账号隔离）
  userId            String    @map("user_id") @db.VarChar(64)
  title             String    @db.VarChar(200)
  /// 正文：受限 HTML（富文本），旧数据为纯文本；MediumText 因样式标记会显著放大字节数
  content           String    @db.MediumText
  /// MOMENT（动态/图文） | ARTICLE（文章）
  mediaType         String    @default("MOMENT") @map("media_type") @db.VarChar(16)
  /// 图片清单：[{ name, url }]（发布时由插件按 URL 拉取，JSON 无默认值，创建时必传）
  images            Json
  /// 勾选的平台编码（契约 DISTRIBUTION_PLATFORMS 注册表内）
  platformCodes     Json      @map("platform_codes")
  /// 插件是否自动点发布（默认关：只填充，人工确认后发布）
  autoPublish       Boolean   @default(false) @map("auto_publish")
  /// DRAFT（未分发） | DISTRIBUTED（已分发）
  status            String    @default("DRAFT") @db.VarChar(16)
  tags              String    @default("") @db.VarChar(200)
  lastDistributedAt DateTime? @map("last_distributed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  logs DistributionPublishLog[]

  @@index([userId, updatedAt])
  @@index([userId, mediaType, status])
  @@map("distribution_contents")
}

/// 逐平台发布结果：页面收到插件回调后上报（EXTENSION），或人工补记（MANUAL）
model DistributionPublishLog {
  id                Int       @id @default(autoincrement())
  contentId         Int       @map("content_id")
  userId            String    @map("user_id") @db.VarChar(64)
  platformCode      String    @map("platform_code") @db.VarChar(32)
  platformName      String    @default("") @map("platform_name") @db.VarChar(64)
  /// FILLED（已填充待确认） | SUCCESS（已发布） | FAILED（失败）
  status            String    @db.VarChar(16)
  publishedUrl      String    @default("") @map("published_url") @db.VarChar(500)
  /// 平台侧作品标识（微博 mid / B站 bvid 等）：效果回流时用它对齐「哪一条内容」
  publishedItemId   String    @default("") @map("published_item_id") @db.VarChar(120)
  errorMsg          String    @default("") @map("error_msg") @db.VarChar(500)
  /// EXTENSION | MANUAL
  source            String    @default("EXTENSION") @db.VarChar(16)
  /// 效果数据（D8）：阅读/播放量、点赞、评论；未回写时为 0
  views             Int       @default(0)
  likes             Int       @default(0)
  comments          Int       @default(0)
  /// 效果数据来源：EXTENSION（插件读创作中心） | MANUAL（人工补录） | ""（尚未回写）
  metricsSource     String    @default("") @map("metrics_source") @db.VarChar(16)
  /// 效果数据抓取时间；未回写时为 null
  metricsCapturedAt DateTime? @map("metrics_captured_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  content DistributionContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@map("distribution_publish_logs")
}

/// 菜单/功能目录（§5.10 唯一数据源）：树状；GROUP 关闭时子项级联失效；存量硬编码菜单树折入后由本表驱动
model FeatureCatalog {
  id         Int      @id @default(autoincrement())
  /// 全局唯一编码（如 "tax"、"business-group"、"developer-mcp"）
  code       String   @unique @db.VarChar(64)
  /// GROUP＝分组节点；MENU＝叶子菜单
  kind       String   @default("MENU") @db.VarChar(8)
  /// 父节点 code；根节点为空串
  parentCode String   @default("") @map("parent_code") @db.VarChar(64)
  title      String   @db.VarChar(64)
  /// 前端路径（MENU 有、GROUP 可空）；后端拦截按 path 前缀匹配
  path       String   @default("") @db.VarChar(120)
  /// PLATFORM＝平台级开关；ORG＝企业级开关
  scope      String   @default("PLATFORM") @db.VarChar(16)
  /// protected 不可关（认证会话/平台管理自身/账户计费/合规退出）；求值时强制 open
  protected  Int      @default(0) @db.TinyInt
  sortOrder  Int      @default(0) @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([parentCode])
  @@map("feature_catalog")
}

/// 功能开关（§5.10）：无行即 open；closed 时菜单隐藏 + 直链/MCP 同路径后端 403 FEATURE_CLOSED；ORG 行覆盖 PLATFORM 行
model FeatureToggle {
  id        Int      @id @default(autoincrement())
  code      String   @db.VarChar(64)
  /// PLATFORM＝全用户默认行；ORG＝指定企业覆盖行
  scope     String   @default("PLATFORM") @db.VarChar(16)
  /// scope=ORG 时的归属人 userId；PLATFORM 为空串
  orgUserId String   @default("") @map("org_user_id") @db.VarChar(64)
  /// open | closed
  state     String   @default("open") @db.VarChar(8)
  updatedBy String   @default("") @map("updated_by") @db.VarChar(64)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([code, scope, orgUserId])
  @@map("feature_toggles")
}

/// Agent 访问策略（§5.9）：平台级单行——黑名单 + 沙箱硬上限；技能/连接器运行时不得突破，只能由平台管理员收紧
model AgentAccessPolicy {
  id        Int      @id @default(autoincrement())
  /// 黑名单条目 [{ type: domain|ip|ipRange|cidr, value, reason, addedBy, addedAt }]
  blacklist Json     @default("[]")
  /// 沙箱硬上限 { minIntervalMs, maxConcurrency, timeoutMs, maxRequestsPerRun, perDomainQps, allowMethods[], enforceRobots, botUa }
  limits    Json     @default("{}")
  updatedBy String   @default("") @map("updated_by") @db.VarChar(64)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_access_policies")
}

/// 技能包/插件审查台账（§5.9）：静态命中、LLM 判定、最终决议全程留痕；账单/审计可回溯「当时用什么规则审的」
model SkillReviewRun {
  id          Int      @id @default(autoincrement())
  /// skill | plugin
  kind        String   @db.VarChar(8)
  /// 对应 content_agent_skills/plugins 行 id；拒收未落库时为 0
  itemId      Int      @default(0) @map("item_id")
  userId      String   @map("user_id") @db.VarChar(64)
  /// 包内容 sha256（去重与完整性审计）
  inputDigest String   @default("") @map("input_digest") @db.VarChar(64)
  /// 静态红线命中 [{ rule, file, excerpt }]
  staticHits  Json     @default("[]") @map("static_hits")
  /// LLM 判定原文 { decision, riskLevel, violations[], summary }
  llmVerdict  Json     @default("{}") @map("llm_verdict")
  /// pass | reject | needsAdmin | unreviewed（未配 Key / 超时，默认拒绝）
  decision    String   @default("unreviewed") @db.VarChar(16)
  /// none | low | medium | high
  riskLevel   String   @default("") @map("risk_level") @db.VarChar(8)
  model       String   @default("") @db.VarChar(64)
  tokens      Int      @default(0)
  costAmount  Decimal  @default(0) @map("cost_amount") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([kind, itemId])
  @@map("skill_review_runs")
}

/// 平台管理员「生成 Skill」的产物：按技能名唯一，重新生成覆盖并记录更新时间；
/// 模型服务 → API-MCP-Skill → Skill 页签供全站账号列表与下载。
model GeneratedSkill {
  id             Int      @id @default(autoincrement())
  /// SkillHub 唯一标识（小写 slug）
  name           String   @unique @db.VarChar(64)
  displayName    String   @map("display_name") @db.VarChar(60)
  description    String   @db.Text
  domain         String   @db.VarChar(64)
  domainLabel    String   @map("domain_label") @db.VarChar(120)
  category       String   @db.VarChar(64)
  operationCount Int      @map("operation_count")
  /// 生成时使用的文本模型，排障与溯源用
  model          String   @db.VarChar(120)
  filename       String   @db.VarChar(120)
  /// 根目录带 SKILL.md 的标准 zip 包
  zip            Bytes
  createdBy      String   @map("created_by") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("generated_skills")
}

/// Agent 调用按用量计费规则（§5.12）：module_pricing 价目作 PLATFORM 默认种子；PLAN>ORG>PLATFORM 行覆盖；一个科目可多 metric 行复合（如输入/输出 token 分别计价）
model BillingRule {
  id               Int      @id @default(autoincrement())
  /// 科目 code（与积分方案 §8.4 对齐：insight_report/kb_query/mkt_skill_run/skill_review…）
  code             String   @db.VarChar(32)
  /// PLATFORM＝默认行；ORG＝企业覆盖；PLAN＝套餐覆盖（优先级 PLAN>ORG>PLATFORM）
  scope            String   @default("PLATFORM") @db.VarChar(16)
  orgUserId        String   @default("") @map("org_user_id") @db.VarChar(64)
  /// token_in | token_out | call | byte | page
  metric           String   @default("call") @db.VarChar(16)
  unitPriceAmount  Decimal  @default(0) @map("unit_price_amount") @db.Decimal(18, 4)
  baseFeeAmount    Decimal  @default(0) @map("base_fee_amount") @db.Decimal(18, 4)
  multiplier       Decimal  @default(1) @db.Decimal(8, 4)
  minChargeAmount  Decimal  @default(0.01) @map("min_charge_amount") @db.Decimal(18, 4)
  /// 单次最高扣分；0＝不封顶
  maxChargeAmount  Decimal  @default(0) @map("max_charge_amount") @db.Decimal(18, 4)
  /// 月预算帽（按 org+科目）；0＝不封顶，超出熔断只记流水不扣分
  budgetCapMonthly Decimal  @default(0) @map("budget_cap_monthly") @db.Decimal(18, 4)
  freeQuotaMonthly Decimal  @default(0) @map("free_quota_monthly") @db.Decimal(18, 4)
  enabled          Int      @default(1) @db.TinyInt
  version          Int      @default(1)
  updatedBy        String   @default("") @map("updated_by") @db.VarChar(64)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([code, scope, orgUserId, metric])
  @@index([code, enabled])
  @@map("billing_rules")
}

// ——— §10 公共知识库与知识图谱底座（L1，表前缀 kb_*）———

/// 知识空间：一个隔离的 wiki 库；scopeType 区分归属，visibility 控制读面（§10.2）
model KbSpace {
  id          Int      @id @default(autoincrement())
  /// ENTERPRISE | PROVIDER；空＝个人空间（仅 ownerUserId 可用）
  orgType     String   @default("") @map("org_type") @db.VarChar(16)
  orgUserId   String   @default("") @map("org_user_id") @db.VarChar(64)
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  /// PERSONAL | ENTERPRISE | PROVIDER | AGENT | AVATAR | SERVICE_DESK
  scopeType   String   @default("PERSONAL") @map("scope_type") @db.VarChar(24)
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  /// PRIVATE | ORG | SHARED | PUBLIC
  visibility  String   @default("PRIVATE") @db.VarChar(12)
  /// ACTIVE | ARCHIVED
  status      String   @default("ACTIVE") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgUserId])
  @@index([ownerUserId])
  @@map("kb_spaces")
}

/// 账户当前绑定的知识空间（Kb_setSpace：Agent/分身「当前知识库」上下文，一人一行）
model KbSpaceBinding {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  spaceId   Int      @map("space_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kb_space_bindings")
}

/// 空间维护规范（对标 CLAUDE.md/AGENTS.md，可版本化）：页面类型定义 + Ingest/Lint 工作流提示词
model KbSchema {
  id             Int      @id @default(autoincrement())
  spaceId        Int      @unique @map("space_id")
  /// 页面类型定义 [{ type, fields[], description }]
  pageTypes      Json     @default("[]") @map("page_types")
  /// 维护规范正文（Ingest/Lint/命名约定，供提示词拼接）
  workflowPrompt String   @default("") @map("workflow_prompt") @db.Text
  version        Int      @default(1)
  updatedBy      String   @default("") @map("updated_by") @db.VarChar(64)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("kb_schemas")
}

/// 原始资料层（不可变只读）：优先引用 DigitalAssetEntry（assetId），直投文本时 text 自持（§10.7 存储融合）
model KbSource {
  id         Int       @id @default(autoincrement())
  spaceId    Int       @map("space_id")
  /// 引用的 digital_asset_entries 行 id；0＝直投文本
  assetId    Int       @default(0) @map("asset_id")
  /// article | paper | transcript | meeting | customer-call | note | image
  kind       String    @default("article") @db.VarChar(16)
  /// 摄取入口：TEXT 直投 | UPLOAD 文件上传 | URL 抓取 | FEISHU 文档 | OCR 图像/音视频
  type       String    @default("TEXT") @db.VarChar(16)
  /// 原始地址留痕（URL/飞书文档/对象键回链；直投为空）
  originUrl  String    @default("") @map("origin_url") @db.VarChar(2000)
  /// 上传文件在本站 OSS 的对象键（非空＝字节存自有桶）
  ossKey     String    @default("") @map("oss_key") @db.VarChar(512)
  title      String    @db.VarChar(200)
  /// 源正文（资产类由解析/抽取填入；源不可变，后续只读）
  text       String    @db.LongText
  /// 正文 sha256：入库去重与完整性审计
  hash       String    @default("") @db.VarChar(64)
  /// PENDING | INGESTED | FAILED
  status     String    @default("PENDING") @db.VarChar(16)
  error      String    @default("") @db.VarChar(500)
  ingestedAt DateTime? @map("ingested_at")
  createdBy  String    @default("") @map("created_by") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([spaceId, status])
  @@index([spaceId, hash])
  @@map("kb_sources")
}

/// LLM 维护的 wiki 页（编译制品）：slug 空间内唯一，body 为 rich-text markdown（含 [[wikilink]]）；人在环走 status
model KbPage {
  id          Int      @id @default(autoincrement())
  spaceId     Int      @map("space_id")
  slug        String   @db.VarChar(120)
  /// ENTITY | CONCEPT | SUMMARY | COMPARISON | SYNTHESIS | INDEX | LOG
  type        String   @default("CONCEPT") @db.VarChar(16)
  title       String   @db.VarChar(200)
  body        String   @db.LongText
  /// 结构化元数据 { tags[], dates, sourceCount, entityType, domain }
  frontmatter Json     @default("{}")
  version     Int      @default(1)
  /// DRAFT | PENDING_REVIEW | PUBLISHED（LLM 写入默认进 PENDING_REVIEW，§10.1 人在环）
  status      String   @default("PUBLISHED") @db.VarChar(16)
  reviewNote  String   @default("") @map("review_note") @db.VarChar(500)
  updatedBy   String   @default("") @map("updated_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([spaceId, slug])
  @@index([spaceId, type])
  @@index([spaceId, status])
  @@map("kb_pages")
}

/// 页↔源引用关系：每个结论可溯源（带引用回答的地基，§10.3）
model KbPageSource {
  id        Int      @id @default(autoincrement())
  pageId    Int      @map("page_id")
  sourceId  Int      @map("source_id")
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pageId, sourceId])
  @@index([sourceId])
  @@map("kb_page_sources")
}

/// 图谱实体（人/组织/概念/产品/客户…）：wikilink 解析时自动建/复用
model KbEntity {
  id        Int      @id @default(autoincrement())
  spaceId   Int      @map("space_id")
  name      String   @db.VarChar(120)
  /// PERSON | ORG | CONCEPT | PRODUCT | CUSTOMER | PROJECT | OTHER
  type      String   @default("CONCEPT") @db.VarChar(24)
  summary   String   @default("") @db.VarChar(500)
  /// 对应的实体页 slug 行 id；0＝尚未建页（Lint 建议补页）
  pageId    Int      @default(0) @map("page_id")
  aliases   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([spaceId, name])
  @@index([spaceId, type])
  @@map("kb_entities")
}

/// 关系边：from/to 为 KbEntity id；wikilink/实体抽取自动建边，weight/confidence 供关联度打分
model KbRelation {
  id           Int      @id @default(autoincrement())
  spaceId      Int      @map("space_id")
  fromId       Int      @map("from_id")
  toId         Int      @map("to_id")
  relation     String   @db.VarChar(64)
  weight       Float    @default(1)
  confidence   Float    @default(1)
  /// 建边依据的页（可溯源）
  sourcePageId Int      @default(0) @map("source_page_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([fromId, toId, relation])
  @@index([spaceId, toId])
  @@map("kb_relations")
}

/// 空间级索引与向量统计（页+一行摘要目录另走 KbPage type=INDEX；本表持演进判据 §10.9）
model KbIndex {
  id           Int       @id @default(autoincrement())
  spaceId      Int       @unique @map("space_id")
  /// embedding 模型与版本（换模型全量重算，版本隔离）
  model        String    @default("") @db.VarChar(64)
  version      Int       @default(1)
  pageCount    Int       @default(0) @map("page_count")
  chunkCount   Int       @default(0) @map("chunk_count")
  embeddingDim Int       @default(0) @map("embedding_dim")
  /// 演进判据快照 { avgQueryMs, lastLintAt, vectorSwitchHint }
  stats        Json      @default("{}")
  statsAt      DateTime? @map("stats_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("kb_indexes")
}

/// 时间线台账：ingest/query/lint/write/consolidate 流水（Agent 了解「最近做了什么」）
model KbLog {
  id          Int      @id @default(autoincrement())
  spaceId     Int      @map("space_id")
  /// INGEST | QUERY | LINT | WRITE | REVIEW | CONSOLIDATE | BIND
  kind        String   @db.VarChar(16)
  summary     String   @db.VarChar(500)
  detail      Json     @default("{}")
  actorUserId String   @default("") @map("actor_user_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([spaceId, createdAt])
  @@map("kb_logs")
}

/// 检索切块：①轻量向量为 MySQL JSON 主存（唯一真源），应用层余弦；未配 embedding 时留空走关键词召回（§10.5/§10.9）
model KbChunk {
  id        Int      @id @default(autoincrement())
  spaceId   Int      @map("space_id")
  pageId    Int      @map("page_id")
  ordinal   Int      @default(0)
  text      String   @db.LongText
  tokens    Int      @default(0)
  /// 向量（number[]）；空数组＝未 embedding
  embedding Json     @default("[]")
  model     String   @default("") @db.VarChar(64)
  /// 块元数据（权限/溯源标签）：{ type, tags[], visibility }，检索侧可据标签过滤
  meta      Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pageId, ordinal])
  @@index([spaceId])
  @@map("kb_chunks")
}

/// 消费者↔空间绑定（§10.2 多消费者模型）：分身/客服/ERP/CRM 按优先级挂读或写
model KbConsumer {
  id           Int      @id @default(autoincrement())
  spaceId      Int      @map("space_id")
  /// AVATAR | AGENT | SERVICE_DESK | ERP | CRM
  consumerType String   @map("consumer_type") @db.VarChar(16)
  /// 消费者主体 id（分身=expertId/客服=agentId/业务=对象类型:id 等约定串）
  consumerId   String   @map("consumer_id") @db.VarChar(64)
  /// READ | WRITE
  role         String   @default("READ") @db.VarChar(8)
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([spaceId, consumerType, consumerId])
  @@index([consumerType, consumerId])
  @@map("kb_consumers")
}

/// 摄取异步作业（BatchRun 台账风格）：LLM 可用走抽取建页，未配 Key 回落规则式摘要页（verify 可跑）
model KbIngestJob {
  id            Int       @id @default(autoincrement())
  spaceId       Int       @map("space_id")
  sourceId      Int       @map("source_id")
  /// PENDING | RUNNING | DONE | FAILED
  status        String    @default("PENDING") @db.VarChar(16)
  /// 本作业影响的页 id 列表（回链溯源）
  pagesAffected Json      @default("[]") @map("pages_affected")
  error         String    @default("") @db.VarChar(500)
  model         String    @default("") @db.VarChar(64)
  tokens        Int       @default(0)
  costAmount    Decimal   @default(0) @map("cost_amount") @db.Decimal(18, 4)
  createdBy     String    @default("") @map("created_by") @db.VarChar(64)
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([spaceId, status])
  @@map("kb_ingest_jobs")
}

/// 健康巡检台账：矛盾/孤儿/枢纽/缺失交叉引用四类洞察（§10.5 图谱洞察）
model KbLintRun {
  id         Int       @id @default(autoincrement())
  spaceId    Int       @map("space_id")
  /// RUNNING | DONE | FAILED
  status     String    @default("RUNNING") @db.VarChar(16)
  /// { hubs[], orphans[], conflicts[], missingRefs[] }
  findings   Json      @default("{}")
  summary    String    @default("") @db.VarChar(500)
  createdBy  String    @default("") @map("created_by") @db.VarChar(64)
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([spaceId, createdAt])
  @@map("kb_lint_runs")
}

// ---------- L2 HRM（方案 §5.1：档案/假勤/招聘双表/人才评估 rubric §12.9） ----------

/// 员工档案：一对一挂 OrgStaff（入转调离的 HRM 主体面）
model HrmEmployeeProfile {
  id               Int      @id @default(autoincrement())
  orgType          String   @map("org_type") @db.VarChar(16)
  orgUserId        String   @map("org_user_id") @db.VarChar(64)
  /// 成员账号（同 OrgStaff.memberUserId）
  memberUserId     String   @map("member_user_id") @db.VarChar(64)
  employeeNo       String   @default("") @map("employee_no") @db.VarChar(32)
  /// FULL_TIME 正式 | LABOR 劳务 | AGENT 代理
  employmentType   String   @default("FULL_TIME") @map("employment_type") @db.VarChar(16)
  /// 时薪（工作量成本归集口径，§5.2）
  hourlyRate       Decimal  @default(0) @map("hourly_rate") @db.Decimal(18, 2)
  supervisorUserId String   @default("") @map("supervisor_user_id") @db.VarChar(64)
  department       String   @default("") @db.VarChar(64)
  /// 技能标签（团队能力图谱/入档脱敏评估输入）
  skills           Json     @default("[]")
  /// PROBATION 试用 | ACTIVE 正式 | LEFT 离职
  status           String   @default("PROBATION") @db.VarChar(16)
  joinedAt         String   @default("") @map("joined_at") @db.VarChar(16)
  leftAt           String   @default("") @map("left_at") @db.VarChar(16)
  note             String   @default("") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, memberUserId])
  @@index([orgType, orgUserId, status])
  @@map("hrm_employee_profiles")
}

/// 假勤政策：年度额度与规则（政策→余额→申请→审批链路的源头）
model HrmAttendancePolicy {
  id        Int      @id @default(autoincrement())
  orgType   String   @map("org_type") @db.VarChar(16)
  orgUserId String   @map("org_user_id") @db.VarChar(64)
  year      Int
  name      String   @db.VarChar(64)
  /// { ANNUAL:5, SICK:10, PERSONAL:3, MARRY:3, BEREAVEMENT:3, UNPAID_LIMIT:0 } 年度额度（天）
  quotas    Json     @default("{}")
  /// 未命中政策时的默认政策（每组织每年至多一条）
  isDefault Boolean  @default(false) @map("is_default")
  updatedBy String   @default("") @map("updated_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, year, name])
  @@index([orgType, orgUserId, year])
  @@map("hrm_attendance_policies")
}

/// 假勤余额：按人×年×假别（首次请假按政策懒建，审批通过即扣减）
model HrmTimeOffBalance {
  id          Int      @id @default(autoincrement())
  orgType     String   @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  staffUserId String   @map("staff_user_id") @db.VarChar(64)
  year        Int
  /// ANNUAL | SICK | PERSONAL | MARRY | BEREAVEMENT | UNPAID
  type        String   @db.VarChar(24)
  totalDays   Decimal  @default(0) @map("total_days") @db.Decimal(6, 2)
  usedDays    Decimal  @default(0) @map("used_days") @db.Decimal(6, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, staffUserId, year, type])
  @@map("hrm_time_off_balances")
}

/// 请假/销假申请：本期内置审批（HR/主管直批），OA 实例 ID 预留回写
model HrmTimeOffRequest {
  id              Int       @id @default(autoincrement())
  orgType         String    @map("org_type") @db.VarChar(16)
  orgUserId       String    @map("org_user_id") @db.VarChar(64)
  staffUserId     String    @map("staff_user_id") @db.VarChar(64)
  type            String    @db.VarChar(24)
  startDate       String    @map("start_date") @db.VarChar(16)
  endDate         String    @map("end_date") @db.VarChar(16)
  days            Decimal   @db.Decimal(6, 2)
  reason          String    @default("") @db.VarChar(500)
  /// PENDING | APPROVED | REJECTED | CANCELLED | REVOKED（销假）
  status          String    @default("PENDING") @db.VarChar(16)
  approverUserId  String    @default("") @map("approver_user_id") @db.VarChar(64)
  decidedAt       DateTime? @map("decided_at")
  note            String    @default("") @db.VarChar(500)
  /// 预留：走 OA 审批实例时回写（§5.1「申请走 OA」）
  oaApplicationId Int       @default(0) @map("oa_application_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([orgType, orgUserId, status])
  @@index([staffUserId, status])
  @@map("hrm_time_off_requests")
}

/// 节假日（考勤跳过口径）；orgUserId 空串＝平台全局默认
model HrmHoliday {
  id          Int      @id @default(autoincrement())
  orgType     String   @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  /// YYYY-MM-DD
  holidayDate String   @map("holiday_date") @db.VarChar(16)
  name        String   @db.VarChar(64)
  days        Decimal  @default(1) @db.Decimal(2, 1)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([orgType, orgUserId, holidayDate])
  @@map("hrm_holidays")
}

/// 打卡流水：Web 打卡 + 补卡（飞书同步预留 source=FEISHU）
model HrmAttendanceLog {
  id          Int      @id @default(autoincrement())
  orgType     String   @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  staffUserId String   @map("staff_user_id") @db.VarChar(64)
  /// YYYY-MM-DD
  logDate     String   @map("log_date") @db.VarChar(16)
  /// CLOCK_IN | CLOCK_OUT | REMEDY（补卡）
  checkType   String   @map("check_type") @db.VarChar(16)
  at          DateTime
  /// WEB | FEISHU | REMEDY
  source      String   @default("WEB") @db.VarChar(16)
  /// NORMAL | LATE | EARLY（打卡时自动对照上班时间标记）
  mark        String   @default("NORMAL") @db.VarChar(16)
  note        String   @default("") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orgType, orgUserId, staffUserId, logDate])
  @@map("hrm_attendance_logs")
}

/// 用人申请（HC 审批前置）：批准后自动生成招聘职位
model HrmHiringRequest {
  id              Int       @id @default(autoincrement())
  orgType         String    @map("org_type") @db.VarChar(16)
  orgUserId       String    @map("org_user_id") @db.VarChar(64)
  department      String    @default("") @db.VarChar(64)
  position        String    @db.VarChar(120)
  headCount       Int       @default(1) @map("head_count")
  /// 职级带（talent-match 词表口径：实习/应届/初级/中级/高级/专家/总监）
  expectedTier    String    @default("") @map("expected_tier") @db.VarChar(24)
  budgetMonthly   Decimal   @default(0) @map("budget_monthly") @db.Decimal(18, 2)
  reason          String    @default("") @db.VarChar(500)
  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING") @db.VarChar(16)
  applicantUserId String    @default("") @map("applicant_user_id") @db.VarChar(64)
  approverUserId  String    @default("") @map("approver_user_id") @db.VarChar(64)
  decidedAt       DateTime? @map("decided_at")
  /// 批准后生成的职位 ID
  jobId           Int       @default(0) @map("job_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([orgType, orgUserId, status])
  @@map("hrm_hiring_requests")
}

/// 招聘职位（对内主体）：与 HiringPost（对外渠道）一一关联，JD 为单一数据源
model HrmJob {
  id              Int      @id @default(autoincrement())
  orgType         String   @map("org_type") @db.VarChar(16)
  orgUserId       String   @map("org_user_id") @db.VarChar(64)
  title           String   @db.VarChar(120)
  department      String   @default("") @db.VarChar(64)
  headCount       Int      @default(1) @map("head_count")
  /// 职级带（同 HrmHiringRequest 口径）
  tier            String   @default("") @db.VarChar(24)
  /// JD 正文（纯文本/markdown，发布时裁剪生成 HiringPost.description）
  jd              String   @db.Text
  /// OPEN | CLOSED | FILLED | CANCELED
  status          String   @default("OPEN") @db.VarChar(16)
  hiringRequestId Int      @default(0) @map("hiring_request_id")
  /// 已发布到的 sns_hiring_posts.id（0＝未发布）
  hiringPostId    Int      @default(0) @map("hiring_post_id")
  /// 雇主侧进面阈值覆盖（§12.9.2 同默认 4.0）
  minScore        Decimal  @default(4.0) @map("min_score") @db.Decimal(2, 1)
  ownerId         String   @default("") @db.VarChar(64)
  createdBy       String   @default("") @map("created_by") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, status])
  @@map("hrm_jobs")
}

/// 候选人库：结构化事实（items）供 rubric 评估，resumeText 为解析/粘贴原文
model HrmCandidate {
  id            Int      @id @default(autoincrement())
  orgType       String   @map("org_type") @db.VarChar(16)
  orgUserId     String   @map("org_user_id") @db.VarChar(64)
  name          String   @db.VarChar(64)
  phone         String   @default("") @db.VarChar(32)
  email         String   @default("") @db.VarChar(120)
  /// UPLOAD 手动/简历导入 | HIRING_POST 渠道回流 | REFERRAL 内推
  source        String   @default("UPLOAD") @db.VarChar(24)
  resumeAssetId Int      @default(0) @map("resume_asset_id")
  resumeText    String   @default("") @map("resume_text") @db.Text
  /// [{ id, kind: EDU|WORK|PROJECT|SKILL, title, detail, period }]（§12.9 evidence sourceRef 回跳锚点）
  items         Json     @default("[]")
  skills        Json     @default("[]")
  tier          String   @default("") @db.VarChar(24)
  note          String   @default("") @db.VarChar(500)
  createdBy     String   @default("") @map("created_by") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, createdAt])
  @@map("hrm_candidates")
}

/// 投递/候选人×职位：talent-match 评分落库处（参考分，决策必须人工动作留痕）
model HrmApplication {
  id            Int      @id @default(autoincrement())
  orgType       String   @map("org_type") @db.VarChar(16)
  orgUserId     String   @map("org_user_id") @db.VarChar(64)
  jobId         Int      @map("job_id")
  candidateId   Int      @map("candidate_id")
  /// LOCAL HR录入 | HIRING_POST 渠道投递回流
  channel       String   @default("LOCAL") @db.VarChar(24)
  /// NEW | SCREENING | INTERVIEWING | OFFER | REJECTED | WITHDRAWN
  status        String   @default("NEW") @db.VarChar(16)
  matchScore    Decimal  @default(0) @map("match_score") @db.Decimal(2, 1)
  matchTier     String   @default("") @map("match_tier") @db.VarChar(16)
  /// { dimensions[], requirementsMatrix[], knockouts[], recommendation }（§12.9.1 结构化出参）
  evalResult    Json     @default("{}") @map("eval_result")
  rubricCode    String   @default("") @map("rubric_code") @db.VarChar(32)
  rubricVersion Int      @default(0) @map("rubric_version")
  decidedBy     String   @default("") @map("decided_by") @db.VarChar(64)
  createdBy     String   @default("") @map("created_by") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([jobId, candidateId])
  @@index([orgType, orgUserId, status])
  @@index([candidateId])
  @@map("hrm_applications")
}

/// 面试安排（忙闲取 OrgStaff 在册成员；纪要后维度评分进 HrmInterviewRating）
model HrmInterview {
  id                Int      @id @default(autoincrement())
  orgType           String   @map("org_type") @db.VarChar(16)
  orgUserId         String   @map("org_user_id") @db.VarChar(64)
  applicationId     Int      @map("application_id")
  interviewerUserId String   @map("interviewer_user_id") @db.VarChar(64)
  /// ONSITE | VIDEO | PHONE
  mode              String   @default("ONSITE") @db.VarChar(16)
  scheduledAt       DateTime @map("scheduled_at")
  durationMin       Int      @default(60) @map("duration_min")
  /// SCHEDULED | DONE | CANCELED
  status            String   @default("SCHEDULED") @db.VarChar(16)
  notes             String   @default("") @db.Text
  createdBy         String   @default("") @map("created_by") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([orgType, orgUserId, status])
  @@index([applicationId])
  @@map("hrm_interviews")
}

/// 面试维度评分（宽严校准数据源；维度口径与 rubric dimensionsJson 同源）
model HrmInterviewRating {
  id          Int      @id @default(autoincrement())
  orgType     String   @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  interviewId Int      @map("interview_id")
  raterUserId String   @map("rater_user_id") @db.VarChar(64)
  /// HARD_SKILL | SOFT | EXPERIENCE | STABILITY | CULTURE | WILL
  dimension   String   @db.VarChar(24)
  score       Decimal  @db.Decimal(2, 1)
  note        String   @default("") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([interviewId, raterUserId, dimension])
  @@map("hrm_interview_ratings")
}

/// Offer：接受后打通入转调离（职员账号→OrgStaff 建档，代理人走 StaffApplication）
model HrmOffer {
  id            Int       @id @default(autoincrement())
  orgType       String    @map("org_type") @db.VarChar(16)
  orgUserId     String    @map("org_user_id") @db.VarChar(64)
  applicationId Int       @map("application_id")
  candidateId   Int       @map("candidate_id")
  jobId         Int       @map("job_id")
  salaryMonthly Decimal   @default(0) @map("salary_monthly") @db.Decimal(18, 2)
  startAt       String    @default("") @map("start_at") @db.VarChar(16)
  /// PENDING | ACCEPTED | DECLINED | EXPIRED
  status        String    @default("PENDING") @db.VarChar(16)
  acceptedAt    DateTime? @map("accepted_at")
  /// 接受后回写：成员账号与 OrgStaff.id
  memberUserId  String    @default("") @map("member_user_id") @db.VarChar(64)
  orgStaffId    Int       @default(0) @map("org_staff_id")
  note          String    @default("") @db.VarChar(500)
  createdBy     String    @default("") @map("created_by") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([orgType, orgUserId, status])
  @@index([applicationId])
  @@map("hrm_offers")
}

/// 述职/转正评估（绩效×潜力双轴→九宫格，供 l2-insight 消费）
model HrmReview {
  id               Int      @id @default(autoincrement())
  orgType          String   @map("org_type") @db.VarChar(16)
  orgUserId        String   @map("org_user_id") @db.VarChar(64)
  staffUserId      String   @map("staff_user_id") @db.VarChar(64)
  /// 评估周期标识（如 2026H1 / 2026-PROBATION）
  period           String   @db.VarChar(32)
  /// PROBATION 转正 | YEAR 年度 | QUARTER 季度
  kind             String   @default("YEAR") @db.VarChar(16)
  performanceScore Decimal  @default(0) @map("performance_score") @db.Decimal(2, 1)
  potentialScore   Decimal  @default(0) @map("potential_score") @db.Decimal(2, 1)
  /// 九宫格位置 1~9（低绩低潜→高绩高潜），由服务按双轴换算写入
  gridCell         Int      @default(0) @map("grid_cell")
  /// OKR 证据分（0-100）与任务/KR 证据快照
  okrScore         Decimal  @default(0) @map("okr_score") @db.Decimal(5, 2)
  okrEvidence      Json     @default("{}") @map("okr_evidence")
  summary          String   @default("") @db.Text
  /// DRAFT | DONE
  status           String   @default("DRAFT") @db.VarChar(16)
  reviewerUserId   String   @default("") @map("reviewer_user_id") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, staffUserId, period, kind])
  @@map("hrm_reviews")
}

/// 人岗匹配 rubric 模板库（§12.9.1：单一实现点，两侧共读；DB 驱动版本化可回滚）
model HrmRubricTemplate {
  id           Int      @id @default(autoincrement())
  /// 模板编码（默认通用版 general）
  code         String   @db.VarChar(32)
  version      Int
  /// [{ key, label, description }] 四维：硬技能/软素质/经验层级/稳定性
  dimensions   Json     @default("[]")
  /// { HARD_SKILL:0.4, SOFT:0.15, EXPERIENCE:0.3, STABILITY:0.15 }
  weights      Json     @default("{}")
  /// { excellent:4.5, strong:4.0, medium:3.0 }（§12.9.2 分档阈值）
  thresholds   Json     @default("{}") @map("thresholds_json")
  /// 中文职级词表（classifyTier 单一函数消费）
  tierLexicon  Json     @default("[]") @map("tier_lexicon_json")
  /// prompt 文案摘要（存库不入代码，LLM 可用时渲染消费）
  promptDigest String   @default("") @map("prompt_digest") @db.Text
  active       Boolean  @default(true)
  updatedBy    String   @default("") @map("updated_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([code, active])
  @@map("hrm_rubric_templates")
}

/// 营销问卷（营销工具）：题目与分享设置在本表，回收答案写入 `data_tables`（tableId）。
/// 公开分享 `/survey/:code` 免登录；已发布且已有回收后锁定题目，避免旧行数据与题目不一致。
model MarketingSurvey {
  id            Int       @id @default(autoincrement())
  /// 公开分享码（随机 12 位），对外路径 /survey/:code
  code          String    @unique @db.VarChar(32)
  createdBy     String    @map("created_by") @db.VarChar(64)
  title         String    @db.VarChar(120)
  description   String    @default("") @db.VarChar(500)
