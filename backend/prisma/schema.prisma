  params         Json            @default("{}")
  /// PENDING | RUNNING | SUCCEEDED | PARTIAL | FAILED
  status         String          @default("PENDING") @db.VarChar(16)
  /// 企点侧异步任务ID（导入/导出/图卡结果轮询用）
  upstreamTaskId String          @default("") @map("upstream_task_id") @db.VarChar(128)
  totalRows      Int             @default(0) @map("total_rows")
  successRows    Int             @default(0) @map("success_rows")
  failedRows     Int             @default(0) @map("failed_rows")
  skippedRows    Int             @default(0) @map("skipped_rows")
  errorCode      String          @default("") @map("error_code") @db.VarChar(64)
  errorMessage   String          @default("") @map("error_message") @db.VarChar(500)
  startedAt      DateTime?       @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  events         TpTaskEvent[]

  @@index([userId, product, createdAt])
  @@index([userId, status])
  @@index([upstreamTaskId])
  @@map("tp_tasks")
}

/// 任务的过程日志：轮询到的上游状态、分批进度、失败原因，只追加不改
model TpTaskEvent {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  /// info | warn | error
  level     String   @default("info") @db.VarChar(16)
  message   String   @db.VarChar(500)
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  task      TpTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, id])
  @@map("tp_task_events")
}

/// 每个数据集（如 cdp_customer_import）在指定表上的列映射，下次执行不用重填
model TpMapping {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  datasetKey String  @map("dataset_key") @db.VarChar(64)
  tableId   Int      @map("table_id")
  tableName String   @default("") @map("table_name") @db.VarChar(191)
  columnMap Json     @default("{}") @map("column_map")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, datasetKey, tableId])
  @@map("tp_mappings")
}

/// L0 意图事件流：本站「操作/指令」的唯一记忆入口，append-only，写入收口在 AgentMemoryService.record()
model AgentMemoryEvent {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  /// 业务域：请求路径首段（enterprise/api-v1 之后），如 tax、rpa、data-tables、workbuddy
  domain       String   @db.VarChar(32)
  /// 动作名，逐字等于契约 operationId（如 DataTable_createRow、Rpa_createTasks）
  action       String   @db.VarChar(64)
  /// 操作对象类型（表/任务/计划/企业...），供回放与提炼认对象
  targetType   String   @default("") @map("target_type") @db.VarChar(32)
  targetId     String   @default("") @map("target_id") @db.VarChar(64)
  targetLabel  String   @default("") @map("target_label") @db.VarChar(200)
  /// 脱敏后的参数摘要（凭据、明文邮箱、原文一律不进这里）
  params       Json     @default("{}")
  /// ok | failed | blocked
  outcome      String   @default("ok") @db.VarChar(16)
  errorCode    String   @default("") @map("error_code") @db.VarChar(64)
  errorMessage String   @default("") @map("error_message") @db.VarChar(500)
  /// web＝浏览器；machine＝ek_ 机器身份；mcp＝MCP 客户端；scheduler＝本系统调度器
  channel      String   @default("web") @db.VarChar(16)
  /// 同一次动作写入的 audit_logs 主键（0＝这条没有对应留痕），是两套记录的锚
  auditLogId   Int      @default(0) @map("audit_log_id")
  occurredAt   DateTime @default(now()) @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, occurredAt])
  @@index([userId, action, occurredAt])
  @@index([auditLogId])
  @@map("agent_memory_events")
}

/// 夜间提炼出的待确认候选：必须带出处（sourceEventIds），没有出处的结论不进界面
model AgentMemoryCandidate {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  /// preference＝参数偏好（表单预填）；playbook＝可重复动作序列（剧本）
  kind           String    @db.VarChar(16)
  /// preference: { key, value }；playbook: { name, description, trigger, steps[] }
  payload        Json      @default("{}")
  sourceEventIds Json      @default("[]") @map("source_event_ids")
  /// 人话证据，如「近 30 天出现 7 次：批量写行 → 建潜客任务」
  evidence       String    @default("") @db.VarChar(500)
  /// candidate | adopted | rejected | expired
  status         String    @default("candidate") @db.VarChar(16)
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status, createdAt])
  @@map("agent_memory_candidates")
}

/// L1 已采纳偏好：按账号唯一，键名带业务域前缀，值只存参数默认值
model AgentPreference {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.VarChar(64)
  /// 如 rpa.task.deviceType、bigdata.resultTable、datarow.targetTable
  key            String   @db.VarChar(128)
  value          Json     @default("{}")
  sourceEventIds Json     @default("[]") @map("source_event_ids")
  /// 被表单预填命中的次数，用于排序与淘汰
  hits           Int      @default(0)
  adoptedAt      DateTime @default(now()) @map("adopted_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("agent_preferences")
}

/// L2 剧本：参数化步骤序列。steps 只有本站业务域与动作，不含任何客户端专有字段，换执行器不改剧本
model AgentPlaybook {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  name           String    @db.VarChar(200)
  description    String    @default("") @db.VarChar(500)
  /// { timeWindow, conditions }，供「什么时候该跑」判断与界面展示
  trigger        Json      @default("{}")
  /// [{ domain, action, paramsTemplate, sourceEventId }]
  steps          Json      @default("[]")
  /// self＝本系统调度器直跑；external＝交给 MCP 客户端自取；workbuddy＝投影成 Workbuddy 计划
  executor       String    @default("self") @db.VarChar(16)
  /// candidate | active | retired
  status         String    @default("candidate") @db.VarChar(16)
  runs           Int       @default(0)
  successes      Int       @default(0)
  lastRunAt      DateTime? @map("last_run_at")
  sourceEventIds Json      @default("[]") @map("source_event_ids")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("agent_playbooks")
}

/// L3 授权闸：一次一令。dry-run 预览报文 → 口令签发 → 短时效 + 默认一次性 + 只覆盖本剧本的 domain:action
model AgentGrant {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  playbookId   Int       @map("playbook_id")
  /// 允许的 domain:action 白名单数组，写请求落库前逐条比对
  scope        Json      @default("[]")
  /// 预览时的真实报文摘要（留痕：用户当时到底批了什么）
  dryRunResult Json      @default("{}") @map("dry_run_result")
  oneTime      Boolean   @default(true) @map("one_time")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  /// active | consumed | expired | revoked
  status       String    @default("active") @db.VarChar(16)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, status])
  @@index([playbookId, status])
  @@map("agent_grants")
}

/// 账号级自动执行授权：勾选过的写动作才允许 MCP 服务端无人值守执行，一行＝一个 operationId
model AgentActionGrant {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  domain    String   @db.VarChar(32)
  /// 契约层 operationId（如 DataTable_addRow）；永久排除清单里的动作不允许入库
  action    String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, action])
  @@index([userId])
  @@map("agent_action_grants")
}

/// L3 执行记录：剧本的 runs/successes 由这张表回写，界面「执行记录」也读这张表
model AgentPlaybookRun {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.VarChar(64)
  playbookId  Int       @map("playbook_id")
  grantId     Int       @default(0) @map("grant_id")
  /// self | external | workbuddy，与剧本同一枚举（记当次实际由谁执行）
  executor    String    @default("self") @db.VarChar(16)
  /// ok | failed | blocked
  outcome     String    @default("ok") @db.VarChar(16)
  /// [{ step, domain, action, ok, errorCode, errorMessage }]，错误文案已过 sanitizeErrorMessage
  stepsResult Json      @default("[]") @map("steps_result")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([userId, startedAt])
  @@index([playbookId, startedAt])
  @@map("agent_playbook_runs")
}

// ---------------------------------------------------------------------------
// 内容创作与 Agent（P0）：会话/消息/长期记忆、模型渠道与槽位、生成任务、资产台账
// 全部按登录账号（userId）归属；模型凭据列只存密文（content-crypto 的 AES-256-GCM）
// ---------------------------------------------------------------------------

/// Agent 会话：标题可改；model 为会话默认模型（空＝跟随模型设置的文本槽位）
model ContentAgentConversation {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  title      String   @default("") @db.VarChar(80)
  model      String   @default("") @db.VarChar(128)
  /// 绑定使用的公共专家（0＝无）；专家被删也不清历史会话上的名字
  expertId   Int      @default(0) @map("expert_id")
  expertName String   @default("") @map("expert_name") @db.VarChar(40)
  /// 本会话使用的数字分身（0＝自动：模型按每轮语义自选）；分身被删也不清历史会话上的名字
  personaId   Int      @default(0) @map("persona_id")
  personaName String   @default("") @map("persona_name") @db.VarChar(30)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("content_agent_conversations")
}

/// 会话消息：toolCalls 记本轮工具调用（名称/参数摘要/结果），media 记产出的媒体卡
model ContentAgentMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  userId         String   @map("user_id") @db.VarChar(64)
  /// user | assistant | tool
  role           String   @db.VarChar(16)
  content        String   @default("") @db.Text
  toolCalls      Json     @default("[]") @map("tool_calls")
  media          Json     @default("[]")
  /// 用户这一轮带的参考素材：[{label,fileName,url,media}]；只存在 user 行
  references     Json     @default("[]")
  /// ok | failed | canceled
  status         String   @default("ok") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("content_agent_messages")
}

/// 长期记忆：Agent 的 save_memory 与用户在「记忆」页写入；normalized 做去重键
model ContentAgentMemory {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  /// fact | preference | instruction
  kind       String   @default("fact") @db.VarChar(16)
  content    String   @db.Text
  normalized String   @db.VarChar(200)
  /// agent | user
  source     String   @default("agent") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, normalized])
  @@index([userId, createdAt])
  @@map("content_agent_memories")
}

/// 数字分身：一个登录账号可建多个，每个一套回复风格 + 人设；长期记忆仍按 userId 共用一套
model ContentAgentPersona {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  /// 名称：在对话与问题大厅里选中分身时显示，同账号内唯一
  name      String   @db.VarChar(30)
  /// professional | friendly | direct | imaginative | sarcastic | efficient | socratic；空＝不限定
  style     String   @default("") @db.VarChar(32)
  /// 用户自己写的人设，最多 500 字；只影响语气与表达方式
  persona   String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, id])
  @@map("content_agent_personas")
}

/// 模型渠道：aipdd 为内置（Key 取自「API Key 管理」，本表不存）；custom/mediakit 存密文
model ContentModelChannel {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  /// aipdd | custom | mediakit
  provider     String   @db.VarChar(16)
  name         String   @db.VarChar(64)
  baseUrl      String   @default("") @map("base_url") @db.VarChar(300)
  keyCipher    String   @default("") @map("key_cipher") @db.Text
  /// 火山引擎专用：豆包语音识别（openspeech）的 Key，与方舟 Key 不通用
  asrKeyCipher String   @default("") @map("asr_key_cipher") @db.Text
  /// 预设：openai / anthropic / deepseek / qwen / moonshot / zhipu / openrouter / custom
  preset       String   @default("") @db.VarChar(16)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider, name])
  @@index([userId])
  @@map("content_model_channels")
}

/// 默认模型槽位：一个账号每种类型一行；enhance 记视频增强默认档位
model ContentModelSlot {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  /// text | vision | image | video | audio | asr | music | enhance
  mediaType String   @map("media_type") @db.VarChar(16)
  channelId Int      @default(0) @map("channel_id")
  model     String   @default("") @db.VarChar(128)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, mediaType])
  @@map("content_model_slots")
}

/// 生成任务：图片/文本同步完成也落一行，视频/音乐/超分按 PENDING→RUNNING→终态推进
model ContentGenerationJob {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  tool         String    @db.VarChar(32)
  /// PENDING | RUNNING | SUCCESS | FAILED | CANCELED
  status       String    @default("PENDING") @db.VarChar(16)
  input        Json      @default("{}")
  /// 本轮用户选的模型：{ mediaType: { channelId, model } }；空＝用「模型设置」的默认槽位
  models       Json      @default("{}")
  output       Json      @default("{}")
  assetUrl     String    @default("") @map("asset_url") @db.Text
  aipddAssetId String    @default("") @map("aipdd_asset_id") @db.VarChar(64)
  error        String    @default("") @db.VarChar(500)
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("content_generation_jobs")
}

/// 资产台账：登记 AIPDD 数字资产的本地留痕（唯一真相在平台侧，这里只用来补登记与展示）
model ContentAsset {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  jobId        Int      @default(0) @map("job_id")
  /// image | video | audio | text
  kind         String   @default("image") @db.VarChar(16)
  url          String   @db.Text
  aipddAssetId String   @default("") @map("aipdd_asset_id") @db.VarChar(64)
  name         String   @default("") @db.VarChar(200)
  /// ok | failed（failed 保留 url，可重试登记）
  status       String   @default("ok") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("content_assets")
}

/// 数字资产归属台账：只记「本系统哪个账号造过/传过哪条平台资产」，展示与打标都以它圈定范围
model DigitalAssetEntry {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  aipddAssetId Int      @map("aipdd_asset_id")
  /// image | video | audio | file
  type         String   @default("file") @db.VarChar(16)
  name         String   @default("") @db.VarChar(200)
  url          String   @default("") @db.Text
  previewUrl   String   @default("") @map("preview_url") @db.Text
  /// MB（平台口径）
  fileSize     Float    @default(0) @map("file_size")
  /// 本站 OSS 对象键：非空＝字节存在自有阿里云桶（积分改造后的新底座）；空＝存于 AIPDD 的旧资产
  ossKey       String   @default("") @map("oss_key") @db.VarChar(500)
  /// 迁移来源：migrated＝已从 AIPDD 平台转存进自有桶
  migratedFrom String   @default("") @map("migrated_from") @db.VarChar(16)
  labels       Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, aipddAssetId])
  @@index([userId, updatedAt])
  @@map("digital_asset_entries")
}

/// 共享资料：把一条 AIPDD 数字资产共享给本企业的指定账号（按账号一对一，多选＝多行）
model ContentSharedAsset {
  id           Int      @id @default(autoincrement())
  /// 资料归属账号（同时是这条资产在 AIPDD 的归属账号）
  ownerUserId  String   @map("owner_user_id") @db.VarChar(64)
  assetId      String   @map("asset_id") @db.VarChar(128)
  assetName    String   @default("") @map("asset_name") @db.VarChar(200)
  assetType    String   @default("file") @map("asset_type") @db.VarChar(16)
  assetSize    Float    @default(0) @map("asset_size")
  assetUrl     String   @default("") @map("asset_url") @db.Text
  targetUserId String   @map("target_user_id") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([ownerUserId, assetId, targetUserId])
  @@index([targetUserId, createdAt])
  @@index([ownerUserId, createdAt])
  @@map("content_shared_assets")
}

/// Agent 技能：一句说明进系统提示，模型用 load_skill 取全文；按账号归属
model ContentAgentSkill {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  name        String   @db.VarChar(60)
  description String   @default("") @db.VarChar(200)
  /// SKILL.md 正文（zip 技能包读出来的主文件）
  content     String   @default("") @db.Text
  /// 技能包内的附加文本文件 [{ path, content }]，load_skill 的 file 参数用它
  files       Json     @default("[]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, enabled])
  @@map("content_agent_skills")
}

/// Agent 插件：插件包（zip）或 SkillHub 插件目录安装；说明进系统提示，模型用 load_plugin 取全文
model ContentAgentPlugin {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  name        String   @db.VarChar(60)
  description String   @default("") @db.VarChar(200)
  /// 插件说明正文（PLUGIN.md 或插件目录 README）
  content     String   @default("") @db.Text
  /// 插件包内的附加文本文件 [{ path, content }]，load_plugin 的 file 参数用它
  files       Json     @default("[]")
  /// upload＝上传插件包；skillhub＝从 SkillHub 插件目录安装
  source      String   @default("upload") @db.VarChar(16)
  /// 插件目录来源 owner/name；上传包为空串
  sourceSlug  String   @default("") @map("source_slug") @db.VarChar(120)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, enabled])
  @@map("content_agent_plugins")
}

/// 技能/插件的历史版本快照：同名覆盖前存旧内容，可查可回滚（防第三方包静默替换后无从追溯）
model ContentAgentRevision {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  /// skill＝技能包；plugin＝插件包
  kind        String   @db.VarChar(8)
  /// 被覆盖的技能/插件 id（行可能已删，只当回溯线索）
  itemId      Int      @map("item_id")
  name        String   @db.VarChar(60)
  description String   @default("") @db.VarChar(200)
  /// 覆盖前的正文
  content     String   @default("") @db.Text
  /// 覆盖前的包内文件 [{ path, content }]
  files       Json     @default("[]")
  /// 快照当时的内容来源：upload＝上传包；skillhub＝目录安装
  source      String   @default("") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, kind, itemId])
  @@map("content_agent_revisions")
}

/// Agent 的 MCP 连接器：把外部 MCP Server 的工具并入 Agent；按账号归属，请求头只存密文
model ContentAgentMcpConnector {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id") @db.VarChar(64)
  name          String    @db.VarChar(60)
  /// http＝Streamable HTTP（POST 一条 JSON-RPC）；sse＝旧版 HTTP+SSE（GET 流下发消息）
  transport     String    @default("http") @db.VarChar(8)
  url           String    @db.VarChar(500)
  /// 额外请求头 JSON 的密文（agent-mcp 上下文 AES-256-GCM）；空串＝没有额外头
  headers       String    @default("") @db.Text
  /// 请求头名字清单（明文，仅供界面展示；值只进不出）
  headerNames   Json      @default("[]") @map("header_names")
  enabled       Boolean   @default(true)
  toolCount     Int       @default(0) @map("tool_count")
  /// 最近一次探测到的工具名（供界面展示，不参与调用）
  toolNames     Json      @default("[]") @map("tool_names")
  /// 最近一次探测/调用的中文错误；空串＝正常
  lastError     String    @default("") @map("last_error") @db.VarChar(300)
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, enabled])
  @@map("content_agent_mcp_connectors")
}

/// Agent 专家：一段指令生成的公共角色（全站可用），只有创建人可删；useCount 记被启用的会话数
model ContentAgentExpert {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(40)
  /// 一句话介绍（卡片副标题）
  description String   @default("") @db.VarChar(200)
  /// 用户填写的原始指令
  instruction String   @default("") @db.Text
  /// 生成好的角色提示，注入 Agent 系统提示
  prompt      String   @default("") @db.Text
  createdBy   String   @map("created_by") @db.VarChar(64)
  creatorName String   @default("") @map("creator_name") @db.VarChar(64)
  useCount    Int      @default(0) @map("use_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([useCount, id])
  @@map("content_agent_experts")
}

/// Agent 资料库条目：把数字资产（或 Agent 产出的报告）收进来，切节点做检索；严格按账号归属
model ContentAgentLibraryItem {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  /// 来源数字资产的平台 id；纯本地回流（平台不可用）时为 0
  aipddAssetId Int      @default(0) @map("aipdd_asset_id")
  /// asset | report
  source       String   @default("asset") @db.VarChar(16)
  name         String   @default("") @db.VarChar(200)
  /// md | txt | csv | json | html | docx | pptx | xlsx | pdf
  type         String   @default("md") @db.VarChar(16)
  url          String   @default("") @db.Text
  fileSize     Float    @default(0) @map("file_size")
  /// 抽取出的全文（超长截断）；整篇改写时以它为底
  text         String   @default("") @db.Text
  charCount    Int      @default(0) @map("char_count")
  nodeCount    Int      @default(0) @map("node_count")
  /// ready | empty | failed | missing（原件在数字资产里已不存在）
  status       String   @default("ready") @db.VarChar(16)
  /// 失败/失效原因（中文，直接展示；正常时为空）
  note         String   @default("") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@index([userId, aipddAssetId])
  @@map("content_agent_library_items")
}

/// 资料节点：按 Markdown 标题 / 段落 / 表格块 / PDF 页切出的检索单元
model ContentAgentLibraryNode {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  userId    String   @map("user_id") @db.VarChar(64)
  /// section | paragraph | table | page | slide
  kind      String   @default("section") @db.VarChar(16)
  /// 标题路径（如「第一章 > 1.2 市场现状」）；整篇改写后重建
  path      String   @default("") @db.VarChar(300)
  ordinal   Int      @default(0)
  content   String   @db.Text
  chars     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId, ordinal])
  @@index([userId])
  @@map("content_agent_library_nodes")
}

/// AI 改写草稿：模型改 Markdown 先落这里，用户点「接受」才写回正文，绝不静默覆盖
model ContentAgentLibraryDraft {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.VarChar(64)
  itemId    Int       @map("item_id")
  /// 0＝整篇；否则只改这个节点
  nodeId    Int       @default(0) @map("node_id")
  nodePath  String    @default("") @map("node_path") @db.VarChar(300)
  reason    String    @default("") @db.VarChar(300)
  before    String    @default("") @db.Text
  after     String    @default("") @db.Text
  /// pending | accepted | rejected
  status    String    @default("pending") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  @@index([userId, status, createdAt])
  @@index([itemId])
  @@map("content_agent_library_drafts")
}

/// Agent 定时任务：到点把 instruction 作为一轮对话交给 Agent 跑；排期字段与 Workbuddy/RPA 同一套口径
model ContentAgentSchedule {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  /// 预设模板 id（daily_news / weekly_report / daily_report / mail_triage）；空串＝自定义任务
  preset         String    @default("") @db.VarChar(32)
  title          String    @db.VarChar(80)
  /// 每次执行时作为用户消息交给 Agent 的指令（自包含，不看历史）
  instruction    String    @default("") @db.Text
  /// 执行结果落到哪个会话；0＝首次执行时新建一个专属会话
  conversationId Int       @default(0) @map("conversation_id")
  /// 绑定的公共专家（0＝无）
  expertId       Int       @default(0) @map("expert_id")
  /// 本任务使用的数字分身（0＝自动：模型按每轮语义自选）
  personaId      Int       @default(0) @map("persona_id")
  /// 随任务固定引用的技能 id 数组；空＝全部启用中的技能
  skillIds       Json      @default("[]") @map("skill_ids")
  /// 随任务固定引用的插件 id 数组；空＝全部启用中的插件
  pluginIds      Json      @default("[]") @map("plugin_ids")
  /// 随任务固定引用的资料库条目 id 数组；空＝整库检索
  libraryIds     Json      @default("[]") @map("library_ids")
  /// 随任务固定引用的 MCP 连接器 id 数组（0＝本站 MCP Server）；空＝全部启用中的连接器
  connectorIds   Json      @default("[]") @map("connector_ids")
  /// 本次任务只处理哪些邮箱账号 id；空＝不限定（仅未引用邮件能力时成立）
  mailboxIds     Json      @default("[]") @map("mailbox_ids")
  /// 无人值守是否允许执行写动作；false＝只读取与出草案，修改类动作一律拒
  allowWrite     Boolean   @default(false) @map("allow_write")
  /// 任务固定的参考文件（图片 / 视频 / 音频）：{label,fileName,url,media}
  references     Json      @default("[]")
  /// 文本模型渠道；0＝「模型设置」里的文本槽位
  channelId      Int       @default(0) @map("channel_id")
  model          String    @default("") @db.VarChar(128)
  /// scheduled＝定时一次；recurring＝周期重复（定时任务不允许 once）
  scheduleType   String    @default("recurring") @map("schedule_type") @db.VarChar(16)
  scheduleConfig Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻；定时一次跑完即置空
  scheduledAt    DateTime? @map("scheduled_at")
  /// enabled | paused
  status         String    @default("enabled") @db.VarChar(16)
  lastRunAt      DateTime? @map("last_run_at")
  /// 最近一次执行结果：succeeded | failed | skipped；空串＝还没跑过
  lastStatus     String    @default("") @map("last_status") @db.VarChar(16)
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  runCount       Int       @default(0) @map("run_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, scheduleType, scheduledAt])
  @@map("content_agent_schedules")
}

/// 定时任务执行记录：一次调度一行；成功时链到那轮对话，界面可一键打开看结果
model ContentAgentScheduleRun {
  id             Int       @id @default(autoincrement())
  scheduleId     Int       @map("schedule_id")
  userId         String    @map("user_id") @db.VarChar(64)
  /// scheduled | manual（用户点「立即执行」）
  trigger        String    @default("scheduled") @db.VarChar(16)
  /// running | succeeded | failed
  status         String    @default("running") @db.VarChar(16)
  /// 本轮对话 id（成功后界面「查看会话」用它跳转）
  conversationId Int       @default(0) @map("conversation_id")
  /// 助手消息 id
  messageId      Int       @default(0) @map("message_id")
  /// 产出摘要（成功时取回复前 500 字）
  summary        String    @default("") @db.VarChar(500)
  /// 失败原因（中文，直接展示）
  error          String    @default("") @db.VarChar(500)
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  @@index([scheduleId, startedAt])
  @@index([userId, startedAt])
  @@map("content_agent_schedule_runs")
}

/// Agent 助理：一条第三方消息通道的接入配置；凭据整体加密，webhook_token 走公开回调定位到这一行
model ContentAgentAssistantChannel {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  /// wecom_app / wecom_bot / wecom_kf / dingtalk_robot / dingtalk_webhook / feishu_app / qq_onebot / wechat_mp
  kind         String    @db.VarChar(32)
  name         String    @db.VarChar(80)
  /// 公开回调路径里的 32 位随机串；出站型（群机器人）也生成一个，便于统一展示
  webhookToken String    @unique @map("webhook_token") @db.VarChar(32)
  /// 平台凭据与参数（JSON）的 AES-256-GCM 密文
  configCipher String    @default("") @map("config_cipher") @db.Text
  /// 执行用的文本模型渠道；0＝「模型设置」文本槽位（无人值守时取不到账号 Key，会失败）
  channelId    Int       @default(0) @map("channel_id")
  model        String    @default("") @db.VarChar(128)
  /// 允许的发送者 ID，逗号分隔；空串＝不限制
  allowedUsers String    @default("") @map("allowed_users") @db.VarChar(500)
  enabled      Boolean   @default(true)
  lastEventAt  DateTime? @map("last_event_at")
  lastError    String    @default("") @map("last_error") @db.VarChar(500)
  eventCount   Int       @default(0) @map("event_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("content_agent_assistant_channels")
}

/// 助理会话映射：一个外部聊天对应一条 Agent 会话，保证远程对话有上下文
model ContentAgentAssistantChat {
  id             Int       @id @default(autoincrement())
  channelId      Int       @map("channel_id")
  userId         String    @map("user_id") @db.VarChar(64)
  /// 外部聊天标识：企业微信 userid / 飞书 chat_id / 钉钉 conversationId / QQ 群号或 QQ 号 / 微信客服 external_userid / 公众号 openid
  externalChatId String    @map("external_chat_id") @db.VarChar(191)
  conversationId Int       @map("conversation_id")
  title          String    @default("") @db.VarChar(120)
  /// 微信客服增量拉取游标（其它渠道为空串）
  cursor         String    @default("") @db.VarChar(191)
  lastUserId     String    @default("") @map("last_user_id") @db.VarChar(191)
  lastMessageAt  DateTime? @map("last_message_at")
  messageCount   Int       @default(0) @map("message_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([channelId, externalChatId])
  @@index([userId, lastMessageAt])
  @@map("content_agent_assistant_chats")
}

/// 助理消息日志：入站一条、回出的一条各一行；外部消息 ID 唯一用于平台重推去重
model ContentAgentAssistantMessage {
  id             Int      @id @default(autoincrement())
  channelId      Int      @map("channel_id")
  userId         String   @map("user_id") @db.VarChar(64)
  externalChatId String   @map("external_chat_id") @db.VarChar(191)
  externalMsgId  String?  @map("external_msg_id") @db.VarChar(191)
  /// in | out
  direction      String   @db.VarChar(8)
  content        String   @default("") @db.Text
  /// received | running | succeeded | failed | ignored
  status         String   @default("received") @db.VarChar(16)
  error          String   @default("") @db.VarChar(500)
  conversationId Int      @default(0) @map("conversation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([channelId, externalMsgId])
  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@map("content_agent_assistant_messages")
}

/// 邮箱服务账号：一个登录账号可配多个邮箱；密码只存密文，邮件正文一律不落库
model MailAccount {
  id               Int       @id @default(autoincrement())
  userId           String    @map("user_id") @db.VarChar(64)
  address          String    @db.VarChar(160)
  displayName      String    @default("") @map("display_name") @db.VarChar(80)
  /// imap | pop3
  protocol         String    @default("imap") @db.VarChar(8)
  incomingHost     String    @map("incoming_host") @db.VarChar(160)
  incomingPort     Int       @map("incoming_port")
  /// ssl | starttls | none
  incomingSecurity String    @default("ssl") @map("incoming_security") @db.VarChar(10)
  incomingUsername String    @map("incoming_username") @db.VarChar(160)
  /// 收信密码/授权码密文（mailbox 上下文 AES-256-GCM）
  incomingSecret   String    @map("incoming_secret") @db.VarChar(1000)
  inboxFolder      String    @default("INBOX") @map("inbox_folder") @db.VarChar(80)
  draftsFolder     String    @default("Drafts") @map("drafts_folder") @db.VarChar(80)
  /// IMAP 发件箱：发出的回复留一份副本；POP3 无文件夹，忽略
  sentFolder       String    @default("Sent") @map("sent_folder") @db.VarChar(80)
  outgoingHost     String    @default("") @map("outgoing_host") @db.VarChar(160)
  outgoingPort     Int       @default(465) @map("outgoing_port")
  outgoingSecurity String    @default("ssl") @map("outgoing_security") @db.VarChar(10)
  outgoingUsername String    @default("") @map("outgoing_username") @db.VarChar(160)
  /// 发信密码密文；空串＝复用收信密码
  outgoingSecret   String    @default("") @map("outgoing_secret") @db.VarChar(1000)
  signature        String    @default("") @db.Text
  /// draft_only＝只写草稿；auto_send＝写好草稿并自动发出
  replyMode        String    @default("draft_only") @map("reply_mode") @db.VarChar(16)
  maxPerRun        Int       @default(10) @map("max_per_run")
  enabled          Boolean   @default(true)
  /// 随邮箱固定引用的资料库条目 id 数组；空＝整库检索
  libraryIds       Json      @default("[]") @map("library_ids")
  lastRunAt        DateTime? @map("last_run_at")
  lastError        String    @default("") @map("last_error") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([userId, address])
  @@index([userId, enabled])
  @@map("mail_accounts")
}

/// 邮箱场景话术：关键词/发件人命中时随 Agent 上下文注入，与技能、资料同为不可信资料
model MailScript {
  id            Int      @id @default(autoincrement())
  /// 兼容旧数据：旧话术归属的邮箱（新话术为 0）
  mailboxId     Int      @default(0) @map("mailbox_id")
  /// 生效邮箱（可多选；空数组＝全部邮箱）
  mailboxIds    Json     @default("[]") @map("mailbox_ids")
  userId        String   @map("user_id") @db.VarChar(64)
  name          String   @db.VarChar(80)
  /// 触发关键词，逗号分隔；空串＝不按关键词过滤
  keywords      String   @default("") @db.VarChar(300)
  /// 发件人匹配（子串）；空串＝不限
  senderPattern String   @default("") @map("sender_pattern") @db.VarChar(160)
  /// 同一封邮件命中多条时取数值小的
  priority      Int      @default(100)
  content       String   @db.Text
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([mailboxId, enabled, priority])
  @@map("mail_scripts")
}

/// 处理台账（最小化）：只记去重键、发件人与结果，不存主题、正文、附件
model MailHandleLog {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  mailboxId   Int      @map("mailbox_id")
  /// 去重键：优先 Message-ID，缺失时用 UID/UIDL 派生的稳定串
  messageKey  String   @map("message_key") @db.VarChar(255)
  fromAddress String   @default("") @map("from_address") @db.VarChar(160)
  /// draft | sent | skipped
  result      String   @db.VarChar(16)
  /// 跳过原因或失败原因；空串＝正常
  reason      String   @default("") @db.VarChar(300)
  /// 处理日（Asia/Shanghai 当天零点），统计按它聚合
  handledOn   DateTime @map("handled_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([mailboxId, messageKey])
  @@index([userId, handledOn])
  @@index([mailboxId, fromAddress, handledOn])
  @@map("mail_handle_logs")
}

// ---------------------------------------------------------------- 统一组织成员 / 通知 / AI客服 / 活码（2026-10-30）

/// 统一组织成员：企业与服务商共用同一套关系（服务商旧表 provider_staff 在 dual 模式保持读写并镜像到本表）
model OrgStaff {
  id           Int       @id @default(autoincrement())
  /// ENTERPRISE | PROVIDER
  orgType      String    @map("org_type") @db.VarChar(16)
  orgUserId    String    @map("org_user_id") @db.VarChar(64)
  memberUserId String    @map("member_user_id") @db.VarChar(64)
  /// STAFF 职员 | AGENT 代理人
  memberKind   String    @default("STAFF") @map("member_kind") @db.VarChar(16)
  /// 角色：服务商沿用服务类目；企业用业务板块/岗位编码
  roles        Json      @default("[]")
  department   String    @default("") @db.VarChar(64)
  /// 岗位列表：[{ name, description }]，一人多岗；由本组织赋予
  positions    Json      @default("[]")
  /// 能力说明（本组织内一份，由本组织赋予）
  capabilities String    @default("") @db.Text
  /// 代理人的指派范围（业务模块/类目）；职员为空＝全量
  scope        Json      @default("[]")
  /// PENDING | ACTIVE | REMOVED
  status       String    @default("ACTIVE") @db.VarChar(16)
  invitedBy    String    @default("") @map("invited_by") @db.VarChar(64)
  confirmedAt  DateTime? @map("confirmed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, memberUserId])
  @@index([orgType, orgUserId, status])
  @@index([memberUserId, status])
  @@map("org_staff")
}

/// 组织职能目录：部门。OA 流程可按「部门 + 岗位」选签批人。
model OrgDepartment {
  id          Int      @id @default(autoincrement())
  orgType     String   @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  name        String   @db.VarChar(64)
  description String   @default("") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, name])
  @@index([orgType, orgUserId])
  @@map("org_departments")
}

