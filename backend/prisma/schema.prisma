  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, name])
  @@index([orgType, orgUserId])
  @@map("org_departments")
}

/// 组织职能目录：岗位（含岗位说明）。一人可多岗，赋给成员时再落到 org_staff。
