  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, name])
  @@index([orgType, orgUserId])
  @@map("org_positions")
}

/// 组织成员邀请 / 申请（企业只开放 INVITE：邀请 → 本人确认）
