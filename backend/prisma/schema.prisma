/// 智能硬件·用户接入的实体设备：令牌只存哈希、明文只在生成时显示一次
model HwDevice {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id") @db.VarChar(64)
  modelId         Int       @map("model_id")
  name            String    @db.VarChar(80)
  serialNo        String    @default("") @map("serial_no") @db.VarChar(80)
  /// 设备令牌 SHA-256（hw_ 前缀明文只存这一处哈希）
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  /// 令牌前 8 位，仅供界面识别
  tokenPrefix     String    @map("token_prefix") @db.VarChar(16)
  /// ONLINE | OFFLINE | NEVER
  status          String    @default("NEVER") @db.VarChar(8)
  lastSeenAt      DateTime? @map("last_seen_at")
  lastIp          String    @default("") @map("last_ip") @db.VarChar(64)
  firmwareVersion String    @default("") @map("firmware_version") @db.VarChar(40)
  /// 设备自报的指标 / 元信息
  meta            Json      @default("{}")
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId, modelId])
  @@index([status, lastSeenAt])
  @@map("hw_devices")
}

/// 智能硬件·设备事件流水（心跳 / 指令 / 回执 / 状态变更，供排障）
model HwDeviceEvent {
  id          Int      @id @default(autoincrement())
  deviceId    Int      @map("device_id")
  /// HEARTBEAT | COMMAND | RESULT | STATUS
  kind        String   @db.VarChar(12)
  /// IN | OUT
  direction   String   @db.VarChar(4)
  commandCode String   @default("") @map("command_code") @db.VarChar(64)
  payload     Json     @default("{}") @map("payload_json")
  ok          Boolean  @default(true)
  latencyMs   Int      @default(0) @map("latency_ms")
  message     String   @default("") @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([deviceId, createdAt])
  @@map("hw_device_events")
}

/// 智能硬件·工具定义（API 与 MCP 共用一张表，kind 区分；默认工具 scope=DEFAULT，用户自建 scope=USER）
model HwTool {
  id            Int      @id @default(autoincrement())
  modelId       Int      @map("model_id")
  /// API | MCP
  kind          String   @db.VarChar(8)
  /// DEFAULT＝型号默认（管理员维护）；USER＝用户自建（仅本人可见）
  scope         String   @default("DEFAULT") @db.VarChar(8)
  ownerUserId   String   @default("") @map("owner_user_id") @db.VarChar(64)
  code          String   @db.VarChar(64)
  name          String   @db.VarChar(80)
  description   String   @default("") @db.VarChar(500)
  /// HTTP＝平台代调设备 HTTP；DEVICE＝平台下发指令、设备拉取回执
  transport     String   @default("DEVICE") @db.VarChar(8)
  method        String   @default("POST") @db.VarChar(8)
  path          String   @default("") @db.VarChar(300)
  commandCode   String   @default("") @map("command_code") @db.VarChar(64)
  /// 参数 JSON Schema（API 参数表与 MCP inputSchema 同源）
  params        Json     @default("{}") @map("params_json")
  response      Json     @default("{}") @map("response_json")
  examples      Json     @default("[]") @map("examples_json")
  write         Boolean  @default(false)
  requiresGrant Boolean  @default(true) @map("requires_grant")
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdBy     String   @default("") @map("created_by") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([modelId, kind, scope, ownerUserId, code])
  @@index([modelId, kind, enabled])
  @@index([ownerUserId])
  @@map("hw_tools")
}

/// 智能硬件·用户对写类工具的自动执行授权（对齐平台 MCP 的三层授权口径）
model HwToolGrant {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  toolId    Int      @map("tool_id")
  grantedAt DateTime @default(now()) @map("granted_at")

  @@unique([userId, toolId])
  @@index([userId])
  @@map("hw_tool_grants")
}

/// 官方服务套餐目录：平台按业务板块上架，企业用积分采购；
/// 套餐由平台整合多家优质服务商完成交付（采购后平台主持企业与服务商签约兑现）。
model ServicePackage {
  id                 Int      @id @default(autoincrement())
  /// 板块码（SERVICE_TYPES 12 选 1，板块级归属）
  serviceType        String   @map("service_type") @db.VarChar(32)
  name               String   @db.VarChar(120)
  description        String   @default("") @db.VarChar(500)
  /// 人民币价（整数分，与充值同口径）；积分价按官方汇率实时换算、购买时快照
  priceCents         Int      @map("price_cents")
  /// 计价单位文案（年/次/月）
  unit               String   @default("年") @db.VarChar(16)
  /// 包含服务清单：string[]（对应财税 13 项）
  features           Json     @default("[]")
  /// 交付项：[{ code, label, providerUserId?, providerOrg? }]，code 为板块类目或其细项
  deliveryItems      Json     @default("[]") @map("delivery_items")
  /// 交付说明（补充「本套餐由平台整合优质服务商完成交付」固定声明）
  deliveryDesc       String   @default("") @map("delivery_desc") @db.VarChar(500)
  /// 购买后自动发起签约（需交付项预绑优质服务商）；失败明细回落待匹配，不阻断购买
  autoInitiate       Boolean  @default(false) @map("auto_initiate")
  /// 仅财税：SMALL/GENERAL，用于「您的适用档」按企业纳税人性质匹配
  taxpayerType       String?  @map("taxpayer_type") @db.VarChar(16)
  /// 每企业限购（按采购时的企业档案计数，跨账号共享），0=不限
  perEnterpriseLimit Int      @default(0) @map("per_enterprise_limit")
  /// ACTIVE | DISABLED
  status             String   @default("ACTIVE") @db.VarChar(16)
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([serviceType, status, sortOrder])
  @@map("service_packages")
}

/// 服务套餐采购订单：积分直购即 PAID；汇率与积分价购买时快照，永不追溯。
/// 交付状态机 PENDING_MATCH→SIGNING→DELIVERED（展示为「已签约」）；整单退款置 CLOSED。
/// 套餐只做一次性签约交付，不参与周期/到期管理；unit 仅作价格展示。
model ServicePackageOrder {
  id                   Int      @id @default(autoincrement())
  orderNo              String   @unique @map("order_no") @db.VarChar(32)
  userId               String   @map("user_id") @db.VarChar(64)
  /// 购买时取企业档案（个人主体按现有规则拦财税/出海交付项）
  enterpriseId         Int      @map("enterprise_id")
  packageId            Int      @map("package_id")
  /// 快照：套餐名 / 板块 / 人民币价（分）
  packageName          String   @map("package_name") @db.VarChar(120)
  serviceType          String   @map("service_type") @db.VarChar(32)
  priceCents           Int      @map("price_cents")
  /// 购买时官方汇率快照（1 元 = N 积分）
  rateAmount           Decimal  @map("rate_amount") @db.Decimal(18, 4)
  /// 实扣积分快照
  pointsAmount         Decimal  @map("points_amount") @db.Decimal(18, 4)
  /// 累计已退积分（部分退可多次；达到 pointsAmount 即整单退完）
  refundedPointsAmount Decimal  @default(0) @map("refunded_points_amount") @db.Decimal(18, 4)
  /// 积分流水引用（point_transactions.id）
  txId                 Int      @default(0) @map("tx_id")
  /// PAID | PARTIAL_REFUNDED | REFUNDED
  status               String   @default("PAID") @db.VarChar(16)
  /// PENDING_MATCH | SIGNING | DELIVERED | CLOSED
  fulfillmentStatus    String   @default("PENDING_MATCH") @map("fulfillment_status") @db.VarChar(16)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([enterpriseId, packageId])
  @@index([fulfillmentStatus])
  @@map("service_package_orders")
}

/// 套餐交付明细：一项一服务商；明细状态实时读关联 Contract.status（避免双写不一致）。
/// 未发起=待匹配/待发起；PENDING=签约待确认；ACTIVE=已生效；TERMINATED=已撤销/否决。
model ServicePackageOrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  /// 交付项类目/细项码
  code           String   @db.VarChar(32)
  label          String   @default("") @db.VarChar(120)
  /// 匹配/预绑的服务商
  providerUserId String   @default("") @map("provider_user_id") @db.VarChar(64)
  providerOrg    String   @default("") @map("provider_org") @db.VarChar(200)
  /// 发起签约后回填，0=未发起
  contractId     Int      @default(0) @map("contract_id")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([contractId])
  @@map("service_package_order_items")
}

/// 套餐退款记录：每次部分/整单退款一条，金额与积分流水一一对应，供对账与展示。
model ServicePackageRefund {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  amount         Decimal  @db.Decimal(18, 4)
  /// 本次退款后订单是否已退完（整单退）
  fullRefund     Boolean  @default(false) @map("full_refund")
  /// 对应 point_transactions.id
  txId           Int      @default(0) @map("tx_id")
  operatorUserId String   @map("operator_user_id") @db.VarChar(64)
  remark         String   @default("") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("service_package_refunds")
}

/// 统一任务中心：任意板块 @ 到某账号的一件待办。写入口收口在 TaskCenterService。
model MyTask {
  id                Int       @id @default(autoincrement())
  /// 账号级，跨角色（服务商 / 职员 / 企业 / 平台）
  assigneeUserId    String    @map("assignee_user_id") @db.VarChar(64)
  /// 源 key：oa | okr | pj | crm | desk | contract | platform | workflow ...
  source            String    @db.VarChar(32)
  sourceId          String    @default("") @map("source_id") @db.VarChar(64)
  /// 去重锚：source + source_id + assignee，防重复派发
  dedupKey          String    @unique @map("dedup_key") @db.VarChar(191)
  /// approval | report | task | matter | audit
  category          String    @default("matter") @db.VarChar(16)
  title             String    @db.VarChar(200)
  description       String    @default("") @db.Text
  /// 去处理的 URL
  link              String    @default("") @db.VarChar(500)
  priority          String    @default("NORMAL") @db.VarChar(16)
  /// 中心状态机：OPEN → DOING → DONE / CANCELED / EXPIRED
  status            String    @default("OPEN") @db.VarChar(16)
  /// 业务方权威状态（只展示、由源回写）
  sourceStatus      String    @default("") @map("source_status") @db.VarChar(32)
  sourceStatusLabel String    @default("") @map("source_status_label") @db.VarChar(40)
  /// 上下文主体（可选）：该任务归属的组织/企业；空表示纯账号级任务
  orgType           String    @default("") @map("org_type") @db.VarChar(16)
  orgUserId         String    @default("") @map("org_user_id") @db.VarChar(64)
  /// USER 派到具体账号 | ORG 落在机构队列等负责人转发
  assigneeType      String    @default("USER") @map("assignee_type") @db.VarChar(8)
  /// 派单人（自动分配时写 system）
  assignedBy        String    @default("") @map("assigned_by") @db.VarChar(64)
  assignedAt        DateTime? @map("assigned_at")
  /// DIRECT | ROUND_ROBIN | LOAD —— 这条任务最终是怎么落到现状的
  assignPolicy      String    @default("DIRECT") @map("assign_policy") @db.VarChar(16)
  /// 机构/个人接手时间
  acceptedAt        DateTime? @map("accepted_at")
  createdBy         String    @default("") @map("created_by") @db.VarChar(64)
  dueAt             DateTime? @map("due_at")
  closedAt          DateTime? @map("closed_at")
  closedBy          String    @default("") @map("closed_by") @db.VarChar(64)
  closeNote         String    @default("") @map("close_note") @db.VarChar(500)
  /// 表单节点定义：{ title, fields: [{ key, label, required }] }；普通任务为空
  formSchema        Json?     @map("form_schema")
  /// 表单填写结果：{ [fieldKey]: string }；提交即关闭任务
  formData          Json?     @map("form_data")
  lastSyncedAt      DateTime? @map("last_synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([assigneeUserId, status, createdAt])
  @@index([assigneeUserId, category, status])
  @@index([assigneeUserId, source, status])
  @@index([assigneeType, orgType, orgUserId, status])
  @@map("my_tasks")
}

/// 派单规则：按板块/类目/地域把服务商任务落到具体账号或轮询池。
model TaskAssignmentRule {
  id        Int      @id @default(autoincrement())
  orgType   String   @map("org_type") @db.VarChar(16)
  orgUserId String   @map("org_user_id") @db.VarChar(64)
  /// 任务源，* 表示通配
  source    String   @db.VarChar(32)
  /// 任务类目，* 表示通配
  category  String   @db.VarChar(16)
  region    String   @default("") @db.VarChar(32)
  /// DIRECT | ROUND_ROBIN | LOAD
  strategy  String   @db.VarChar(16)
  /// DIRECT 时的目标账号；轮询/负载时为目标职员池（JSON 数组）
  targets   Json
  priority  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgType, orgUserId, enabled, priority])
  @@map("task_assignment_rules")
}

/// 改派留痕：只追加不覆盖（任务当前承办人看 MyTask，历史看这里）。
model TaskAssignmentLog {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  fromUserId String   @default("") @map("from_user_id") @db.VarChar(64)
  toUserId   String   @map("to_user_id") @db.VarChar(64)
  strategy   String   @db.VarChar(16)
  note       String   @default("") @db.VarChar(500)
  actorId    String   @map("actor_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_assignment_logs")
}

/// 通用「用户界面偏好」：账号级、跨设备。本轮只承载 dashboard.shortcuts。
model UserPreference {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  key       String   @db.VarChar(64)
  value     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("user_preferences")
}

/// 工作流：一张有向图（节点 + 连线）+ 输入/输出契约；有版本。
model Workflow {
  id           Int      @id @default(autoincrement())
  ownerUserId  String   @map("owner_user_id") @db.VarChar(64)
  orgType      String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId    String   @default("") @map("org_user_id") @db.VarChar(64)
  name         String   @db.VarChar(120)
  description  String   @default("") @db.VarChar(500)
  /// 稳定别名：业务代码按它 invoke（不依赖自增 id）；发布时未填自动补 wf.<id>
  businessKey  String?  @unique @map("business_key") @db.VarChar(80)
  /// PRIVATE | ORG | PROVIDER
  scope        String   @default("PRIVATE") @db.VarChar(16)
  /// DRAFT | PUBLISHED | ARCHIVED
  status       String   @default("DRAFT") @db.VarChar(16)
  version      Int      @default(1)
  /// { nodes:[...], edges:[...] }
  graph        Json     @default("{}")
  /// 执行预算（§7.3-9）：{ maxAiCalls, maxTokens, maxToolCalls, maxBrowserActions, maxNodes }，0＝不限
  budgets      Json     @default("{}")
  /// 输入/输出契约（run 时的入参与返回值）
  inputSchema  Json     @default("{}") @map("input_schema")
  outputSchema Json     @default("{}") @map("output_schema")
  createdBy    String   @default("") @map("created_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@index([orgType, orgUserId, scope, status])
  @@map("workflows")
}

/// 发布时的图快照：改图不影响在途/已发布的运行。
model WorkflowVersion {
  id          Int      @id @default(autoincrement())
  workflowId  Int      @map("workflow_id")
  version     Int
  graph       Json     @default("{}")
  inputSchema Json     @default("{}") @map("input_schema")
  publishedBy String   @default("") @map("published_by") @db.VarChar(64)
  publishedAt DateTime @default(now()) @map("published_at")

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model WorkflowRun {
  id         Int       @id @default(autoincrement())
  workflowId Int       @map("workflow_id")
  version    Int       @default(1)
  /// MANUAL | SCHEDULE | EVENT | TASK | AGENT | MCP（外部 Webhook 触发不开放）
  trigger    String    @default("MANUAL") @db.VarChar(16)
  /// PENDING | RUNNING | WAITING | DONE | FAILED | CANCELED
  status     String    @default("PENDING") @db.VarChar(16)
  input      Json      @default("{}")
  output     Json      @default("{}")
  actorId    String    @default("") @map("actor_id") @db.VarChar(64)
  error      String    @default("") @db.VarChar(500)
  /// 业务关联：单据类型 + 主键，供单据页反查「由工作流 #N 驱动」
  sourceType String    @default("") @map("source_type") @db.VarChar(32)
  sourceId   String    @default("") @map("source_id") @db.VarChar(64)
  /// 触发幂等锚：定时=(workflowId,计划时间点)、事件=eventLogId、任务=(taskId,事件类型)
  dedupeKey  String?   @unique @map("dedupe_key") @db.VarChar(191)
  /// 本次运行生效的执行预算（§7.3-9）：发布时快照，运行中途改图不影响在途运行
  budgets    Json      @default("{}")
  /// 已耗用量：{ nodes, aiCalls, tokenIn, tokenOut, toolCalls, browserActions }
  usage      Json      @default("{}")
  /// 触顶的预算项（NONE 未触顶 / AI_CALLS / TOKENS / TOOL_CALLS / BROWSER_ACTIONS / LOOP_LIMIT）
  budgetStop String   @default("NONE") @map("budget_stop") @db.VarChar(16)
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([workflowId, status, createdAt])
  @@index([sourceType, sourceId])
  @@map("workflow_runs")
}

model WorkflowRunStep {
  id         Int       @id @default(autoincrement())
  runId      Int       @map("run_id")
  nodeId     String    @map("node_id") @db.VarChar(64)
  nodeType   String    @map("node_type") @db.VarChar(32)
  /// PENDING | RUNNING | DONE | FAILED | SKIPPED | WAITING
  status     String    @default("PENDING") @db.VarChar(16)
  input      Json      @default("{}")
  output     Json      @default("{}")
  error      String    @default("") @db.VarChar(500)
  attempts   Int       @default(0)
  durationMs Int       @default(0) @map("duration_ms")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([runId, status])
  @@map("workflow_run_steps")
}

/// 平台升级包：GitHub Release / 源码包 / 管理员上传，解压到 update/sources 后再参与分析。
model PlatformUpgradePackage {
  id            Int      @id @default(autoincrement())
  /// GITHUB_RELEASE | GITHUB_SOURCE | UPLOAD
  source        String   @db.VarChar(24)
  /// DOWNLOADING | VERIFIED | EXTRACTED | INVALID
  status        String   @default("VERIFIED") @db.VarChar(16)
  version       String   @default("") @db.VarChar(64)
  tag           String   @default("") @db.VarChar(64)
  fileName      String   @map("file_name") @db.VarChar(255)
  path          String   @db.VarChar(500)
  candidateDir  String   @default("") @map("candidate_dir") @db.VarChar(500)
  bytes         Int      @default(0)
  sha256        String   @default("") @db.VarChar(64)
  releaseNotes  String   @default("") @map("release_notes") @db.Text
  publishedAt   String   @default("") @map("published_at") @db.VarChar(64)
  extracted     Boolean  @default(false)
  invalidReason String   @default("") @map("invalid_reason") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("platform_upgrade_packages")
}

/// 平台升级任务：ANALYSIS 只分析；UPGRADE/RESTORE/CODE_EDIT 由独立 runner 执行并回写状态。
model PlatformUpgradeJob {
  id          Int       @id @default(autoincrement())
  /// ANALYSIS | UPGRADE | RESTORE | CODE_EDIT
  type        String    @db.VarChar(16)
  /// PENDING | RUNNING | SUCCESS | FAILED | CANCELLED | INTERRUPTED | ROLLED_BACK
  status      String    @default("PENDING") @db.VarChar(16)
  /// 来源：UPGRADE 升级包 / RESTORE 还原 / CODE_EDIT AI 编程改码；refId 为 AI 编程会话 id
  sourceKind  String    @default("UPGRADE") @map("source_kind") @db.VarChar(16)
  sourceRefId Int?      @map("source_ref_id")
  packageId   Int       @default(0) @map("package_id")
  backupId    Int       @default(0) @map("backup_id")
  fromVersion String    @default("") @map("from_version") @db.VarChar(64)
  toVersion   String    @default("") @map("to_version") @db.VarChar(64)
  currentStep String    @default("") @map("current_step") @db.VarChar(40)
  progress    Int       @default(0)
  error       String    @default("") @db.VarChar(1000)
  optionsJson String?   @map("options_json") @db.Text
  adviceJson  String?   @map("advice_json") @db.Text
  operatorId  String    @default("") @map("operator_id") @db.VarChar(64)
  jobDir      String    @default("") @map("job_dir") @db.VarChar(500)
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([type, status, createdAt])
  @@map("platform_upgrade_jobs")
}

model PlatformUpgradeStep {
  id         Int       @id @default(autoincrement())
  jobId      Int       @map("job_id")
  stepKey    String    @map("step_key") @db.VarChar(40)
  label      String    @db.VarChar(80)
  /// PENDING | RUNNING | SUCCESS | FAILED | SKIPPED
  status     String    @default("PENDING") @db.VarChar(16)
  message    String    @default("") @db.VarChar(1000)
  sortOrder  Int       @default(0) @map("sort_order")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([jobId, sortOrder])
  @@map("platform_upgrade_steps")
}

/// 升级备份：数据库导出 + 代码归档共用一张表；文件路径只在后台可见。
model PlatformBackup {
  id           Int      @id @default(autoincrement())
  jobId        Int      @map("job_id")
  /// DATABASE | CODE
  kind         String   @db.VarChar(16)
  version      String   @default("") @db.VarChar(64)
  dialect      String   @default("mysql") @db.VarChar(16)
  fileName     String   @map("file_name") @db.VarChar(255)
  filePath     String   @map("file_path") @db.VarChar(500)
  manifestPath String   @map("manifest_path") @db.VarChar(500)
  bytes        Int      @default(0)
  sha256       String   @default("") @db.VarChar(64)
  verified     Boolean  @default(false)
  locked       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("platform_backups")
}

/// AI 编程会话：模型只写 update/ai-code/<id>/ 暂存区，管理员审阅差异后才可应用。
/// 应用时新建 CODE_EDIT 类型升级任务，备份 / 构建 / 重启 / 回滚复用平台升级执行器。
model AiCodeSession {
  id          Int      @id @default(autoincrement())
  /// 操作人（平台管理员账号 id）
  ownerId     String   @map("owner_id") @db.VarChar(64)
  title       String   @default("") @db.VarChar(120)
  model       String   @default("") @db.VarChar(200)
  /// ACTIVE | APPLIED | ARCHIVED
  status      String   @default("ACTIVE") @db.VarChar(16)
  stagingDir  String   @default("") @map("staging_dir") @db.VarChar(500)
  /// 最近一次「备份并执行」产生的升级任务 id
  jobId       Int?     @map("job_id")
  lastMessage String   @default("") @map("last_message") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
  @@map("ai_code_sessions")
}

/// AI 编程对话消息：references（上传的参考图 / 文件）与 toolCalls（代码工具留痕）以 JSON 文本存。
model AiCodeMessage {
  id             Int      @id @default(autoincrement())
  sessionId      Int      @map("session_id")
  /// user | assistant | system
  role           String   @db.VarChar(16)
  content        String   @db.LongText
  model          String   @default("") @db.VarChar(200)
  referencesJson String?  @map("references_json") @db.Text
  toolCallsJson  String?  @map("tool_calls_json") @db.LongText
  /// STREAMING | DONE | ERROR
  status         String   @default("DONE") @db.VarChar(16)
  error          String   @default("") @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([sessionId, id])
  @@map("ai_code_messages")
}

/// AI 编程变更：暂存区里每个文件一条，存 unified diff 与审阅状态。
model AiCodeEdit {
  id           Int      @id @default(autoincrement())
  sessionId    Int      @map("session_id")
  path         String   @db.VarChar(400)
  /// added | modified | deleted
  changeType   String   @map("change_type") @db.VarChar(16)
  oldSha       String   @default("") @map("old_sha") @db.VarChar(64)
  newSha       String   @default("") @map("new_sha") @db.VarChar(64)
  bytes        Int      @default(0)
  diff         String?  @db.LongText
  /// pending | approved | rejected | applied
  status       String   @default("pending") @db.VarChar(16)
  appliedJobId Int?     @map("applied_job_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, path])
  @@index([sessionId, status])
  @@map("ai_code_edits")
}

/// 平台微信服务号绑定：一个站内账号至多绑定一个服务号 openId。
/// 关注状态、取关时间与 48 小时会话窗口是服务号独有语义，故不复用 AccountBinding。
model WechatMpBinding {
  id                Int       @id @default(autoincrement())
  userId            String    @unique @map("user_id") @db.VarChar(64)
  openId            String    @unique @map("open_id") @db.VarChar(64)
  unionId           String?   @map("union_id") @db.VarChar(64)
  nickname          String    @default("") @db.VarChar(120)
  avatarUrl         String    @default("") @map("avatar_url") @db.VarChar(500)
  subscribed        Boolean   @default(true)
  subscribedAt      DateTime? @map("subscribed_at")
  unsubscribedAt    DateTime? @map("unsubscribed_at")
  /// 用户回复「退订」后关闭微信推送，但保留绑定关系。
  pushMuted         Boolean   @default(false) @map("push_muted")
  /// 最近一次互动（关注/发消息/点菜单），用于 48 小时客服消息窗口判定。
  lastInteractionAt DateTime? @map("last_interaction_at")
  /// qrcode | admin | oauth
  source            String    @default("qrcode") @db.VarChar(24)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([unionId])
  @@index([subscribed, updatedAt])
  @@map("wechat_mp_bindings")
}

/// 一次性绑定场景值：带参二维码扫码后反查 userId。
model WechatMpBindScene {
  id        Int       @id @default(autoincrement())
  scene     String    @unique @db.VarChar(64)
  userId    String    @map("user_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("wechat_mp_bind_scenes")
}

/// 微信推送记录：每次模板/客服消息尝试都落一条，便于排查、限频与重试。
model WechatMpMessage {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id") @db.VarChar(64)
  openId     String    @map("open_id") @db.VarChar(64)
  /// template | custom
  kind       String    @db.VarChar(16)
  eventKey   String    @default("") @map("event_key") @db.VarChar(48)
  templateId String    @default("") @map("template_id") @db.VarChar(64)
  title      String    @default("") @db.VarChar(200)
  content    String    @default("") @db.Text
  link       String    @default("") @db.VarChar(500)
  /// 重试所需的原始模板数据（JSON 文本），仅 template 使用。
  payload    String    @default("") @db.Text
  /// pending | sent | failed | skipped
  status     String    @default("pending") @db.VarChar(16)
  errcode    Int?
  errmsg     String    @default("") @db.VarChar(300)
  attempts   Int       @default(0)
  msgId      String    @default("") @map("msg_id") @db.VarChar(64)
  entityType String    @default("") @map("entity_type") @db.VarChar(32)
  entityId   String    @default("") @map("entity_id") @db.VarChar(64)
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([eventKey, createdAt])
  @@map("wechat_mp_messages")
}

/// 回调幂等：微信会重试，同一 MsgId 只处理一次。
model WechatMpInboundEvent {
  id        Int      @id @default(autoincrement())
  msgId     String   @unique @map("msg_id") @db.VarChar(96)
  openId    String   @map("open_id") @db.VarChar(64)
  msgType   String   @default("") @map("msg_type") @db.VarChar(24)
  event     String   @default("") @db.VarChar(32)
  eventKey  String   @default("") @map("event_key") @db.VarChar(64)
  payload   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([openId, createdAt])
  @@map("wechat_mp_inbound_events")
}
