// ---------------------------------------------------------------------------
// 问题大厅（工作台）：企业内问题按组织+签约链路可见，公开问题对所有登录账号可见；
// 结案＝AI 对全部楼层出总结（可反复），关闭＝下架，删除＝发布者与管理员（软删）
// ---------------------------------------------------------------------------

/// 问题：scope 决定可见范围，status 与 deletedAt 分离（结案 / 关闭 / 删除是三个动作）
model QuestionHallQuestion {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(200)
  body            String    @db.Text
  /// ENTERPRISE（企业内） | PUBLIC（公开）
  scope           String    @db.VarChar(16)
  /// OPEN（进行中） | RESOLVED（已结案） | CLOSED（已关闭）
  status          String    @default("OPEN") @db.VarChar(16)
  /// 发布时所属组织：ENTERPRISE | PROVIDER；orgUserId 为该组织账号（无组织时＝自己）
  orgKind         String    @default("ENTERPRISE") @map("org_kind") @db.VarChar(16)
  orgUserId       String    @default("") @map("org_user_id") @db.VarChar(64)
  authorUserId    String    @map("author_user_id") @db.VarChar(64)
  /// 发布人昵称快照（公开问题不展示组织名，也不展示身份类型）
  authorName      String    @map("author_name") @db.VarChar(60)
  replyCount      Int       @default(0) @map("reply_count")
  lastReplyAt     DateTime  @default(now()) @map("last_reply_at")
  resolvedAt      DateTime? @map("resolved_at")
  /// 最新一次结案的总结 id（0＝还没结案 / 总结没生成成功）
  latestSummaryId Int       @default(0) @map("latest_summary_id")
  closedAt        DateTime? @map("closed_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([scope, status, lastReplyAt])
  @@index([orgKind, orgUserId, status])
  @@index([authorUserId, status])
  @@map("question_hall_questions")
}

/// 楼层：parentId＝0 为顶层回复，>0 为「回复的回复」（只做两层）
model QuestionHallMessage {
  id           Int       @id @default(autoincrement())
  questionId   Int       @map("question_id")
  parentId     Int       @default(0) @map("parent_id")
  body         String    @db.Text
  /// PERSON（真实个人） | AVATAR（数字分身，仅署名与口吻，内容由本人写）
  authorKind   String    @default("PERSON") @map("author_kind") @db.VarChar(8)
  personaId    Int       @default(0) @map("persona_id")
  /// 昵称；用分身时形如「昵称 · 分身名」。改名/删分身不影响历史楼层
  authorLabel  String    @map("author_label") @db.VarChar(80)
  authorUserId String    @map("author_user_id") @db.VarChar(64)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([questionId, parentId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("question_hall_messages")
}

/// 结案记录：每次结案/重新结案新增一行，不覆盖历史
model QuestionHallSummary {
  id           Int      @id @default(autoincrement())
  questionId   Int      @map("question_id")
  /// 第几次结案（1 起）
  seq          Int
  content      String   @db.Text
  /// 参与统计的楼层数；truncated＝只读了最近若干条
  messageCount Int      @map("message_count")
  truncated    Boolean  @default(false)
  /// 生成时用的模型标签；空＝未取到
  model        String   @default("") @db.VarChar(128)
  createdBy    String   @map("created_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([questionId, seq])
  @@map("question_hall_summaries")
}

// ---------------------------------------------------------------------------
// IM 连接（飞书 / 企业微信）：组织级连接器，一套凭据服务本组织；
// 通讯录以本系统为准（推为主、拉只用于建立绑定），通知单向推送，OA/OKR 做镜像。
// ---------------------------------------------------------------------------

model ImConnector {
  id                Int       @id @default(autoincrement())
  /// ENTERPRISE | PROVIDER
  orgType           String    @map("org_type") @db.VarChar(16)
  orgUserId         String    @map("org_user_id") @db.VarChar(64)
  /// FEISHU | WECOM
  provider          String    @db.VarChar(16)
  name              String    @db.VarChar(80)
  /// 飞书 tenant_key / 企微 corpid
  corpId            String    @default("") @map("corp_id") @db.VarChar(120)
  appId             String    @default("") @map("app_id") @db.VarChar(120)
  appSecretEnc      String    @default("") @map("app_secret_enc") @db.Text
  /// 企微自建应用 AgentId
  agentId           String    @default("") @map("agent_id") @db.VarChar(64)
  /// 企微「通讯录同步」Secret（独立一份）
  contactSecretEnc  String    @default("") @map("contact_secret_enc") @db.Text
  verificationToken String    @default("") @map("verification_token") @db.VarChar(120)
  encryptKeyEnc     String    @default("") @map("encrypt_key_enc") @db.Text
  /// 回调路径里的随机串（32 hex），一条连接器一个
  webhookToken      String    @unique @map("webhook_token") @db.VarChar(32)
  status            String    @default("active") @db.VarChar(16)
  scopes            Json      @default("[]")
  lastVerifiedAt    DateTime? @map("last_verified_at")
  createdBy         String    @default("") @map("created_by") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, provider, corpId])
  @@index([orgType, orgUserId])
  @@map("im_connectors")
}

model ImMemberLink {
  id                   Int       @id @default(autoincrement())
  connectorId          Int       @map("connector_id")
  /// 已绑定时有值；未绑定（从 IM 拉到的陌生成员）为空串
  memberUserId         String    @default("") @map("member_user_id") @db.VarChar(64)
  externalUserId       String    @map("external_user_id") @db.VarChar(120)
  unionId              String    @default("") @map("union_id") @db.VarChar(120)
  nameSnapshot         String    @default("") @map("name_snapshot") @db.VarChar(120)
  mobileSnapshot       String    @default("") @map("mobile_snapshot") @db.VarChar(40)
  departmentExternalId String    @default("") @map("department_external_id") @db.VarChar(120)
  /// MANUAL | IM_PULL | LOCAL_PUSH
  source               String    @default("MANUAL") @db.VarChar(16)
  /// LINKED | PENDING | DISABLED
  status               String    @default("PENDING") @db.VarChar(16)
  lastSyncedAt         DateTime? @map("last_synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([connectorId, externalUserId])
  @@index([connectorId, memberUserId])
  @@map("im_member_links")
}

model ImDeptLink {
  id               Int      @id @default(autoincrement())
  connectorId      Int      @map("connector_id")
  department       String   @db.VarChar(64)
  externalDeptId   String   @map("external_dept_id") @db.VarChar(120)
  name             String   @default("") @db.VarChar(120)
  parentExternalId String   @default("") @map("parent_external_id") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([connectorId, department])
  @@map("im_dept_links")
}

model ImObjectBinding {
  id          Int       @id @default(autoincrement())
  connectorId Int       @map("connector_id")
  /// APPROVAL | TASK | BASE | LOWCODE | DRIVE | BI
  module      String    @db.VarChar(16)
  objectKey   String    @map("object_key") @db.VarChar(120)
  /// PUSH | PULL | BOTH
  direction   String    @default("PUSH") @db.VarChar(8)
  config      Json      @default("{}")
  fieldMap    Json      @default("{}") @map("field_map")
  enabled     Boolean   @default(true)
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([connectorId, module, objectKey])
  @@map("im_object_bindings")
}

model ImObjectLink {
  id            Int       @id @default(autoincrement())
  bindingId     Int       @map("binding_id")
  module        String    @db.VarChar(16)
  localId       String    @map("local_id") @db.VarChar(120)
  externalId    String    @map("external_id") @db.VarChar(120)
  localHash     String    @default("") @map("local_hash") @db.VarChar(64)
  externalHash  String    @default("") @map("external_hash") @db.VarChar(64)
  lastDirection String    @default("") @map("last_direction") @db.VarChar(8)
  status        String    @default("LINKED") @db.VarChar(16)
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([bindingId, localId])
  @@index([bindingId, externalId])
  @@map("im_object_links")
}

model ImEvent {
  id          Int       @id @default(autoincrement())
  connectorId Int       @map("connector_id")
  /// IN | OUT
  direction   String    @db.VarChar(8)
  /// EVENT | SYNC | NOTIFY
  kind        String    @db.VarChar(8)
  eventId     String    @map("event_id") @db.VarChar(160)
  objectType  String    @default("") @map("object_type") @db.VarChar(40)
  objectId    String    @default("") @map("object_id") @db.VarChar(120)
  payload     Json      @default("{}")
  /// RECEIVED | DONE | FAILED | SKIPPED
  status      String    @default("RECEIVED") @db.VarChar(16)
  attempts    Int       @default(0)
  error       String    @default("") @db.VarChar(500)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([connectorId, eventId])
  @@index([connectorId, status])
  @@map("im_events")
}

model ImNotifyRule {
  id          Int      @id @default(autoincrement())
  connectorId Int      @unique @map("connector_id")
  /// [{ event: string, target: "OFF"|"USER"|"CHAT", chatId: string }]
  rules       Json     @default("[]")
  quietHours  Json     @default("{}") @map("quiet_hours")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("im_notify_rules")
}

// ==================== SNS 社交板块（原 sns 仓模型，表名 sns_ 前缀；ApiKey 已并入上方 api_keys）====================

/// SNS 资料扩展：头像/昵称/简介等基础身份在本地 users 表
model SnsProfile {
  id         Int      @id @default(autoincrement())
  userId     String   @unique @map("user_id") @db.VarChar(64)
  title      String   @default("") @db.VarChar(120)
  city       String   @default("") @db.VarChar(64)
  gender     String   @default("UNSPECIFIED") @db.VarChar(16)
  bio        String   @default("") @db.Text
  lang       String   @default("zh") @db.VarChar(8)
  visibility Json     @default("{}")
  /// 自填联系方式：{ phone, email, wechat, douyin, xiaohongshu, blog, x, tiktok, facebook }
  contacts   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("sns_profiles")
}

model FriendRequest {
  id         Int       @id @default(autoincrement())
  fromUserId String    @map("from_user_id") @db.VarChar(64)
  toUserId   String    @map("to_user_id") @db.VarChar(64)
  message    String    @default("") @db.VarChar(500)
  status     String    @default("PENDING") @db.VarChar(16)
  createdAt  DateTime  @default(now()) @map("created_at")
  handledAt  DateTime? @map("handled_at")

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("sns_friend_requests")
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userAId   String   @map("user_a_id") @db.VarChar(64)
  userBId   String   @map("user_b_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("sns_friendships")
}

model Follow {
  id         Int      @id @default(autoincrement())
  followerId String   @map("follower_id") @db.VarChar(64)
  followeeId String   @map("followee_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("sns_follows")
}

model Block {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id") @db.VarChar(64)
  blockedUserId String   @map("blocked_user_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, blockedUserId])
  @@index([blockedUserId])
  @@map("sns_blocks")
}

model Mailbox {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  address   String   @unique @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sns_mailboxes")
}

/// 双人会话；同一对用户的多封邮件在此聚合
model MailThread {
  id            Int      @id @default(autoincrement())
  userAId       String   @map("user_a_id") @db.VarChar(64)
  userBId       String   @map("user_b_id") @db.VarChar(64)
  subject       String   @default("") @db.VarChar(200)
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  messages SnsMessage[]

  @@unique([userAId, userBId])
  @@index([userBId, lastMessageAt])
  @@index([userAId, lastMessageAt])
  @@map("sns_mail_threads")
}

model SnsMessage {
  id          Int      @id @default(autoincrement())
  threadId    Int      @map("thread_id")
  fromUserId  String   @map("from_user_id") @db.VarChar(64)
  toUserId    String   @map("to_user_id") @db.VarChar(64)
  subject     String   @default("") @db.VarChar(200)
  body        String   @db.Text
  linkCards   Json     @default("[]") @map("link_cards")
  aiGenerated Boolean  @default(false) @map("ai_generated")
  inReplyToId Int?     @map("in_reply_to_id")
  readUserIds Json     @default("[]") @map("read_user_ids")
  createdAt   DateTime @default(now()) @map("created_at")

  thread MailThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@index([toUserId, createdAt])
  @@map("sns_messages")
}

/// 经历与学历：用户自填；org_key 为归一化机构名，同历匹配与同机构屏蔽按 (kind, org_key)
model Experience {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id") @db.VarChar(64)
  kind          String   @default("WORK") @db.VarChar(8)
  organization  String   @db.VarChar(120)
  title         String   @default("") @db.VarChar(120)
  startYear     Int?     @map("start_year")
  endYear       Int?     @map("end_year")
  description   String   @default("") @db.Text
  hideFromPeers Boolean  @default(false) @map("hide_from_peers")
  orgKey        String   @map("org_key") @db.VarChar(120)
  sort          Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, sort])
  @@index([kind, orgKey])
  @@map("sns_experiences")
}

/// 职场专业简历：与主页资料、经历完全分叉；同步只单向写入一次初始值
model Resume {
  id            Int      @id @default(autoincrement())
  userId        String   @unique @map("user_id") @db.VarChar(64)
  headline      String   @default("") @db.VarChar(120)
  location      String   @default("") @db.VarChar(64)
  summary       String   @default("") @db.Text
  objectiveRole String   @default("") @map("objective_role") @db.VarChar(120)
  objectiveCity String   @default("") @map("objective_city") @db.VarChar(64)
  objectiveType String   @default("") @map("objective_type") @db.VarChar(16)
  additional    String   @default("") @db.Text
  contacts      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("sns_resumes")
}

/// 简历条目：按 kind 分组（工作/教育/项目/技能/特长/语言/计算机/证书/荣誉/作品）
model ResumeItem {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  kind        String   @db.VarChar(16)
  title       String   @db.VarChar(120)
  subtitle    String   @default("") @db.VarChar(120)
  startYear   Int?     @map("start_year")
  endYear     Int?     @map("end_year")
  description String   @default("") @db.Text
  url         String   @default("") @db.VarChar(200)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, sort])
  @@map("sns_resume_items")
}

/// 动态：纯文字短内容，可见性 PUBLIC / FRIENDS
model Post {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  body       String   @db.Text
  visibility String   @default("PUBLIC") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([visibility, createdAt])
  @@index([createdAt])
  @@map("sns_posts")
}

/// 豆瓣式讨论组：公开/私密；加入机制建组时选定（自由加入/组长审批）
model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(30)
  avatar      String   @default("") @db.VarChar(500)
  description String   @default("") @db.Text
  rules       String   @default("") @db.Text
  category    String   @default("") @db.VarChar(30)
  visibility  String   @default("PUBLIC") @db.VarChar(16)
  joinPolicy  String   @default("FREE") @map("join_policy") @db.VarChar(16)
  ownerId     String   @map("owner_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, createdAt])
  @@index([visibility, createdAt])
  @@index([ownerId])
  @@map("sns_groups")
}

/// 组成员：role=OWNER 即组长，status=PENDING 为待审批入组申请
model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  userId    String   @map("user_id") @db.VarChar(64)
  role      String   @default("MEMBER") @db.VarChar(16)
  status    String   @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status])
  @@map("sns_group_members")
}

/// 小组主题帖；anonymous 逐条匿名：真实 userId 只留库内用于删除权限，读接口不回显
/// pinned 置顶 / featured 加精（组长与管理员操作）；tag 为发帖分类；likeCount 推荐数
model GroupTopic {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  userId      String   @map("user_id") @db.VarChar(64)
  title       String   @db.VarChar(120)
  body        String   @db.Text
  tag         String   @default("") @db.VarChar(30)
  anonymous   Boolean  @default(false)
  pinned      Boolean  @default(false)
  featured    Boolean  @default(false)
  likeCount   Int      @default(0) @map("like_count")
  replyCount  Int      @default(0) @map("reply_count")
  lastReplyAt DateTime @default(now()) @map("last_reply_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([groupId, lastReplyAt])
  @@index([groupId, pinned, featured])
  @@index([userId])
  @@map("sns_group_topics")
}

/// 楼层：floor 发帖时按当前回复数分配，删楼不重编号；likeCount 为豆瓣式「推荐」数
model GroupReply {
  id            Int      @id @default(autoincrement())
  topicId       Int      @map("topic_id")
  groupId       Int      @map("group_id")
  userId        String   @map("user_id") @db.VarChar(64)
  floor         Int      @default(0)
  body          String   @db.Text
  anonymous     Boolean  @default(false)
  likeCount     Int      @default(0) @map("like_count")
  replyToUserId String?  @map("reply_to_user_id") @db.VarChar(64)
  replyToFloor  Int?     @map("reply_to_floor")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([topicId, floor])
  @@index([userId])
  @@map("sns_group_replies")
}

/// 主题「推荐」去重表：一人一贴只算一次，取消即删行（豆瓣式）
model TopicLike {
  id        Int      @id @default(autoincrement())
  topicId   Int      @map("topic_id")
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([topicId, userId])
  @@index([userId])
  @@map("sns_topic_likes")
}

/// 回复「推荐」去重表
model ReplyLike {
  id        Int      @id @default(autoincrement())
  replyId   Int      @map("reply_id")
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([replyId, userId])
  @@index([userId])
  @@map("sns_reply_likes")
}

/// 招聘专区（商务人脉 → 招聘）：只做发布与对接，沟通走站内私信；
/// 本地免 Key 发布进招聘广场信息流，勾选则按「灵活用工」类目同步为 AIworkin 用工需求。
model HiringPost {
