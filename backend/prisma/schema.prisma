  remoteStatus String    @default("") @map("remote_status") @db.VarChar(32)
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([bindingId, taskId], map: "task_sync_links_binding_task_key")
  @@index([remoteId])
  @@map("task_sync_links")
}

model TaskSyncRun {
  id        Int      @id @default(autoincrement())
