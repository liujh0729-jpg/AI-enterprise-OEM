  deadline             String   @default("") @db.VarChar(32)
  regionScope          String   @default("") @map("region_scope") @db.VarChar(200)
  /// 地域范围三态（NONE 不限制 / REGION 指定地区 / RADIUS 经纬度坐标），跟着需求本身走
