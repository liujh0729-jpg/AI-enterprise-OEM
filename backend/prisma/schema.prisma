// ---------------------------------------------------------------------------
// OKR 计划：账号维度（ownerUserId），成员复用 org_staff
// ---------------------------------------------------------------------------

model OkrCycle {
  id          Int       @id @default(autoincrement())
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  orgType     String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId   String    @default("") @map("org_user_id") @db.VarChar(64)
  /// YEAR | QUARTER | MONTH
  kind        String    @db.VarChar(16)
  year        Int
  /// 季度 1~4；月度 1~12；年度 0
  period      Int       @default(0)
  title       String    @default("") @db.VarChar(120)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  /// DRAFT | ACTIVE | REVIEW | CLOSED
  status      String    @default("ACTIVE") @db.VarChar(16)
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([ownerUserId, kind, year, period])
  @@index([ownerUserId, status])
  @@index([orgType, orgUserId])
  @@map("okr_cycles")
}

model OkrObjective {
  id                Int      @id @default(autoincrement())
  ownerUserId       String   @map("owner_user_id") @db.VarChar(64)
  orgType           String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId         String   @default("") @map("org_user_id") @db.VarChar(64)
  /// 关联目标书（AI 拆解确认后回填）
  briefId           Int      @default(0) @map("brief_id")
  cycleId           Int      @map("cycle_id")
  /// 上级目标；0 = 顶层
  parentId          Int      @default(0) @map("parent_id")
  /// COMPANY | DEPT | PERSONAL
  level             String   @default("PERSONAL") @db.VarChar(16)
  title             String   @db.VarChar(200)
  description       String   @default("") @db.VarChar(2000)
  /// 承接人；'' = 账号本身
  ownerMemberUserId String   @default("") @map("owner_member_user_id") @db.VarChar(64)
  assignerUserId    String   @default("") @map("assigner_user_id") @db.VarChar(64)
  weight            Decimal  @default(1) @db.Decimal(6, 2)
  progress          Decimal  @default(0) @db.Decimal(6, 2)
  /// ORG | DEPT | SELF
  visibility        String   @default("ORG") @db.VarChar(16)
  /// DRAFT | ACTIVE | DONE | CANCELLED
  status            String   @default("ACTIVE") @db.VarChar(16)
  /// MANUAL | AGENT
  source            String   @default("MANUAL") @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, cycleId])
  @@index([ownerUserId, ownerMemberUserId])
  @@index([orgType, orgUserId])
  @@map("okr_objectives")
}

model OkrKeyResult {
  id                Int       @id @default(autoincrement())
  ownerUserId       String    @map("owner_user_id") @db.VarChar(64)
  orgType           String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId         String    @default("") @map("org_user_id") @db.VarChar(64)
  objectiveId       Int       @map("objective_id")
  title             String    @db.VarChar(200)
  /// MANUAL | AUTO | ROLLUP
  metricType        String    @default("MANUAL") @map("metric_type") @db.VarChar(16)
  targetValue       Decimal   @default(100) @map("target_value") @db.Decimal(16, 4)
  currentValue      Decimal   @default(0) @map("current_value") @db.Decimal(16, 4)
  startValue        Decimal   @default(0) @map("start_value") @db.Decimal(16, 4)
  unit              String    @default("") @db.VarChar(32)
  /// UP 越大越好 | DOWN 越小越好
  direction         String    @default("UP") @db.VarChar(8)
  weight            Decimal   @default(1) @db.Decimal(6, 2)
  ownerMemberUserId String    @default("") @map("owner_member_user_id") @db.VarChar(64)
  /// 自动指标描述（见方案 §6.1）
  metricSource      Json      @default("{}") @map("metric_source")
  lastRefreshedAt   DateTime? @map("last_refreshed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, objectiveId])
  @@index([orgType, orgUserId])
  @@map("okr_key_results")
}

model OkrProgressLog {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  krId        Int      @default(0) @map("kr_id")
  objectiveId Int      @default(0) @map("objective_id")
  before      Decimal  @default(0) @db.Decimal(16, 4)
  after       Decimal  @default(0) @db.Decimal(16, 4)
  progress    Decimal  @default(0) @db.Decimal(6, 2)
  note        String   @default("") @db.VarChar(500)
  /// MANUAL | AUTO | REPORT | PLAN
  source      String   @default("MANUAL") @db.VarChar(16)
  authorId    String   @default("") @map("author_id") @db.VarChar(64)
  refType     String   @default("") @map("ref_type") @db.VarChar(32)
  refId       String   @default("") @map("ref_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerUserId, krId])
  @@index([ownerUserId, createdAt])
  @@map("okr_progress_logs")
}

model OkrMetricSnapshot {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  krId        Int      @map("kr_id")
  value       Decimal  @default(0) @db.Decimal(16, 4)
  capturedAt  DateTime @default(now()) @map("captured_at")

  @@index([krId, capturedAt])
  @@map("okr_metric_snapshots")
}

model OkrPlan {
  id           Int       @id @default(autoincrement())
  ownerUserId  String    @map("owner_user_id") @db.VarChar(64)
  orgType      String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId    String    @default("") @map("org_user_id") @db.VarChar(64)
  memberUserId String    @map("member_user_id") @db.VarChar(64)
  objectiveId  Int       @default(0) @map("objective_id")
  krId         Int       @default(0) @map("kr_id")
  title        String    @db.VarChar(200)
  detail       String    @default("") @db.VarChar(2000)
  /// WEEK | DAY | ADHOC
  kind         String    @default("ADHOC") @db.VarChar(8)
  /// 2026-W44 / 2026-10-31；ADHOC 为空
  periodKey    String    @default("") @map("period_key") @db.VarChar(16)
  startDate    DateTime? @map("start_date") @db.Date
  dueDate      DateTime? @map("due_date") @db.Date
  priority     String    @default("MEDIUM") @db.VarChar(8)
  /// TODO | DOING | DONE | CANCELLED
  status       String    @default("TODO") @db.VarChar(16)
  progress     Decimal   @default(0) @db.Decimal(6, 2)
  /// 关联 Agent 定时任务；0 = 未关联
  scheduleId   Int       @default(0) @map("schedule_id")
  /// MANUAL | AGENT
  source       String    @default("MANUAL") @db.VarChar(16)
  doneAt       DateTime? @map("done_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId, memberUserId, kind, periodKey])
  @@index([ownerUserId, status])
  @@index([orgType, orgUserId])
  @@map("okr_plans")
}

model OkrReport {
  id             Int       @id @default(autoincrement())
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  orgType        String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String    @default("") @map("org_user_id") @db.VarChar(64)
  memberUserId   String    @map("member_user_id") @db.VarChar(64)
  /// DAILY | WEEKLY
  kind           String    @db.VarChar(8)
  periodKey      String    @map("period_key") @db.VarChar(16)
  /// { done, dataChange, blockers, next, attachments }
  content        Json      @default("{}")
  autoDraft      Json      @default("{}") @map("auto_draft")
  /// MANUAL | AGENT_AUTO | SYSTEM
  source         String    @default("MANUAL") @db.VarChar(16)
  scheduleId     Int       @default(0) @map("schedule_id")
  /// DRAFT | SUBMITTED
  status         String    @default("DRAFT") @db.VarChar(16)
  submittedAt    DateTime? @map("submitted_at")
  managerComment String    @default("") @map("manager_comment") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([ownerUserId, memberUserId, kind, periodKey])
  @@index([ownerUserId, kind, periodKey])
  @@index([orgType, orgUserId])
  @@map("okr_reports")
}

model OkrScore {
  id             Int       @id @default(autoincrement())
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  cycleId        Int       @map("cycle_id")
  memberUserId   String    @map("member_user_id") @db.VarChar(64)
  reviewerUserId String    @map("reviewer_user_id") @db.VarChar(64)
  /// [{ key, label, score, weight }]
  scores         Json      @default("[]")
  total          Decimal   @default(0) @db.Decimal(5, 2)
  comment        String    @default("") @db.VarChar(500)
  /// DRAFT | SUBMITTED
  status         String    @default("DRAFT") @db.VarChar(16)
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([ownerUserId, cycleId, memberUserId, reviewerUserId])
  @@index([ownerUserId, cycleId, memberUserId])
  @@map("okr_scores")
}

model OkrSettings {
  id                Int      @id @default(autoincrement())
  ownerUserId       String   @unique @map("owner_user_id") @db.VarChar(64)
  /// 管理者 memberUserId[]
  managers          Json     @default("[]")
  defaultVisibility String   @default("ORG") @map("default_visibility") @db.VarChar(16)
  /// 0 周日 | 1 周一
  weekStart         Int      @default(1) @map("week_start")
  autoDraftEnabled  Boolean  @default(true) @map("auto_draft_enabled")
  reportTemplates   Json     @default("{}") @map("report_templates")
  /// { daily: scheduleId, weekly: scheduleId }
  reportSchedules   Json     @default("{}") @map("report_schedules")
  /// [{ key, label, weight }]
  scoreDimensions   Json     @default("[]") @map("score_dimensions")
  metricRefreshHour Int      @default(5) @map("metric_refresh_hour")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("okr_settings")
}

// ---------------------------------------------------------------------------
// OA 办公审批：组织维度（orgType + orgUserId），人员复用 org_staff
// ---------------------------------------------------------------------------

model OaSettings {
  id               Int      @id @default(autoincrement())
  orgType          String   @map("org_type") @db.VarChar(16)
  orgUserId        String   @map("org_user_id") @db.VarChar(64)
  /// 额外 OA 管理员 memberUserId[]（组织主账号始终算管理员）
  adminUserIds     Json     @default("[]") @map("admin_user_ids")
  /// { 部门名: memberUserId }
  deptHeads        Json     @default("{}") @map("dept_heads")
  /// 节点停留超过 N 小时提醒一次；0 = 不提醒
  remindAfterHours Int      @default(24) @map("remind_after_hours")
  allowWithdraw    Boolean  @default(true) @map("allow_withdraw")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId])
  @@map("oa_settings")
}

model OaTemplate {
  id            Int      @id @default(autoincrement())
  orgType       String   @map("org_type") @db.VarChar(16)
  orgUserId     String   @map("org_user_id") @db.VarChar(64)
  /// 组织内唯一，如 leave / expense
  key           String   @db.VarChar(40)
  name          String   @db.VarChar(40)
  /// LEAVE | EXPENSE | PAYMENT | PURCHASE | SEAL | GENERAL | CUSTOM
  category      String   @db.VarChar(16)
  description   String   @default("") @db.VarChar(200)
  icon          String   @default("") @db.VarChar(40)
  /// 单号前缀，如 OA / QJ / BX
  numberPrefix  String   @default("OA") @map("number_prefix") @db.VarChar(8)
  fieldsSchema  Json     @default("[]") @map("fields_schema")
  flowSchema    Json     @default("[]") @map("flow_schema")
  linkageSchema Json     @default("[]") @map("linkage_schema")
  /// 每次保存 +1，单据提交时冻结快照
  version       Int      @default(1)
  builtin       Boolean  @default(false)
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdBy     String   @default("") @map("created_by") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, key])
  @@index([orgType, orgUserId, enabled, sortOrder])
  @@map("oa_templates")
}

model OaApplication {
  id              Int       @id @default(autoincrement())
  /// OA20261031-0001，由 common/document-number.ts 分配
  number          String    @unique @db.VarChar(32)
  orgType         String    @map("org_type") @db.VarChar(16)
  orgUserId       String    @map("org_user_id") @db.VarChar(64)
  templateId      Int       @map("template_id")
  templateVersion Int       @default(1) @map("template_version")
  title           String    @default("") @db.VarChar(200)
  applicantId     String    @map("applicant_id") @db.VarChar(64)
  applicantName   String    @default("") @map("applicant_name") @db.VarChar(64)
  department      String    @default("") @db.VarChar(64)
  formData        Json      @default("{}") @map("form_data")
  /// 提交时冻结的模板定义，改模板不影响在途单据
  fieldsSnapshot  Json      @default("[]") @map("fields_snapshot")
  flowSnapshot    Json      @default("[]") @map("flow_snapshot")
  linkageSnapshot Json      @default("[]") @map("linkage_snapshot")
  /// 草稿阶段暂存的抄送人；提交时展开为 oa_cc 行
  ccUserIds       Json      @default("[]") @map("cc_user_ids")
  /// 发起时上传的附件快照（数字资产 id / 名称 / 大小），不另建附件表
  attachments     Json      @default("[]")
  amount          Decimal?  @db.Decimal(16, 2)
  /// DRAFT | APPROVING | RETURNED | APPROVED | REJECTED | WITHDRAWN
  status          String    @default("DRAFT") @db.VarChar(16)
  currentNode     Int       @default(0) @map("current_node")
  submittedAt     DateTime? @map("submitted_at")
  finishedAt      DateTime? @map("finished_at")
  withdrawnAt     DateTime? @map("withdrawn_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, status, submittedAt])
  @@index([orgType, orgUserId, templateId])
  @@index([applicantId, status])
  @@map("oa_applications")
}

model OaTask {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  nodeIndex     Int       @map("node_index")
  nodeName      String    @default("") @map("node_name") @db.VarChar(60)
  approverId    String    @map("approver_id") @db.VarChar(64)
  /// ANY | ALL | SEQUENTIAL
  mode          String    @default("ANY") @db.VarChar(16)
  /// PENDING | APPROVED | REJECTED | SKIPPED | TRANSFERRED
  status        String    @default("PENDING") @db.VarChar(16)
  action        String    @default("") @db.VarChar(16)
  comment       String    @default("") @db.Text
  actedAt       DateTime? @map("acted_at")
  /// 转交来源 approverId；'' = 非转交而来
  delegatedFrom String    @default("") @map("delegated_from") @db.VarChar(64)
  /// AI 预审结果（按审批人本人模型生成并缓存）：{status,content,personaName,model,generatedAt,error}
  preReview     Json      @default("{}") @map("pre_review")
