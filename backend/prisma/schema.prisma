  @@index([approverId, status])
  @@index([applicationId, nodeIndex])
  @@map("oa_tasks")
}

model OaRecord {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  nodeIndex     Int      @default(0) @map("node_index")
  /// SUBMIT | APPROVE | REJECT | RETURN | TRANSFER | ADD_SIGN | WITHDRAW | COMMENT | SYSTEM
  action        String   @db.VarChar(16)
  operatorId    String   @map("operator_id") @db.VarChar(64)
  operatorName  String   @default("") @map("operator_name") @db.VarChar(64)
  comment       String   @default("") @db.Text
  /// [{ id, name, size }]，指向数字资产
  attachments   Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("oa_records")
}

model OaCc {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  userId        String    @map("user_id") @db.VarChar(64)
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([applicationId, userId])
  @@index([userId, readAt])
  @@map("oa_cc")
}

model OaLink {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  /// CRM_CUSTOMER | ... | DATA_TABLE_ROW
  targetType    String    @map("target_type") @db.VarChar(32)
  targetId      String    @map("target_id") @db.VarChar(64)
  /// LOG | SET_FIELD | SUBMIT_FLOW
  action        String    @db.VarChar(16)
  /// PENDING | DONE | FAILED | SKIPPED
  status        String    @default("PENDING") @db.VarChar(16)
  result        Json      @default("{}")
  error         String    @default("") @db.VarChar(500)
