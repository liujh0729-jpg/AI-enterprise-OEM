model WorkbuddyPlan {
  id             Int       @id @default(autoincrement())
  createdBy      String    @map("created_by") @db.VarChar(64)
  /// 新建方式：ai＝和 AI 沟通分析并确定任务；direct＝明确生成任务；scheduled＝定时任务
  kind           String    @default("ai") @db.VarChar(16)
  title          String    @db.VarChar(200)
