  remindedAt    DateTime? @map("reminded_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([approverId, status])
  @@index([applicationId, nodeIndex])
  @@map("oa_tasks")
}

model OaRecord {
