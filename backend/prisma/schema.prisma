  userId            String   @map("user_id") @db.VarChar(64)
  type              String   @default("FULL_TIME") @db.VarChar(16)
  title             String   @db.VarChar(100)
  description       String   @db.Text
  headCount         Int      @default(1) @map("head_count")
  salaryMode        String?  @map("salary_mode") @db.VarChar(16)
  salaryMin         Int?     @map("salary_min")
  salaryMax         Int?     @map("salary_max")
  currency          String   @default("AWCOIN") @db.VarChar(16)
  tags              Json     @default("[]")
  province          String   @default("") @db.VarChar(50)
  city              String   @default("") @db.VarChar(50)
  contactNote       String   @default("") @map("contact_note") @db.VarChar(500)
  deadline          String   @default("") @db.VarChar(64)
  status            String   @default("LOCAL_PUBLISHED") @db.VarChar(24)
  subcategoryId     String   @default("") @map("subcategory_id") @db.VarChar(64)
  aiworkinDemandNo  String   @default("") @map("aiworkin_demand_no") @db.VarChar(64)
  aiworkinListingNo String   @default("") @map("aiworkin_listing_no") @db.VarChar(64)
  publishedUpstream Boolean  @default(false) @map("published_upstream")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("sns_hiring_posts")
}

model Report {
  id           Int       @id @default(autoincrement())
  reporterId   String    @map("reporter_id") @db.VarChar(64)
  targetType   String    @map("target_type") @db.VarChar(16)
  targetId     String    @map("target_id") @db.VarChar(64)
  targetUserId String    @map("target_user_id") @db.VarChar(64)
  reason       String    @default("") @db.VarChar(500)
  status       String    @default("PENDING") @db.VarChar(16)
  note         String    @default("") @db.VarChar(500)
  handledBy    String    @default("") @map("handled_by") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  handledAt    DateTime? @map("handled_at")

  @@index([status, createdAt])
  @@index([targetUserId])
  @@map("sns_reports")
}

/// 社交板块级封禁：与平台级封禁（users.status=BANNED）分层
model UserSuspension {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.VarChar(64)
  reason      String    @default("") @db.VarChar(500)
  suspendedBy String    @default("") @map("suspended_by") @db.VarChar(64)
  liftedAt    DateTime? @map("lifted_at")
  liftedBy    String    @default("") @map("lifted_by") @db.VarChar(64)
  liftNote    String    @default("") @map("lift_note") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, liftedAt])
  @@index([createdAt])
  @@map("sns_user_suspensions")
}

/// AI 代理（MCP/API）发送类动作授权白名单
model AiGrant {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.VarChar(64)
  name           String   @db.VarChar(100)
  allowedActions Json     @default("[]") @map("allowed_actions")
  status         String   @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("sns_ai_grants")
}

/// 供求广场帖（设计 §4.2）：社交板通用发布需求/服务，本地免 Key 发布，勾选则同步 AIworkin。
model Listing {
  id               Int      @id @default(autoincrement())
  authorUserId     String   @map("author_user_id") @db.VarChar(64)
  type             String   @db.VarChar(16)
  title            String   @db.VarChar(120)
  description      String   @db.Text
  tags             Json     @default("[]")
  moneyMode        String?  @map("money_mode") @db.VarChar(16)
  amountMin        Int?     @map("amount_min")
  amountMax        Int?     @map("amount_max")
  currency         String   @default("AWCOIN") @db.VarChar(16)
  province         String   @default("") @db.VarChar(50)
  city             String   @default("") @db.VarChar(50)
  contactNote      String   @default("") @map("contact_note") @db.VarChar(500)
  status           String   @default("LOCAL_PUBLISHED") @db.VarChar(24)
  aiworkinDemandNo String   @default("") @map("aiworkin_demand_no") @db.VarChar(64)
  aiworkinListingNo String  @default("") @map("aiworkin_listing_no") @db.VarChar(64)
  publishedUpstream Boolean  @default(false) @map("published_upstream")
  subcategoryId    String   @default("") @map("subcategory_id") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([authorUserId, createdAt])
  @@index([type, status, createdAt])
  @@index([createdAt])
  @@map("sns_listings")
}

/// 开放能力调用审计（区分 rest / mcp 通道）
model ApiCallLog {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  apiKeyId   Int?     @map("api_key_id")
  channel    String   @default("rest") @db.VarChar(16)
  endpoint   String   @db.VarChar(200)
  method     String   @db.VarChar(10)
  statusCode Int      @map("status_code")
  ip         String   @default("") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("sns_api_call_logs")
}

/// 邀请归因：邀请码＝邀请人用户名，只记归因不涉币
model InviteAccept {
  id        Int      @id @default(autoincrement())
  inviterId String   @map("inviter_id") @db.VarChar(64)
  inviteeId String   @unique @map("invitee_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([inviterId, createdAt])
  @@map("sns_invite_accepts")
}

/// 批任务台账：(job, day) 唯一键防多实例/重启重跑；day 存本地日期字符串
model BatchRun {
  id         Int       @id @default(autoincrement())
  job        String    @db.VarChar(64)
  day        String    @db.VarChar(10)
  status     String    @default("RUNNING") @db.VarChar(16)
  trigger    String    @default("auto") @db.VarChar(16)
  attempts   Int       @default(1)
  units      Int       @default(0)
  affected   Int       @default(0)
  detail     String    @default("") @db.VarChar(500)
  lastError  String?   @map("last_error") @db.VarChar(500)
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@unique([job, day])
  @@index([day])
  @@map("sns_batch_runs")
}

/// 名录镜像（开源版改由本地 users 生成，鉴权仍走实时查询）
model UserMirror {
  id            Int       @id @default(autoincrement())
  userId        String    @unique @map("user_id") @db.VarChar(64)
  username      String    @default("") @db.VarChar(64)
  displayName   String    @default("") @map("display_name") @db.VarChar(120)
  email         String?   @db.VarChar(190)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  personalIntro String?   @map("personal_intro") @db.VarChar(500)
  enabled       Boolean   @default(true)
  sourceCreated DateTime? @map("source_created") @db.DateTime(3)
  syncedAt      DateTime  @default(now()) @map("synced_at")

  @@index([enabled, userId])
  @@map("sns_user_mirror")
}

/// 六度关系物化：查看者→目标的度数/引荐人/共同好友数/排序分
model UserAffinity {
  id          Int      @id @default(autoincrement())
  viewerId    String   @map("viewer_id") @db.VarChar(64)
  targetId    String   @map("target_id") @db.VarChar(64)
  degree      Int
  viaUserId   String?  @map("via_user_id") @db.VarChar(64)
  mutualCount Int      @default(0) @map("mutual_count")
  score       Int      @default(0)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@unique([viewerId, targetId])
  @@index([viewerId, score])
  @@map("sns_user_affinity")
}

/// 社交站内通知（与 Enterprise 既有 Notification 分层，M5 代码层评估合并）
model SnsNotification {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.VarChar(64)
  type      String    @db.VarChar(32)
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("sns_notifications")
}

// ---------- M2：本地账户体系（开源版独立用户库，脱离上游账号服务） ----------

/// 本地用户账户：id 的字符串形式即全系统 userId（与各业务表 user_id VarChar(64) 兼容）
model Account {
  id                 Int       @id @default(autoincrement())
  username           String    @unique @db.VarChar(64)
  email              String?   @unique @db.VarChar(160)
  phone              String?   @unique @db.VarChar(32)
  /// bcrypt 哈希；纯手机验证码注册时可为空
  passwordHash       String?   @map("password_hash") @db.VarChar(128)
  emailVerified      Int       @default(0) @map("email_verified") @db.TinyInt
  phoneVerified      Int       @default(0) @map("phone_verified") @db.TinyInt
  /// ACTIVE | BANNED | DELETED
  status             String    @default("ACTIVE") @db.VarChar(16)
  banReason          String?   @map("ban_reason") @db.VarChar(255)
  /// 管理员重置密码后首登强制改密
  mustChangePassword Int       @default(0) @map("must_change_password") @db.TinyInt
  /// 改密/重置后 +1，旧会话即时失效
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  /// 注销冷静期起点（status=DELETED 时生效）
  deletedAt          DateTime? @map("deleted_at")
  avatar             String?   @db.VarChar(512)
  intro              String?   @db.VarChar(500)
  lang               String    @default("zh") @db.VarChar(16)
  /// USER | PLATFORM_ADMIN
  role               String    @default("USER") @db.VarChar(24)
  /// 自己的邀请码（大写字母数字）：注册时他人填写即可建立邀请关系；存量账户首次访问邀请页时懒生成。
  inviteCode         String?   @unique @map("invite_code") @db.VarChar(16)
  /// 被谁邀请注册（邀请人的 Account.id；空＝非邀请注册）
  invitedBy          Int?      @map("invited_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

/// 统一验证码 / 重置令牌：只存 SHA-256 哈希，不存明文
model VerifyCode {
  id        Int       @id @default(autoincrement())
  /// REGISTER | LOGIN | RESET_PASSWORD | REBIND
  scene       String  @db.VarChar(24)
  /// EMAIL | SMS
  channel     String  @db.VarChar(12)
  /// 目标邮箱/手机号（RESET_PASSWORD 链接场景为小写邮箱）
  target      String  @db.VarChar(160)
  codeHash    String  @map("code_hash") @db.VarChar(64)
  failCount   Int     @default(0) @map("fail_count")
  expiresAt   DateTime @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([channel, target, scene])
  @@map("verify_codes")
}

/// 登录审计：成功/失败都记，连错锁定与风控取数用
model LoginLog {
  id        Int      @id @default(autoincrement())
  /// 登录输入串（用户名/邮箱/手机）
  account   String   @db.VarChar(160)
  userId    String?  @map("user_id") @db.VarChar(64)
  success   Int      @db.TinyInt
  /// 失败原因：密码错误 / 已封禁 / 锁定中 等
  reason    String?  @db.VarChar(120)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([account, createdAt])
  @@index([userId])
  @@map("login_logs")
}

/// AIPDD APIKey 池：按指纹归并，一把 Key 可被多个本地用户绑定（N:1）
model AipddKey {
  id             Int       @id @default(autoincrement())
  /// SHA-256(明文 Key)，用于多用户归并
  keyFingerprint String    @unique @map("key_fingerprint") @db.VarChar(64)
  /// AES-256-GCM 密文（EXTERNAL_CRED_KEY 派生密钥），接口永不回显
  keyCipher      String    @map("key_cipher") @db.Text
  aipddUserId    String?   @map("aipdd_user_id") @db.VarChar(64)
  /// 上游昵称/头像等快照
  aipddProfile   Json?     @map("aipdd_profile")
  status         String    @default("ACTIVE") @db.VarChar(16)
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("aipdd_keys")
}

/// 本地用户 ↔ AIPDD Key 绑定：一个用户只绑一把，一把可被多人绑
model UserAipddBinding {
  id      Int      @id @default(autoincrement())
  userId  String   @unique @map("user_id") @db.VarChar(64)
  keyId   Int      @map("key_id")
  boundAt DateTime @default(now()) @map("bound_at")

  @@index([keyId])
  @@map("user_aipdd_bindings")
}

/// 服务商展示：数据源在 AIworkin，展示权在本系统（visible/sort/adminNote 本地掌控）。
model ProviderDisplay {
  id                 Int      @id @default(autoincrement())
  aiworkinProviderId String   @unique @map("aiworkin_provider_id") @db.VarChar(64)
  snapshot           Json?
  visible            Boolean  @default(false)
  sortWeight         Int      @default(0) @map("sort_weight")
  adminNote          String   @default("") @map("admin_note") @db.VarChar(500)
  syncedAt           DateTime @default(now()) @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([visible, sortWeight])
  @@map("provider_display")
}

// ============================================================
// 积分体系（设计：docs/积分体系与OSS存储底座设计方案.md）
// 站内唯一计费钱包：充值入 / 行为奖励 / 功能消耗 / 账号间赠送，
// 一切余额变动必过 point_transactions 总账；赚分/花分数量全部管理员可配。
// 精度约定：积分一律 Decimal(18,4)；微信金额一律整数分 amountCents。
// ============================================================

/// 积分账户：与 Account 一对一（首次入账/首次查询懒建）
model PointAccount {
  id                  Int       @id @default(autoincrement())
  userId              String    @unique @map("user_id") @db.VarChar(64)
  /// 可用余额（可小数）
  balanceAmount       Decimal   @default(0) @map("balance_amount") @db.Decimal(18, 4)
  totalRechargeAmount Decimal   @default(0) @map("total_recharge_amount") @db.Decimal(18, 4)
  totalEarnAmount     Decimal   @default(0) @map("total_earn_amount") @db.Decimal(18, 4)
  totalSpendAmount    Decimal   @default(0) @map("total_spend_amount") @db.Decimal(18, 4)
  /// ACTIVE | ARREARS（欠费宽限中：资产只读不可新增）
  status              String    @default("ACTIVE") @db.VarChar(16)
  arrearsSince        DateTime? @map("arrears_since")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("point_accounts")
}

/// 积分总账：只追加不可改删；每条消费一行一账单，Σamount 与账户余额全量可对账
model PointTransaction {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id") @db.VarChar(64)
  /// RECHARGE | RECHARGE_BONUS | EARN | SPEND | TRANSFER_IN | TRANSFER_OUT | ADMIN_ADJUST
  type          String   @db.VarChar(24)
  /// register/invite/asset_storage/crm/bi/oa/ai_service/gift/admin…（奖励与消耗场景）
  scene         String   @default("") @db.VarChar(32)
  /// 有符号积分：正＝入账，负＝扣减
  amount        Decimal  @db.Decimal(18, 4)
  /// 入账后余额快照
  balanceAmount Decimal  @map("balance_amount") @db.Decimal(18, 4)
  /// 赠送对手方 userId（TRANSFER 两条流水互指，其余为空）
  counterparty  String   @default("") @db.VarChar(64)
  refType       String   @default("") @map("ref_type") @db.VarChar(32)
  refId         String   @default("") @map("ref_id") @db.VarChar(64)
  /// 手动调整时记录操作管理员
  operator      String   @default("") @db.VarChar(64)
  remark        String   @default("") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type, scene])
  @@map("point_transactions")
}

/// 充值订单：建单锁定汇率与档位赠送；微信 transactionId 唯一索引＝回调幂等键
model RechargeOrder {
  id                Int       @id @default(autoincrement())
  orderNo           String    @unique @map("order_no") @db.VarChar(32)
  userId            String    @map("user_id") @db.VarChar(64)
  /// 微信金额（整数分）
  amountCents       Int       @map("amount_cents")
  /// 成交时汇率（1 元 = N 积分）
  rateAmount        Decimal   @map("rate_amount") @db.Decimal(18, 4)
  pointsAmount      Decimal   @map("points_amount") @db.Decimal(18, 4)
  bonusPointsAmount Decimal   @default(0) @map("bonus_points_amount") @db.Decimal(18, 4)
  channel           String    @default("WECHAT") @db.VarChar(16)
  /// CREATED | PAID | CLOSED | FAILED
  status            String    @default("CREATED") @db.VarChar(16)
  transactionId     String?   @unique @map("transaction_id") @db.VarChar(64)
  prepayId          String    @default("") @map("prepay_id") @db.VarChar(128)
  codeUrl           String    @default("") @map("code_url") @db.VarChar(512)
  paidAt            DateTime? @map("paid_at")
  notifyPayload     Json?     @map("notify_payload")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("recharge_orders")
}

/// 积分与计费设置键值：汇率/充值档位/奖励数量/赠送限额/欠费策略等；敏感键（微信商户私钥等）密文入库
model PointSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("point_settings")
}

/// 模块计费配置：每个功能模块独立“免费/计量”；单价设 0 即免费，管理员随意改
model ModulePricing {
  id              Int      @id @default(autoincrement())
  /// asset_storage/crm/bi/oa/ai_service/ai_customer…
  code            String   @unique @db.VarChar(32)
  /// FREE | METERED
  mode            String   @default("FREE") @db.VarChar(16)
  /// gb_day/query/session/seat_month/instance…
  unit            String   @default("") @db.VarChar(32)
  unitPriceAmount Decimal  @default(0) @map("unit_price_amount") @db.Decimal(18, 4)
  /// 月免费额（单位同 unit）
  freeQuotaAmount Decimal  @default(0) @map("free_quota_amount") @db.Decimal(18, 4)
  /// 最低起扣，防微账单噪声
  minChargeAmount Decimal  @default(0.01) @map("min_charge_amount") @db.Decimal(18, 4)
  enabled         Int      @default(1) @db.TinyInt
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("module_pricing")
}

/// 计量出账原始数据：按天聚合出账类（存储/查询量）落这张表，实时扣费幂等也记这里
model UsageEvent {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.VarChar(64)
  code           String   @db.VarChar(32)
  quantityAmount Decimal  @map("quantity_amount") @db.Decimal(18, 4)
  occurredAt     DateTime @map("occurred_at")
  /// 0=待出账 1=已出账
  billed         Int      @default(0) @db.TinyInt
  billTxId       Int      @default(0) @map("bill_tx_id")
  remark         String   @default("") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([code, billed, occurredAt])
  @@index([userId, occurredAt])
  @@map("usage_events")
}

/// 数字资产每日存储快照：按 GB·天出账的账单源，兼作趋势图
model StorageDailySnapshot {
  id          BigInt   @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  /// 当日占用字节（BigInt：百 GB 级不溢出）
  bytesAmount BigInt   @map("bytes_amount")
  assetCount  Int      @default(0) @map("asset_count")
  /// 快照日（当日 00:00，与 userId 组成幂等键）
  snapshotAt  DateTime @map("snapshot_at")

  @@unique([userId, snapshotAt])
  @@index([snapshotAt])
  @@map("storage_daily_snapshots")
}

// ---------------------------------------------------------------------------
// 创意社区（Comfy Cloud 工作流市场）
//   表间一律用 id 松散关联、不建 Prisma 关系：与 content_* / points 模块同一口径，
//   跨模块读写都在服务层按 userId 收口，避免级联删除误伤社区内容。
// ---------------------------------------------------------------------------

/// 社区工作流：官方模板（source=OFFICIAL）与用户发布（source=USER）同表共陈。
/// format=api 才能站内直接运行；format=ui 只做浏览与下载（Comfy Cloud 拒收 UI 格式）。
model CommunityWorkflow {
  id            Int       @id @default(autoincrement())
  /// 官方＝模板名（与 comfy.org/hub 一一对应），用户＝wf_<uuid8>；发布后不变，作幂等重导入的键
  code          String    @unique @db.VarChar(64)
  /// OFFICIAL | USER
  source        String    @default("USER") @db.VarChar(16)
  /// 归属账号；官方条目为空串（无作者账号，只展示出处）
  ownerUserId   String    @default("") @map("owner_user_id") @db.VarChar(64)
  /// 作者显示名：官方＝模板 author 字段，用户＝发布时昵称
  ownerName     String    @default("") @map("owner_name") @db.VarChar(64)
  title         String    @db.VarChar(200)
  summary       String    @default("") @db.VarChar(500)
  description   String    @default("") @db.Text
  /// image | video | audio | 3d | llm | tools（社区页签分类）
  category      String    @default("image") @db.VarChar(16)
  /// 二级场景名：对应官方 Applied 分组或「文生图」等自定义分组
  groupLabel    String    @default("") @map("group_label") @db.VarChar(64)
  tags          Json      @default("[]")
  /// 产物媒体类型：image | video | audio | file（决定转存限额与前端展示）
  mediaType     String    @default("image") @map("media_type") @db.VarChar(16)
  /// api＝站内可直接运行；ui＝仅浏览（workflow_json 存原文供下载）
  format        String    @default("api") @db.VarChar(8)
  /// 工作流正文：format 对应的原始 JSON（api 格式已经导入期转换固化）
  workflowJson  Json      @map("workflow_json")
  /// 运行表单槽位：[{ key, label, type, nodeId, field, defaultValue, options, min, max }]
  slots         Json      @default("[]")
  /// 封面与示例图：本站 OSS 对象键数组（官方种子由 seed 上传自有桶后回落）
  coverKeys     Json      @default("[]") @map("cover_keys")
  /// 上游出处链接（comfy.org/hub 模板页），卡片保留来源
  comfyUrl      String    @default("") @map("comfy_url") @db.VarChar(500)
  /// PENDING | APPROVED | REJECTED | RECOMMENDED | REMOVED
  status        String    @default("PENDING") @db.VarChar(16)
  auditNote     String    @default("") @map("audit_note") @db.VarChar(500)
  auditedAt     DateTime? @map("audited_at")
  /// 审核人 userId
  auditBy       String    @default("") @map("audit_by") @db.VarChar(64)
  /// 推荐发奖幂等标记：非空＝已就这条工作流给过作者推荐积分，重推不再发
  rewardedAt    DateTime? @map("rewarded_at")
  runCount      Int       @default(0) @map("run_count")
  favoriteCount Int       @default(0) @map("favorite_count")
  likeCount     Int       @default(0) @map("like_count")
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([category, status])
  @@index([source, status])
  @@index([ownerUserId, status])
  @@map("community_workflows")
}

/// 社区运行记录：一次提交＝一个 Comfy Cloud job；产物由调度器转存进自有 OSS
model CommunityRun {
  id              Int       @id @default(autoincrement())
  workflowId      Int       @map("workflow_id")
  userId          String    @map("user_id") @db.VarChar(64)
  /// 上游 job uuid（提交未成功时为空串，只留本地失败记录）
  jobId           String    @default("") @map("job_id") @db.VarChar(64)
  /// queued | running | succeeded | failed | canceled（跟上游 v2 状态同名）
  status          String    @default("queued") @db.VarChar(16)
  progressCurrent Int       @default(0) @map("progress_current")
  progressTotal   Int       @default(0) @map("progress_total")
  /// 排队位（上游 queue_position，0＝不在队首信息内）
  queuePosition   Int       @default(0) @map("queue_position")
  /// 用户填写的槽位值：{ slotKey: value }（图片槽存本站资产 id）
  inputs          Json      @default("{}")
  errorText       String    @default("") @map("error_text") @db.VarChar(500)
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([workflowId])
  @@index([jobId])
  @@index([status, updatedAt])
  @@map("community_runs")
}

/// 运行产物：已从 Comfy Cloud 签名 URL 转存进本站 OSS（签名约 6 小时过期，不落自有桶就必失效）
model CommunityRunOutput {
  id        Int      @id @default(autoincrement())
  runId     Int      @map("run_id")
  /// image | video | audio | file
  kind      String   @default("image") @db.VarChar(16)
  name      String   @default("") @db.VarChar(200)
  /// 本站 OSS 对象键（空＝转存失败，仅留 url 快照）
  ossKey    String   @default("") @map("oss_key") @db.VarChar(500)
  /// 转存后的可访问地址（本站 OSS，非上游短命签名 URL）
  url       String   @default("") @db.Text
  sizeBytes BigInt   @default(0) @map("size_bytes")
  /// 关联的本站数字资产 id（DigitalAssetEntry.id，0＝未入台账）
  assetId   Int      @default(0) @map("asset_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@map("community_run_outputs")
}

/// 社区收藏：按账号唯一，重复收藏幂等
model CommunityFavorite {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  workflowId Int      @map("workflow_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, workflowId])
  @@index([workflowId])
  @@map("community_favorites")
}

/// 社区点赞：与收藏分表，便于后续单独统计与开关
model CommunityLike {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  workflowId Int      @map("workflow_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, workflowId])
  @@index([workflowId])
  @@map("community_likes")
}

/// Comfy Cloud 凭据：纯 BYOK，一个账号一把 Key；AES-256-GCM 密文入库，keyMask 仅供展示
model ComfyCredential {
  userId    String    @id @map("user_id") @db.VarChar(64)
  keyCipher String    @map("key_cipher") @db.Text
  /// 掩码展示（前4…后4），任何接口不回传原文
  keyMask   String    @default("") @map("key_mask") @db.VarChar(64)
  /// 最后一次校验通过时间；为空＝存了但未验证通过
  verifiedAt DateTime? @map("verified_at")
  /// 最近一次校验失败原因（已中文化，供引导弹窗展示）
  lastError String    @default("") @map("last_error") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("comfy_credentials")
}
