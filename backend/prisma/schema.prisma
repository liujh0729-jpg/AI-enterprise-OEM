// ==================== AI 获客（营销工具） ====================

/// 获客组织级设置（SystemSetting 的 key 只有 64 字符且是全局的，装不下组织键）
model AcqSetting {
  id                    Int      @id @default(autoincrement())
  orgType               String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId             String   @map("org_user_id") @db.VarChar(64)
  enabled               Boolean  @default(true)
  collectEnabled        Boolean  @default(true) @map("collect_enabled")
  qcEnabled             Boolean  @default(true) @map("qc_enabled")
  /// 关闭时所有触达都要人工确认；私信首条无论此项如何都人工
  outreachAutoSend      Boolean  @default(false) @map("outreach_auto_send")
  humanConfirm          Boolean  @default(true) @map("human_confirm")
  dailyComments         Int      @default(20) @map("daily_comments")
  dailyDm               Int      @default(30) @map("daily_dm")
  cooldownDays          Int      @default(7) @map("cooldown_days")
  intervalMinSeconds    Int      @default(20) @map("interval_min_seconds")
  intervalMaxSeconds    Int      @default(60) @map("interval_max_seconds")
  activeHoursStart      String   @default("09:00") @map("active_hours_start") @db.VarChar(5)
  activeHoursEnd        String   @default("21:00") @map("active_hours_end") @db.VarChar(5)
  evidenceRetentionDays Int      @default(180) @map("evidence_retention_days")
  followUpMaxRounds     Int      @default(2) @map("follow_up_max_rounds")
  defaultPlaybookId     Int      @default(0) @map("default_playbook_id")
  aiModel               String   @default("") @map("ai_model") @db.VarChar(128)
  aiChannelId           Int      @default(0) @map("ai_channel_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId])
  @@map("acq_settings")
}

/// 监控源：平台 + 查找方式 + 过滤 + 节奏
model AcqSource {
  id         Int       @id @default(autoincrement())
  orgType    String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId  String    @map("org_user_id") @db.VarChar(64)
  name       String    @db.VarChar(80)
  /// XHS | DOUYIN | ZHIHU | WEIBO | BILIBILI | WX_CHANNEL | WX_MP | TIKTOK | X | KUAISHOU
  platform   String    @db.VarChar(20)
  /// KEYWORD | COMPETITOR | TOPIC | ACCOUNT | URL
  mode       String    @db.VarChar(20)
  /// keywords[] / competitorIds[] / topicTags[] / accountUrls[] / urls[]
  query      Json      @default("{}")
  /// timeWindow / excludeWords[] / minComments / regions[] / excludeCustomers
  filters    Json      @default("{}")
  /// 空＝手动；daily / weekly 或 5 段 cron
  cron       String    @default("") @db.VarChar(60)
  dailyLimit Int       @default(200) @map("daily_limit")
  /// ACTIVE | PAUSED
  status     String    @default("ACTIVE") @db.VarChar(16)
  lastRunAt  DateTime? @map("last_run_at")
  nextRunAt  DateTime? @map("next_run_at")
  createdBy  String    @default("") @map("created_by") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, status])
  @@index([status, nextRunAt])
  @@map("acq_sources")
}

/// 采集批次：claim 单飞，插件掉线/平台改版记 PARTIAL，不把空结果当成功
model AcqRun {
  id          Int       @id @default(autoincrement())
  sourceId    Int       @map("source_id")
  orgType     String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId   String    @map("org_user_id") @db.VarChar(64)
  /// QUEUED | CLAIMED | RUNNING | DONE | PARTIAL | FAILED
  status      String    @default("QUEUED") @db.VarChar(16)
  /// 插件一次性令牌对应的 jobId，回执按此去重
  jobId       String    @default("") @map("job_id") @db.VarChar(120)
  claimedAt   DateTime? @map("claimed_at")
  heartbeatAt DateTime? @map("heartbeat_at")
  /// scanned / new / duplicate / filtered
  stats       Json      @default("{}")
  error       String    @default("") @db.Text
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@unique([jobId])
  @@index([sourceId, startedAt])
  @@index([orgType, orgUserId, status])
  @@map("acq_runs")
}

/// 线索：平台 + 平台用户标识相同即同一人，跨批次合并
model AcqLead {
  id             Int       @id @default(autoincrement())
  orgType        String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String    @map("org_user_id") @db.VarChar(64)
  platform       String    @db.VarChar(20)
  platformUserId String    @map("platform_user_id") @db.VarChar(120)
  nickname       String    @default("") @db.VarChar(120)
  profileUrl     String    @default("") @map("profile_url") @db.VarChar(500)
  intentScore    Int       @default(0) @map("intent_score")
  /// HOT | WARM | COLD
  intentLevel    String    @default("COLD") @map("intent_level") @db.VarChar(8)
  intentTags     Json      @default("[]") @map("intent_tags")
  /// rule | llm
  scoreMode      String    @default("rule") @map("score_mode") @db.VarChar(8)
  scoreReason    String    @default("") @map("score_reason") @db.Text
  /// 评分时给出的开场与风险，随最后一次评分覆盖
  opening        String    @default("") @db.Text
  risk           String    @default("") @db.VarChar(300)
  /// NEW | CONTACTED | REPLIED | QUALIFIED | PROMOTED | IGNORED
  status         String    @default("NEW") @db.VarChar(16)
  /// 触达抑制原因（退订/黑名单/竞品员工/已成交）：status=IGNORED 时非空，触达前一律拦截
  blockReason    String    @default("") @map("block_reason") @db.VarChar(300)
  ownerUserId    String    @default("") @map("owner_user_id") @db.VarChar(64)
  crmLeadId      Int       @default(0) @map("crm_lead_id")
  /// platform:platformUserId
  dedupeKey      String    @map("dedupe_key") @db.VarChar(200)
  evidenceCount  Int       @default(0) @map("evidence_count")
  /// 已补抓的公开联系方式条数（仅主页已公开可见字段，见 D7=B）
  contactCount   Int       @default(0) @map("contact_count")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([orgType, orgUserId, dedupeKey])
  @@index([orgType, orgUserId, status, intentScore])
  @@index([orgType, orgUserId, platform])
  @@map("acq_leads")
}

/// 线索证据：同一 URL 即同一条内容，原文按保留期清理
model AcqLeadEvidence {
  id         Int      @id @default(autoincrement())
  leadId     Int      @map("lead_id")
  orgType    String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId  String   @map("org_user_id") @db.VarChar(64)
  runId      Int      @default(0) @map("run_id")
  /// SEARCH | COMMENT | POST | PROFILE
  sourceType String   @map("source_type") @db.VarChar(20)
  url        String   @db.VarChar(500)
  /// 保留期到期后清空原文，只留摘要与链接
  excerpt    String   @db.Text
  summary    String   @default("") @db.VarChar(500)
  /// likes / comments / publishedAt
  metrics    Json     @default("{}")
  /// 该条证据里补抓到的公开联系方式 [{field,value,visibility}]（仅已公开可见字段，见 D7=B）
  contacts   Json     @default("[]")
  capturedAt DateTime @default(now()) @map("captured_at")

  @@unique([leadId, url])
  @@index([orgType, orgUserId, capturedAt])
  @@map("acq_lead_evidence")
}

/// 触达任务：草稿 → 审核 → 队列 → 执行 → 回执
model AcqOutreachTask {
  id             Int       @id @default(autoincrement())
  orgType        String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String    @map("org_user_id") @db.VarChar(64)
  leadId         Int       @map("lead_id")
  /// XHS_DM | DOUYIN_COMMENT | EMAIL | WECOM
  channel        String    @db.VarChar(20)
  /// COMMENT | DM | EMAIL | FRIEND_REQUEST
  action         String    @db.VarChar(20)
  targetUrl      String    @default("") @map("target_url") @db.VarChar(500)
  externalUserId String    @default("") @map("external_user_id") @db.VarChar(160)
  draft          String    @db.Text
  finalText      String    @default("") @map("final_text") @db.Text
  /// DRAFT | APPROVED | QUEUED | SENDING | SENT | FAILED | CANCELLED | SKIPPED
  status         String    @default("DRAFT") @db.VarChar(16)
  /// pass | block | pending | off
  moderation     String    @default("") @db.VarChar(16)
  moderationNote String    @default("") @map("moderation_note") @db.Text
  /// 风控拦截原因（黑名单/频控/冷却/内容安全），非空即不发送
  blockedReason  String    @default("") @map("blocked_reason") @db.VarChar(300)
  /// 插件 jobId，回执按此去重
  jobId          String    @default("") @map("job_id") @db.VarChar(120)
  /// 服务端执行渠道的透传参数（企微群发按企点「群发任务」接口字段填写）
  payload        Json      @default("{}")
  /// 已确认会产生真实发送/额度消耗：服务端渠道未确认不下发
  costConfirmed  Boolean   @default(false) @map("cost_confirmed")
  playbookId     Int       @default(0) @map("playbook_id")
  scheduledAt    DateTime? @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  /// submitted | succeeded | failed | unknown
  receiptStatus  String    @default("") @map("receipt_status") @db.VarChar(20)
  receiptRef     String    @default("") @map("receipt_ref") @db.VarChar(160)
  retryCount     Int       @default(0) @map("retry_count")
  /// 逐步风控与执行日志，供 outreachLogs 读取
  logs           Json      @default("[]")
  createdBy      String    @map("created_by") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, status, scheduledAt])
  @@index([leadId, channel, sentAt])
  @@index([jobId])
  @@map("acq_outreach_tasks")
}

/// 客户档案：给「有对话的人」加销售语义，不替换 CRM
model AcqProfile {
  id             Int       @id @default(autoincrement())
  orgType        String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String    @map("org_user_id") @db.VarChar(64)
  crmLeadId      Int       @default(0) @map("crm_lead_id")
  /// 渠道会话键；未提升 CRM 的入站客户用它做主键
  channelPeerKey String    @default("") @map("channel_peer_key") @db.VarChar(200)
  displayName    String    @default("") @map("display_name") @db.VarChar(120)
  /// free | engaged | qualified | customer | churned
  businessStatus String    @default("free") @map("business_status") @db.VarChar(20)
  purpose        String    @default("") @db.VarChar(200)
  source         String    @default("") @db.VarChar(60)
  budget         String    @default("") @db.VarChar(80)
  timeline       String    @default("") @db.VarChar(80)
  decisionRole   String    @default("") @map("decision_role") @db.VarChar(40)
  objections     Json      @default("[]")
  tags           Json      @default("[]")
  healthScore    Int       @default(60) @map("health_score")
  ownerUserId    String    @default("") @map("owner_user_id") @db.VarChar(64)
  nextActionAt   DateTime? @map("next_action_at")
  lastContactAt  DateTime? @map("last_contact_at")
  /// 会话固定的剧本版本，进行中不随发布切换
  pinnedVersion  Int       @default(0) @map("pinned_version")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, channelPeerKey])
  @@index([orgType, orgUserId, businessStatus])
  @@index([crmLeadId])
  @@map("acq_profiles")
}

/// 档案时间线：线索来源 → 触达 → 会话 → 跟进 → 阶段变化
model AcqProfileEvent {
  id        Int      @id @default(autoincrement())
  profileId Int      @map("profile_id")
  orgType   String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId String   @map("org_user_id") @db.VarChar(64)
  /// LEAD | OUTREACH | CHAT | FOLLOW_UP | STAGE | NOTE
  kind      String   @db.VarChar(24)
  refId     Int      @default(0) @map("ref_id")
  summary   String   @db.VarChar(500)
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([profileId, createdAt])
  @@index([orgType, orgUserId, kind])
  @@map("acq_profile_events")
}

/// 销售剧本：把 xiaobei 的 AGENTS/SOUL/IDENTITY/USER 拆成可版本化数据
model AcqPlaybook {
  id             Int      @id @default(autoincrement())
  orgType        String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String   @map("org_user_id") @db.VarChar(64)
  name           String   @db.VarChar(80)
  goal           String   @default("") @db.VarChar(120)
  /// alias / personality / canDo[] / cannotDo[] / tone / format / maxLinks
  persona        Json     @default("{}")
  /// noPricePromise / noTimelinePromise / noCompensationPromise / noCustomPromise / noFabricatedCases / extra[]
  boundaries     Json     @default("{}")
  /// triggers[] / handoffText / agentUserIds[]
  escalation     Json     @default("{}")
  /// [{ scene, text }]
  openers        Json     @default("[]")
  /// [{ topic, acknowledge, conclusion, evidence, nextStep }]
  objections     Json     @default("[]")
  kbIds          Json     @default("[]") @map("kb_ids")
  faqIds         Json     @default("[]") @map("faq_ids")
  /// DRAFT | PUBLISHED | ARCHIVED
  status         String   @default("DRAFT") @db.VarChar(16)
  currentVersion Int      @default(1) @map("current_version")
  createdBy      String   @default("") @map("created_by") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, name])
  @@map("acq_playbooks")
}

/// 剧本不可变版本快照：发布后新会话用新版本，进行中会话固定开始时的版本
model AcqPlaybookVersion {
  id          Int       @id @default(autoincrement())
  playbookId  Int       @map("playbook_id")
  version     Int
  snapshot    Json
  publishedAt DateTime? @map("published_at")
  createdBy   String    @map("created_by") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([playbookId, version])
  @@map("acq_playbook_versions")
}

/// 跟进计划：客户表达购买意向且明确要等一段时间才建
model AcqFollowUp {
  id             Int       @id @default(autoincrement())
  orgType        String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String    @map("org_user_id") @db.VarChar(64)
  profileId      Int       @map("profile_id")
  channelPeerKey String    @map("channel_peer_key") @db.VarChar(200)
  externalUserId String    @map("external_user_id") @db.VarChar(160)
  channel        String    @db.VarChar(20)
  accountId      String    @default("") @map("account_id") @db.VarChar(80)
  followUpAt     DateTime  @map("follow_up_at")
  reason         String    @db.VarChar(300)
  contextSummary String    @default("") @map("context_summary") @db.Text
  /// pending | sent_once | completed | cancelled
  status         String    @default("pending") @db.VarChar(16)
  sentText       String    @default("") @map("sent_text") @db.Text
  retryCount     Int       @default(0) @map("retry_count")
  playbookId     Int       @default(0) @map("playbook_id")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, status, followUpAt])
  @@index([profileId, status])
  @@map("acq_follow_ups")
}

/// 跟进回执账本：有意图无回执先对账，不覆盖旧账本，账本不可读则停发
model AcqFollowUpReceipt {
  id          Int      @id @default(autoincrement())
  followUpId  Int      @map("follow_up_id")
  attempt     Int
  text        String   @db.Text
  accountId   String   @default("") @map("account_id") @db.VarChar(80)
  operationId String   @default("") @map("operation_id") @db.VarChar(160)
  status      String   @default("") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followUpId, attempt])
  @@map("acq_follow_up_receipts")
}

/// 接待质检快照：保留「当时的判断」，不随会话后续变化改写
model AcqQcReview {
  id             Int      @id @default(autoincrement())
  orgType        String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String   @map("org_user_id") @db.VarChar(64)
  conversationId Int      @map("conversation_id")
  agentUserId    String   @default("") @map("agent_user_id") @db.VarChar(64)
  playbookId     Int      @default(0) @map("playbook_id")
  score          Int      @default(0)
  /// [{ key, name, score, note }] 五维各 20 分
  dimensions     Json     @default("[]")
  /// [{ dimension, quote, problem, rewrite }] 引用原话
  issues         Json     @default("[]")
  suggestions    Json     @default("[]")
  /// rule | llm
  mode           String   @default("rule") @db.VarChar(8)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orgType, orgUserId, createdAt])
  @@index([conversationId])
  @@map("acq_qc_reviews")
}

/// 插件会话令牌：签发时只落哈希（明文仅在签发响应里出现一次，服务端不可回读），
/// 过期靠 `expires_at` 判定、无需定时清理；重启 / 多实例共享同一份状态。
model PluginSessionToken {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userId     String    @map("user_id") @db.VarChar(64)
  /// 任务类型（collect | outreach），等价于旧 TokenEntry.type
  scope      String    @default("") @db.VarChar(32)
  orgType    String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId  String    @default("") @map("org_user_id") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("plugin_session_tokens")
}

/// 平台统一插件的能力目录覆盖（设计 §10.7）：能力定义写在契约（EXTENSION_CAPABILITIES），
/// 本表只存平台级覆盖——启用 / 灰度 / 强制升级 / 下线；无行即回落契约默认值，避免两处定义漂移。
model ExtensionCapability {
  id             Int       @id @default(autoincrement())
  key            String    @unique @db.VarChar(32)
  /// '' 表示继承契约默认；否则 ACTIVE | GRAY | DEPRECATED | RETIRED
  status         String    @default("") @db.VarChar(16)
  /// '' 表示继承契约默认最低版本
  minVersion     String    @default("") @map("min_version") @db.VarChar(20)
  /// 灰度机构 userId 列表（GRAY 时只对这些机构派发）
  grayOrgIds     Json      @default("[]") @map("gray_org_ids")
  /// 强制升级时间：到点后低于生效 minVersion 的插件一律拒绝派发
  forceUpgradeAt DateTime? @map("force_upgrade_at")
  note           String    @default("") @db.VarChar(300)
  updatedBy      String    @default("") @map("updated_by") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("extension_capabilities")
}

/// 平台统一浏览器任务（设计 §10.3 / §10.7）：服务器创建、插件认领的持久队列，
/// 配认领租约与结果回执——页面关闭、插件或服务重启后任务不丢，也不误报成功。
/// 同一来源（source，如 distribution:#<内容 id>）同时只允许一个未终结任务，防止多标签页重复执行。
model BrowserTask {
  id             Int       @id @default(autoincrement())
  /// 能力标识（契约 EXTENSION_CAPABILITY_KEYS）：distribution | acquisition | ...
  capability     String    @db.VarChar(32)
  /// 能力动作（契约能力目录里的 action key，如 fill / publish / collect）
  action         String    @db.VarChar(40)
  /// 幂等锚：服务端生成的 jobId，同一用户下唯一（重放/重复上报不新建行）
  jobId          String    @map("job_id") @db.VarChar(80)
  userId         String    @map("user_id") @db.VarChar(64)
  orgType        String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String    @default("") @map("org_user_id") @db.VarChar(64)
  /// 目标平台编码清单（能力相关）
  platforms      Json      @default("[]")
  /// 业务来源（如 distribution:#<内容 id>）：同来源同时只允许一个未终结任务
  source         String    @default("") @db.VarChar(120)
  /// 能力相关参数（服务端与插件按能力解释，不下发任意脚本）
  payload        Json      @default("{}")
  /// QUEUED | CLAIMED | RUNNING | SUCCEEDED | PARTIAL | FAILED | UNKNOWN | CANCELLED | EXPIRED
  status         String    @default("QUEUED") @db.VarChar(16)
  /// 认领方标识（页面会话 / 设备），租约期内其他认领方不可抢占
  leaseOwner     String    @default("") @map("lease_owner") @db.VarChar(64)
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  /// 最近一次回执口径（契约 BROWSER_RECEIPT_STATUSES）
  receiptStatus  String    @default("") @map("receipt_status") @db.VarChar(16)
  receiptCode    String    @default("") @map("receipt_code") @db.VarChar(40)
  receiptMessage String    @default("") @map("receipt_message") @db.VarChar(500)
  /// 逐条目/逐平台结果与证据（契约 browserReceiptSchema 的 results / evidence）
  results        Json      @default("[]")
  evidence       Json      @default("[]")
  /// 回执附带的数据快照（契约 browserReceiptSchema 的 data：如获客 runId / outreachId / 新增线索数）
  receiptData    Json      @default("{}") @map("receipt_data")
  pluginVersion  String    @default("") @map("plugin_version") @db.VarChar(20)
  /// 队列 TTL：到点仍未被认领的 QUEUED 任务记为 EXPIRED，避免僵尸任务长期占位
  expiresAt      DateTime? @map("expires_at")
  enqueuedAt     DateTime  @default(now()) @map("enqueued_at")
  claimedAt      DateTime? @map("claimed_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, jobId])
  @@index([userId, status, enqueuedAt])
  @@index([source, status])
  @@index([status, leaseExpiresAt])
  @@map("browser_tasks")
}

