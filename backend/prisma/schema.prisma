model ServiceAfterSalesEvent {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  fromStatus String   @default("") @map("from_status") @db.VarChar(16)
  toStatus   String   @map("to_status") @db.VarChar(16)
  note       String   @default("") @db.VarChar(500)
  operatorId String   @default("") @map("operator_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

