  platformMatchRunId   String   @default("") @map("platform_match_run_id") @db.VarChar(64)
  aiworkinSyncStatus   String   @default("PENDING") @map("aiworkin_sync_status") @db.VarChar(16)
  aiworkinSyncError    String   @default("") @map("aiworkin_sync_error") @db.VarChar(500)
  events               Json     @default("[]")
  messages             Json     @default("[]")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([createdBy])
  @@index([providerUserId, status])
  @@index([province, city])
  @@index([enterpriseId, id], map: "smart_service_orders_enterprise_id_id_idx")
  @@index([staffUserId, id], map: "smart_service_orders_staff_user_id_id_idx")
  @@map("smart_service_orders")
}

model OverseasClaim {
  id                   Int      @id @default(autoincrement())
  claimNo              String   @unique @map("claim_no") @db.VarChar(32)
  contractId           Int      @map("contract_id")
  enterpriseId         Int      @map("enterprise_id")
  providerUserId       String   @map("provider_user_id") @db.VarChar(64)
  staffUserId          String   @default("") @map("staff_user_id") @db.VarChar(64)
  serviceType          String   @map("service_type") @db.VarChar(32)
  title                String   @default("") @db.VarChar(200)
  amount               Decimal  @default(0) @db.Decimal(14, 2)
  country              String   @default("") @db.VarChar(64)
  remark               String   @db.Text
  /// 办理联系方式：企业侧 + 承办职员（系统自动带出，临时换人可改）
  contactName          String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String   @default("") @map("contact_phone") @db.VarChar(32)
  providerContactName  String   @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String   @default("") @map("provider_contact_phone") @db.VarChar(32)
  status               String   @default("SUBMITTED") @db.VarChar(16)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

