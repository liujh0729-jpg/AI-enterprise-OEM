/// 促销/抵扣码（B3#22①）：与积分券合流，核销即入账积分
model PointPromoCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(32)
  name           String    @db.VarChar(80)
  /// FIXED 固定积分 | PERCENT 按充值/消费金额百分比返积分
  kind           String    @default("FIXED") @db.VarChar(16)
  value          Decimal   @db.Decimal(18, 4)
  minAmount      Decimal   @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxRedemptions Int       @default(0) @map("max_redemptions")
  redeemedCount  Int       @default(0) @map("redeemed_count")
  perUserLimit   Int       @default(1) @map("per_user_limit")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  /// ACTIVE | DISABLED
  status         String    @default("ACTIVE") @db.VarChar(16)
  createdBy      String    @default("") @map("created_by") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// 兑换内容：POINTS 兑积分（存量码默认）| CARD 兑时长卡
  assetType      String    @default("POINTS") @map("asset_type") @db.VarChar(16)
  /// assetType=CARD 时指向 point_card_templates.code
  cardCode       String    @default("") @map("card_code") @db.VarChar(32)

  @@index([status, endsAt])
  @@map("point_promo_codes")
}

model PointPromoRedemption {
  id        Int      @id @default(autoincrement())
  promoId   Int      @map("promo_id")
  code      String   @db.VarChar(32)
  userId    String   @map("user_id") @db.VarChar(64)
  points    Decimal  @db.Decimal(18, 4)
  refAmount Decimal  @default(0) @map("ref_amount") @db.Decimal(18, 4)
  /// 卡码核销时快照规格 code（积分码留空）；兑换记录页据此说明「兑的是哪张卡」
  cardCode  String   @default("") @map("card_code") @db.VarChar(32)
  /// 卡码核销发出的卡（0=未发卡）；撤销后仍能顺着这里查到「已撤销」
  userCardId Int     @default(0) @map("user_card_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([promoId, userId])
  @@index([userId, createdAt])
  @@map("point_promo_redemptions")
}

/// 时长卡规格目录（平台管理员维护）：一张卡 = 一个模型 + 一个额度 + 一个有效期
model PointCardTemplate {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(32)
  name            String   @db.VarChar(80)
  /// 绑定的唯一模型（model_catalog.id）；一张卡不允许挂多个模型
  catalogId       Int      @map("catalog_id")
  /// 模型快照：目录行改名/下架后，已发出去的卡仍能说明自己本来配的是谁
  provider        String   @db.VarChar(24)
  modelKey        String   @map("model_key") @db.VarChar(128)
  /// 量纲快照（token | image | second），由 catalogId 的 billingUnit 派生后写死
  billingUnit     String   @map("billing_unit") @db.VarChar(16)
  /// 额度总量：token=tokens 个数；image=张；second=秒（基准档，倍率见 specMultipliers）
  quotaTotal      Decimal  @default(0) @map("quota_total") @db.Decimal(18, 4)
  /// 有效天数：日卡=1，30 天卡=30；从 activatedAt 起算，精确到秒
  validDays       Int      @default(1) @map("valid_days")
  /// 规格倍率：[{ match: { video_resolution: "720p" }, multiplier: 2 }]；空表=一律 1 倍
  specMultipliers Json     @default("[]") @map("spec_multipliers")
  /// 积分直兑价（0=不允许用积分兑换）
  pointsPrice     Decimal  @default(0) @map("points_price") @db.Decimal(18, 4)
  /// 现金购买价（分，0=不上架购买）
  cashCents       Int      @default(0) @map("cash_cents")
  /// 同一用户在该规格下最多持有几张（兑换码 / 积分 / 现金三入口合计）；0=不限
  perUserLimit    Int      @default(0) @map("per_user_limit")
  /// ACTIVE | DISABLED
  status          String   @default("ACTIVE") @db.VarChar(16)
  sortOrder       Int      @default(0) @map("sort_order")
  remark          String   @default("") @db.VarChar(200)
  createdBy       String   @default("") @map("created_by") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@index([catalogId])
  @@map("point_card_templates")
}

/// 用户持有的卡实例：码兑换 / 积分直兑 / 现金购买 / 后台发放都写这一张
model PointUserCard {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  templateId   Int      @map("template_id")
  templateCode String   @map("template_code") @db.VarChar(32)
  name         String   @db.VarChar(80)
  provider     String   @db.VarChar(24)
  modelKey     String   @map("model_key") @db.VarChar(128)
  billingUnit  String   @map("billing_unit") @db.VarChar(16)
  quotaTotal   Decimal  @default(0) @map("quota_total") @db.Decimal(18, 4)
  quotaUsed    Decimal  @default(0) @map("quota_used") @db.Decimal(18, 4)
  /// ACTIVE | EXHAUSTED | EXPIRED | REVOKED
  status       String   @default("ACTIVE") @db.VarChar(16)
  /// 发卡那一刻；expiresAt = activatedAt + validDays×24h
  activatedAt  DateTime @default(now()) @map("activated_at")
  expiresAt    DateTime @map("expires_at")
  /// REDEEM 码兑换 | POINTS 积分直兑 | CASH 现金购买 | ADMIN 后台发放
  source       String   @db.VarChar(16)
  /// 来源单据：兑换订单 orderNo（码兑换同样走 point_card_orders，四类来源口径统一）
  sourceRef    String   @default("") @map("source_ref") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, provider, modelKey, status])
  @@index([userId, status, expiresAt])
  @@index([templateId])
  @@map("point_user_cards")
}

/// 兑换订单：日卡购买 / 日卡兑换 / 积分兑换三类同表，消耗进度关联 point_user_cards
model PointCardOrder {
  id            Int       @id @default(autoincrement())
  orderNo       String    @unique @map("order_no") @db.VarChar(32)
  userId        String    @map("user_id") @db.VarChar(64)
  /// CARD_CASH 日卡购买 | CARD_CODE 日卡兑换 | CARD_POINTS 积分兑换
  kind          String    @db.VarChar(16)
  templateId    Int       @map("template_id")
  templateCode  String    @map("template_code") @db.VarChar(32)
  name          String    @db.VarChar(80)
  billingUnit   String    @map("billing_unit") @db.VarChar(16)
  quotaTotal    Decimal   @default(0) @map("quota_total") @db.Decimal(18, 4)
  /// 现金单实付（分）
  amountCents   Int       @default(0) @map("amount_cents")
  /// 积分单实扣积分
  pointsAmount  Decimal   @default(0) @map("points_amount") @db.Decimal(18, 4)
  /// CREATED | PAID | ISSUED | CLOSED | FAILED | REFUNDED
  status        String    @default("CREATED") @db.VarChar(16)
  transactionId String?   @unique @map("transaction_id") @db.VarChar(64)
  prepayId      String    @default("") @map("prepay_id") @db.VarChar(128)
  codeUrl       String    @default("") @map("code_url") @db.VarChar(512)
  /// 发卡后回填，进度条据此读 point_user_cards
  userCardId    Int?      @map("user_card_id")
  promoCode     String    @default("") @map("promo_code") @db.VarChar(32)
  paidAt        DateTime? @map("paid_at")
  issuedAt      DateTime? @map("issued_at")
  failReason    String    @default("") @map("fail_reason") @db.VarChar(200)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId, kind, createdAt])
  @@index([userId, createdAt])
  @@map("point_card_orders")
}

/// 售后工单（B3#22②）：引入 returns 的状态机，挂在服务台的会话/订单上
model ServiceAfterSalesTicket {
  id             Int      @id @default(autoincrement())
  ownerUserId    String   @map("owner_user_id") @db.VarChar(64)
  conversationId Int      @default(0) @map("conversation_id")
  orderNo        String   @default("") @map("order_no") @db.VarChar(64)
  /// RETURN 退货 | REPAIR 维修 | REFUND 退款 | EXCHANGE 换货
  kind           String   @default("RETURN") @db.VarChar(16)
