generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SchemaMeta {
  key       String   @id @map("key") @db.VarChar(64)
  value     String   @db.VarChar(200)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("_schema_meta")
}

model IdentityPreference {
  userId          String   @id @map("user_id") @db.VarChar(64)
  currentIdentity String   @map("current_identity") @db.VarChar(32)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("identity_preferences")
}

model EnterpriseProfile {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  name         String    @db.VarChar(200)
  uscc         String    @db.VarChar(32)
  /// 用户主体类型：COMPANY 企业 / INDIVIDUAL 个体工商户 / PERSONAL 个人
  /// （个人以姓名 + 身份证号认证；整页可浏览，财税与出海的签约 / 申报 / 账套 / 发布需求需企业或个体工商户）
  subjectType  String    @default("COMPANY") @map("subject_type") @db.VarChar(16)
  /// 个人主体的身份证号（18 位，末位可 X）
  idCard       String    @default("") @map("id_card") @db.VarChar(32)
  taxpayerType String    @default("GENERAL") @map("taxpayer_type") @db.VarChar(16)
  industry     String    @default("") @db.VarChar(100)
  legalPerson  String    @default("") @map("legal_person") @db.VarChar(64)
  phone        String    @default("") @db.VarChar(32)
  address      String    @default("") @db.VarChar(300)
  /// 所在省 / 市（提交认证时必选，选项取平台省市字典；服务商名录按省市筛选）
  province     String    @default("") @db.VarChar(48)
  city         String    @default("") @db.VarChar(48)
  status       String    @default("APPROVED") @db.VarChar(16)
  auditNote    String    @default("") @map("audit_note") @db.VarChar(500)
  /// 企享云侧企业 ID（报税/开票 MCP 入参 aggOrgId），绑定后自动申报/自动开票可用
  qxyOrgId     String    @default("") @map("qxy_org_id") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  auditedAt    DateTime? @map("audited_at")

  @@index([userId])
  @@map("enterprise_profiles")
}

model ProviderApplication {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id") @db.VarChar(64)
  providerType  String    @map("provider_type") @db.VarChar(32)
  orgName       String    @map("org_name") @db.VarChar(200)
  uscc          String    @default("") @db.VarChar(32)
  qualification String    @default("") @db.VarChar(300)
  contactName   String    @default("") @map("contact_name") @db.VarChar(64)
  contactPhone  String    @default("") @map("contact_phone") @db.VarChar(32)
  contactEmail  String    @default("") @map("contact_email") @db.VarChar(120)
  /// 机构所在省 / 市（备案申请时必选，选项取平台省市字典；名录按省市筛选服务商）
  province      String    @default("") @db.VarChar(48)
  city          String    @default("") @db.VarChar(48)
  intro         String    @db.Text
  status        String    @default("PENDING") @db.VarChar(16)
  auditNote     String    @default("") @map("audit_note") @db.VarChar(500)
  serviceItems  String    @default("") @map("service_items") @db.VarChar(300)
  /// 出海服务细项的逐项审核结果：[{ item, label, status: APPROVED|REJECTED, note }]
  itemAudits    Json      @default("[]") @map("item_audits")
  attachments   Json      @default("[]")
  businessStaff Json      @default("[]") @map("business_staff")
  subjectType   String    @default("COMPANY") @map("subject_type") @db.VarChar(16)
  idCard        String    @default("") @map("id_card") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at")
  auditedAt     DateTime? @map("audited_at")

  @@index([userId, providerType])
  @@map("provider_applications")
}

model StaffProfile {
  id            Int      @id @default(autoincrement())
  userId        String   @unique @map("user_id") @db.VarChar(64)
  realName      String   @map("real_name") @db.VarChar(64)
  phone         String   @db.VarChar(32)
  email         String   @default("") @db.VarChar(120)
  region        String   @default("") @db.VarChar(64)
  /// 常驻省 / 市（提交个人资料时必选，选项取平台省市字典；`region` 留作更细的区域说明）
  province      String   @default("") @db.VarChar(48)
  city          String   @default("") @db.VarChar(48)
  categories    Json     @default("[]")
  qualification String   @default("") @db.VarChar(200)
  intro         String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("staff_profiles")
}

model ProviderStaff {
  id             Int      @id @default(autoincrement())
  providerUserId String   @map("provider_user_id") @db.VarChar(64)
  staffUserId    String   @map("staff_user_id") @db.VarChar(64)
  roles          Json     @default("[]")
  /// 职能：部门名（取自本机构职能目录）
  department     String   @default("") @db.VarChar(64)
  /// 职能：岗位列表 [{ name, description }]（取自本机构职能目录）
  positions      Json     @default("[]")
  status         String   @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([providerUserId, staffUserId])
  @@map("provider_staff")
}

model StaffApplication {
  id             Int       @id @default(autoincrement())
  staffUserId    String    @map("staff_user_id") @db.VarChar(64)
  providerUserId String    @map("provider_user_id") @db.VarChar(64)
  category       String    @db.VarChar(32)
  // STAFF_APPLY（职员发起挂靠，机构审批） | PROVIDER_INVITE（服务商发起添加，职员确认）
  direction      String    @default("STAFF_APPLY") @db.VarChar(24)
  // 邀请的多角色（类目编码，逗号分隔）
  roles          String    @default("") @db.VarChar(200)
  status         String    @default("PENDING") @db.VarChar(16)
  note           String    @default("") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  auditedAt      DateTime? @map("audited_at")

  @@index([providerUserId, status])
  @@index([staffUserId, status])
  @@map("staff_applications")
}

model ProviderAssignment {
  id             Int      @id @default(autoincrement())
  providerUserId String   @map("provider_user_id") @db.VarChar(64)
  enterpriseId   Int      @map("enterprise_id")
  staffUserId    String   @map("staff_user_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([providerUserId, enterpriseId])
  @@map("provider_assignments")
}

model Contract {
  id                   Int      @id @default(autoincrement())
  contractNo           String   @unique @map("contract_no") @db.VarChar(32)
  providerUserId       String   @map("provider_user_id") @db.VarChar(64)
  providerOrg          String   @default("") @map("provider_org") @db.VarChar(200)
  enterpriseId         Int      @map("enterprise_id")
  enterpriseName       String   @default("") @map("enterprise_name") @db.VarChar(200)
  serviceType          String   @map("service_type") @db.VarChar(32)
  status               String   @default("PENDING") @db.VarChar(16)
  startDate            String   @default("") @map("start_date") @db.VarChar(16)
  endDate              String   @default("") @map("end_date") @db.VarChar(16)
  note                 String   @default("") @db.VarChar(500)
  /// 签约联系方式：系统按双方对应人档案自动带出，临时换人可改（见 shared/contacts.ts）
  contactName          String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String   @default("") @map("contact_phone") @db.VarChar(32)
  providerContactName  String   @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String   @default("") @map("provider_contact_phone") @db.VarChar(32)
  designatedStaff      Json     @default("{}") @map("designated_staff")
  designatedAgentId    Int      @default(0) @map("designated_agent_id")
  designatedAgentName  String   @default("") @map("designated_agent_name") @db.VarChar(64)
  designatedAgentOrg   String   @default("") @map("designated_agent_org") @db.VarChar(200)
  /// 平台主持的套餐交付签约挂回采购订单（0=普通签约）：交付进度反查、签约台账溯源
  packageOrderId       Int      @default(0) @map("package_order_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([enterpriseId, serviceType, status])
  @@index([providerUserId, status])
  @@index([packageOrderId])
  @@map("contracts")
}

model SystemSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  action    String   @db.VarChar(64)
  detail    String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, action])
  @@map("audit_logs")
}

model ApiKey {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  keyPrefix    String    @default("ek_") @map("key_prefix") @db.VarChar(12)
  keyHash      String    @unique @map("key_hash") @db.VarChar(64)
  /// 明文 Key 密文（AES-256-GCM，仅本人可回读，供「复制 API Key」）
  keyCipher    String    @default("") @map("key_cipher") @db.Text
  masked       String    @db.VarChar(64)
  name         String    @default("") @db.VarChar(128)
  /// 历史 sk_ 镜像列：同上
  remoteId     String    @default("") @map("remote_id") @db.VarChar(64)
  /// 权限范围（并入原 SNS api_keys）：["READ"] 等
  scopes       Json      @default("[\"READ\"]")
  status       String    @default("ACTIVE") @db.VarChar(16)
  /// 日调用限额（并入原 SNS api_keys）
  rateLimitDay Int       @default(2000) @map("rate_limit_day")
  /// 积分额度（调用模型广场累计消耗上限）；NULL = 不限额度
  pointsQuota  Decimal?  @map("points_quota") @db.Decimal(18, 4)
  callCount    Int       @default(0) @map("call_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")

  @@index([userId])
  @@index([userId, status])
  @@map("api_keys")
}

model LogisticsOrder {
  id                   Int      @id @default(autoincrement())
  orderNo              String   @unique @map("order_no") @db.VarChar(32)
  contractId           Int      @default(0) @map("contract_id")
  enterpriseId         Int      @default(0) @map("enterprise_id")
  createdBy            String   @map("created_by") @db.VarChar(64)
  providerUserId       String   @default("") @map("provider_user_id") @db.VarChar(64)
  staffUserId          String   @default("") @map("staff_user_id") @db.VarChar(64)
  carrier              String   @default("") @db.VarChar(200)
  orderType            String   @default("DOMESTIC") @map("order_type") @db.VarChar(24)
  /// 二级类目（AIworkin 物流仓储子类目 UUID，发布需求必填）
  subCategoryId        String   @default("") @map("sub_category_id") @db.VarChar(64)
  title                String   @db.VarChar(200)
  cargoName            String   @default("") @map("cargo_name") @db.VarChar(120)
  origin               String   @default("") @db.VarChar(200)
  destination          String   @default("") @db.VarChar(200)
  expectedDate         String   @default("") @map("expected_date") @db.VarChar(32)
  deadline             String   @default("") @db.VarChar(32)
  /// 地域范围三态（NONE 不限制 / REGION 指定地区 / RADIUS 经纬度坐标），跟着需求本身走
  regionMode           String   @default("NONE") @map("region_mode") @db.VarChar(16)
  /// 需求所在地省、市（RADIUS 由经纬度解析得到；不限制时为空）
  province             String   @default("") @db.VarChar(48)
  city                 String   @default("") @db.VarChar(48)
  longitude            Float?
  latitude             Float?
  radiusKm             Float?   @map("radius_km")
  remark               String   @db.Text
  budgetType           String   @default("") @map("budget_type") @db.VarChar(120)
  expectedResult       String   @default("") @map("expected_result") @db.VarChar(300)
  mustConditions       String   @default("") @map("must_conditions") @db.VarChar(300)
  tags                 String   @default("") @db.VarChar(200)
  emailSync            Int      @default(0) @map("email_sync")
  contactName          String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String   @default("") @map("contact_phone") @db.VarChar(32)
  contactWechat        String   @default("") @map("contact_wechat") @db.VarChar(64)
  contactEmail         String   @default("") @map("contact_email") @db.VarChar(120)
  /// 承运/揽收执行人联系方式（系统按承办人档案自动带出，临时换人可改）
  providerContactName  String   @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String   @default("") @map("provider_contact_phone") @db.VarChar(32)
  status               String   @default("OPEN") @db.VarChar(16)
  aiworkinPublished    Int      @default(0) @map("aiworkin_published")
  platformListingId    String   @default("") @map("platform_listing_id") @db.VarChar(64)
  platformMatchRunId   String   @default("") @map("platform_match_run_id") @db.VarChar(64)
  aiworkinSyncStatus   String   @default("PENDING") @map("aiworkin_sync_status") @db.VarChar(16)
  aiworkinSyncError    String   @default("") @map("aiworkin_sync_error") @db.VarChar(500)
  events               Json     @default("[]")
  messages             Json     @default("[]")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([createdBy])
  @@index([providerUserId, status])
  @@index([province, city])
  @@index([enterpriseId, id], map: "logistics_orders_enterprise_id_id_idx")
  @@index([staffUserId, id], map: "logistics_orders_staff_user_id_id_idx")
  @@map("logistics_orders")
}

