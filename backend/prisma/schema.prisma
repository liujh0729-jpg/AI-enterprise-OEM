  projectId  Int       @default(0) @map("project_id")
  /// JIRA | TEAMBITION | TAPD
  provider   String    @db.VarChar(16)
  baseUrl    String    @map("base_url") @db.VarChar(300)
  projectKey String    @default("") @map("project_key") @db.VarChar(80)
  username   String    @default("") @db.VarChar(120)
