// ---------------------------------------------------------------------------

/// 站点档案：域名级 SEO 项目上下文（品牌信息从 MktContext 带出，不重复存）
model SeoProject {
  id           Int      @id @default(autoincrement())
  orgType      String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId    String   @map("org_user_id") @db.VarChar(64)
  domain       String   @db.VarChar(200)
  brandName    String   @default("") @map("brand_name") @db.VarChar(80)
  /// DataForSEO location_code（默认 2840 = 美国）
  locationCode Int      @default(2840) @map("location_code")
  languageCode String   @default("en") @map("language_code") @db.VarChar(12)
  competitors  Json     @default("[]")
  /// 关键页 [{url, role: HUB|CONTENT|MONEY|OTHER}]
  keyPages     Json     @default("[]") @map("key_pages")
  note         String   @default("") @db.VarChar(500)
  createdBy    String   @default("") @map("created_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, domain])
  @@index([orgType, orgUserId])
  @@map("seo_projects")
}

