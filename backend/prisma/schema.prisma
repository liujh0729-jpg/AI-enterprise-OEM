  scene       String   @default("") @db.VarChar(200)
  status      String   @default("ACTIVE") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("supply_skus")
}

/// 供销网络 · 服务项目（线下场景化服务，必须绑定所属服务站）
model SupplyService {
