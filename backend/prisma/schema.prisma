/// 企业能力开通（服务商按服务企业配置 → 平台管理员审核通过后企业/财务人员才有对应功能）
/// code: E_TAX_FILING（电子报税·自动申报）| E_INVOICING（电子开票·自动开票）
/// status: REQUESTED（服务商已配置·待平台审核）| OPEN（已开通）| CLOSED（已关闭）
model EnterpriseCapability {
  id           Int      @id @default(autoincrement())
  enterpriseId Int      @map("enterprise_id")
  code         String   @db.VarChar(32)
  status       String   @default("REQUESTED") @db.VarChar(16)
  note         String   @default("") @db.VarChar(300)
  requestedBy  String   @default("") @map("requested_by") @db.VarChar(64)
  openedBy     String   @default("") @map("opened_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([enterpriseId, code])
  @@map("enterprise_capabilities")
}

/// 本系统自建的用户目录快照：账号服务（Java）没有目录接口，
/// 由每次带 token 的请求即时登记（JIT），并用 /user/info 补全昵称/邮箱/头像。
model UserDirectory {
  userId      String    @id @map("user_id") @db.VarChar(64)
  username    String    @default("") @db.VarChar(120)
  displayName String    @default("") @map("display_name") @db.VarChar(120)
  email       String    @default("") @db.VarChar(160)
  avatarUrl   String    @default("") @map("avatar_url") @db.VarChar(300)
  role        String    @default("") @db.VarChar(32)
  enabled     Int       @default(1)
  syncedAt    DateTime? @map("synced_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("user_directory")
}

/// 外报通道注册与开关：MANUAL（人工，默认启用）/ TAX_SP（持牌税务服务商）/ TAX_DIRECT（税企直连）/ CUSTOMS_SP（报关服务商）
model ExternalChannel {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(120)
  /// TAX | CUSTOMS
  bizType   String   @map("biz_type") @db.VarChar(16)
  enabled   Int      @default(1)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("external_channels")
}

/// 企业维度外报凭据（CA / 电子税务局子账号 / 电子口岸 IC 卡）：仅存密文，禁止明文落库与落日志
model ExternalCredential {
  id           Int       @id @default(autoincrement())
  enterpriseId Int       @map("enterprise_id")
  channelCode  String    @map("channel_code") @db.VarChar(32)
  /// CA | SERVICE_ACCOUNT | IC_CARD
  credType     String    @map("cred_type") @db.VarChar(24)
  label        String    @default("") @db.VarChar(120)
  /// AES-256-GCM 密文（iv:tag:payload，base64）
  secretCipher String    @map("secret_cipher") @db.Text
  extra        Json      @default("{}")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([enterpriseId, channelCode, credType, label])
  @@map("external_credentials")
}

/// 外报任务：幂等键 refType + refId + period 唯一
model ExternalSubmission {
  id             Int       @id @default(autoincrement())
  /// TAX | CUSTOMS
  bizType        String    @map("biz_type") @db.VarChar(16)
  /// TAX_DECLARATION | EXPORT_REFUND | CUSTOMS_DECL
  refType        String    @map("ref_type") @db.VarChar(32)
  refId          Int       @map("ref_id")
  refNo          String    @default("") @map("ref_no") @db.VarChar(32)
  enterpriseId   Int       @map("enterprise_id")
  providerUserId String    @default("") @map("provider_user_id") @db.VarChar(64)
  staffUserId    String    @default("") @map("staff_user_id") @db.VarChar(64)
  channelCode    String    @default("MANUAL") @map("channel_code") @db.VarChar(32)
  period         String    @default("") @db.VarChar(16)
  taxType        String    @default("") @map("tax_type") @db.VarChar(32)
  /// 外报目标系统（如「全国统一规范电子税务局」「自然人电子税务局（扣缴端）」）
  targetSystem   String    @default("") @map("target_system") @db.VarChar(120)
  payload        Json      @default("{}")
  payloadHash    String    @default("") @map("payload_hash") @db.VarChar(64)
  /// QUEUED | SUBMITTING | ACCEPTED | RECEIPT | PAID | REJECTED | CANCELLED
  status         String    @default("QUEUED") @db.VarChar(16)
  acceptNo       String    @default("") @map("accept_no") @db.VarChar(64)
  receiptNo      String    @default("") @map("receipt_no") @db.VarChar(64)
  errorCode      String    @default("") @map("error_code") @db.VarChar(32)
  errorMsg       String    @default("") @map("error_msg") @db.VarChar(500)
  attempts       Int       @default(0)
  /// 人工通道作业指引：{ system, entry, credential, steps[], fields[], notice }
  guide          Json      @default("{}")
  timeline       Json      @default("[]")
  submittedBy    String    @default("") @map("submitted_by") @db.VarChar(64)
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([refType, refId, period])
  @@index([enterpriseId, status])
  @@index([staffUserId, status])
  @@map("external_submissions")
}

/// 回执/回调原文留痕，不可篡改
model ExternalCallback {
  id             Int      @id @default(autoincrement())
  submissionId   Int      @map("submission_id")
  source         String   @default("MANUAL") @db.VarChar(32)
  rawBody        String   @db.Text
  signatureValid Int      @default(0) @map("signature_valid")
  receivedAt     DateTime @default(now()) @map("received_at")

  @@index([submissionId])
  @@map("external_callbacks")
}

/// 开发票申请（需求 6.4）：企业申请开票 → 财税承办人/财务专员审核 → 走企享云自动开票。
model InvoiceRequest {
  id                   Int       @id @default(autoincrement())
  reqNo                String    @unique @map("req_no") @db.VarChar(32)
  enterpriseId         Int       @map("enterprise_id")
  enterpriseName       String    @default("") @map("enterprise_name") @db.VarChar(200)
  requestedBy          String    @map("requested_by") @db.VarChar(64)
  providerUserId       String    @default("") @map("provider_user_id") @db.VarChar(64)
  staffUserId          String    @default("") @map("staff_user_id") @db.VarChar(64)
  /// 开票联系方式：企业申请人 + 财税承办人（系统自动带出，临时换人可改）
  contactName          String    @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String    @default("") @map("contact_phone") @db.VarChar(32)
  providerContactName  String    @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String    @default("") @map("provider_contact_phone") @db.VarChar(32)
  /// 发票类型代码（01/03/04）
  invoiceType          String    @default("04") @map("invoice_type") @db.VarChar(8)
  /// 购买方类型（1 企业 / 2 个人）
  buyerType            String    @default("1") @map("buyer_type") @db.VarChar(8)
  buyerName            String    @default("") @map("buyer_name") @db.VarChar(200)
  buyerTaxNo           String    @default("") @map("buyer_tax_no") @db.VarChar(64)
  orderNo              String    @default("") @map("order_no") @db.VarChar(64)
  remark               String    @default("") @map("remark") @db.VarChar(500)
  items                Json      @default("[]")
  amount               Decimal   @default(0) @map("amount") @db.Decimal(18, 2)
  tax                  Decimal   @default(0) @map("tax") @db.Decimal(18, 2)
  /// REQUESTED | ISSUING | SUBMITTED | ISSUE_UNKNOWN | ISSUED | REJECTED | CANCELLED
  status               String    @default("REQUESTED") @db.VarChar(16)
  reviewedBy           String    @default("") @map("reviewed_by") @db.VarChar(64)
  reviewedAt           DateTime? @map("reviewed_at")
  rejectReason         String    @default("") @map("reject_reason") @db.VarChar(500)
  issueCode            String    @default("") @map("issue_code") @db.VarChar(64)
  issueMessage         String    @default("") @map("issue_message") @db.VarChar(500)
  issueTaskId          String    @default("") @map("issue_task_id")
  issuedAt             DateTime? @map("issued_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([enterpriseId, status])
  @@index([staffUserId, status])
  @@map("invoice_requests")
}

/// 供销网络 · 服务站（B2B 供需网络最小经营单元，固定地理位置）
