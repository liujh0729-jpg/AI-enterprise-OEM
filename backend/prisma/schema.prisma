// ---------------------------------------------------------------------------
// OA 办公审批：组织维度（orgType + orgUserId），人员复用 org_staff
// ---------------------------------------------------------------------------

model OaSettings {
  id              Int      @id @default(autoincrement())
  orgType         String   @map("org_type") @db.VarChar(16)
  orgUserId       String   @map("org_user_id") @db.VarChar(64)
  /// 额外 OA 管理员 memberUserId[]（组织主账号始终算管理员）
  adminUserIds    Json     @default("[]") @map("admin_user_ids")
  /// { 部门名: memberUserId }
  deptHeads       Json     @default("{}") @map("dept_heads")
  /// 节点停留超过 N 小时提醒一次；0 = 不提醒
  remindAfterHours Int     @default(24) @map("remind_after_hours")
  allowWithdraw   Boolean  @default(true) @map("allow_withdraw")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId])
  @@map("oa_settings")
}

model OaTemplate {
  id           Int      @id @default(autoincrement())
  orgType      String   @map("org_type") @db.VarChar(16)
  orgUserId    String   @map("org_user_id") @db.VarChar(64)
  /// 组织内唯一，如 leave / expense
  key          String   @db.VarChar(40)
  name         String   @db.VarChar(40)
  /// LEAVE | EXPENSE | PAYMENT | PURCHASE | SEAL | GENERAL | CUSTOM
  category     String   @db.VarChar(16)
  description  String   @default("") @db.VarChar(200)
  icon         String   @default("") @db.VarChar(40)
  /// 单号前缀，如 OA / QJ / BX
  numberPrefix String   @default("OA") @map("number_prefix") @db.VarChar(8)
  fieldsSchema Json     @default("[]") @map("fields_schema")
  flowSchema   Json     @default("[]") @map("flow_schema")
  linkageSchema Json    @default("[]") @map("linkage_schema")
  /// 每次保存 +1，单据提交时冻结快照
  version      Int      @default(1)
  builtin      Boolean  @default(false)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String   @default("") @map("created_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, key])
  @@index([orgType, orgUserId, enabled, sortOrder])
  @@map("oa_templates")
}

model OaApplication {
  id              Int       @id @default(autoincrement())
  /// OA20261031-0001，由 common/document-number.ts 分配
  number          String    @unique @db.VarChar(32)
  orgType         String    @map("org_type") @db.VarChar(16)
  orgUserId       String    @map("org_user_id") @db.VarChar(64)
  templateId      Int       @map("template_id")
  templateVersion Int       @default(1) @map("template_version")
  title           String    @default("") @db.VarChar(200)
  applicantId     String    @map("applicant_id") @db.VarChar(64)
  applicantName   String    @default("") @map("applicant_name") @db.VarChar(64)
  department      String    @default("") @db.VarChar(64)
  formData        Json      @default("{}") @map("form_data")
  /// 提交时冻结的模板定义，改模板不影响在途单据
  fieldsSnapshot  Json      @default("[]") @map("fields_snapshot")
  flowSnapshot    Json      @default("[]") @map("flow_snapshot")
  linkageSnapshot Json      @default("[]") @map("linkage_snapshot")
  /// 草稿阶段暂存的抄送人；提交时展开为 oa_cc 行
  ccUserIds       Json      @default("[]") @map("cc_user_ids")
  /// 发起时上传的附件快照（数字资产 id / 名称 / 大小），不另建附件表
  attachments     Json      @default("[]")
  amount          Decimal?  @db.Decimal(16, 2)
  /// DRAFT | APPROVING | RETURNED | APPROVED | REJECTED | WITHDRAWN
  status          String    @default("DRAFT") @db.VarChar(16)
  currentNode     Int       @default(0) @map("current_node")
  submittedAt     DateTime? @map("submitted_at")
  finishedAt      DateTime? @map("finished_at")
  withdrawnAt     DateTime? @map("withdrawn_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, status, submittedAt])
  @@index([orgType, orgUserId, templateId])
  @@index([applicantId, status])
  @@map("oa_applications")
}

model OaTask {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  nodeIndex     Int       @map("node_index")
  nodeName      String    @default("") @map("node_name") @db.VarChar(60)
  approverId    String    @map("approver_id") @db.VarChar(64)
  /// ANY | ALL | SEQUENTIAL
  mode          String    @default("ANY") @db.VarChar(16)
  /// PENDING | APPROVED | REJECTED | SKIPPED | TRANSFERRED
  status        String    @default("PENDING") @db.VarChar(16)
  action        String    @default("") @db.VarChar(16)
  comment       String    @default("") @db.Text
  actedAt       DateTime? @map("acted_at")
  /// 转交来源 approverId；'' = 非转交而来
  delegatedFrom String    @default("") @map("delegated_from") @db.VarChar(64)
  /// AI 预审结果（按审批人本人模型生成并缓存）：{status,content,personaName,model,generatedAt,error}
  preReview     Json      @default("{}") @map("pre_review")
  /// 超时提醒只发一次
  remindedAt    DateTime? @map("reminded_at")
