  strategy       String    @default("single") @db.VarChar(16)
  /// 参与的 Workbuddy 账号 ID 数组（fan_out 时多于 1 个）
  accountIds     Json      @default("[]") @map("account_ids")
  /// 排期方式：once＝不排期；scheduled＝定时一次；recurring＝周期重复（与 RPA 任务同一套字段口径）
  scheduleType   String    @default("once") @map("schedule_type") @db.VarChar(16)
  /// 周期重复配置：{ freq, time, weekdays, day, minute }
  scheduleConfig Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻（定时一次＝用户选的时间；周期重复＝调度器推算出来的下一轮）
  scheduledAt    DateTime? @map("scheduled_at")
  /// draft | clarifying | ready | running | succeeded | failed | cancelled
  status         String    @default("draft") @db.VarChar(16)
  /// 汇总产出（跑完后由各任务结果收口）
  summary        String    @default("") @db.Text
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([createdBy, kind])
  @@index([kind, scheduleType, scheduledAt])
  @@map("workbuddy_plans")
}

model WorkbuddyTask {
  id           Int       @id @default(autoincrement())
  planId       Int       @map("plan_id")
  createdBy    String    @map("created_by") @db.VarChar(64)
  /// 任务类型，跟随所属计划：ai | direct | scheduled（列表按它筛选）
  kind         String    @default("ai") @db.VarChar(16)
  /// 计划内序号，界面按它排序
  seq          Int       @default(1)
  /// 派发用的 Workbuddy 账号（腾讯云凭据），执行期只在这条链路上解密
  accountId    Int       @map("account_id")
  /// 远程 Agent ID / 版本 ID（腾讯云侧主键，字符串）
  agentId      String    @default("") @map("agent_id") @db.VarChar(64)
  versionId    String    @default("") @map("version_id") @db.VarChar(64)
  /// CreateAgentSession 回传的会话 ID 与聊天入口（执行走会话端点，不是 OpenAPI）
  sessionId    String    @default("") @map("session_id") @db.VarChar(128)
  endpoint     String    @default("") @db.VarChar(500)
  /// 本次要交给 Agent 的完整指令（任务书里分给这一段的内容）
  instruction  String    @default("") @db.Text
  /// pending | running | succeeded | failed | cancelled
  status       String    @default("pending") @db.VarChar(16)
  /// 已同步到的消息事件水位（DescribeMessageEventList 的最后一个 seq）
  lastEventSeq Int       @default(0) @map("last_event_seq")
  output       Json      @default("{}")
  lastError    String    @default("") @map("last_error") @db.VarChar(500)
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([planId])
  @@index([createdBy, status])
  @@index([accountId])
  @@map("workbuddy_tasks")
}

model WorkbuddyTaskEvent {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
