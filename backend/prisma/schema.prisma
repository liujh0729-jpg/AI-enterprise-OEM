// ---------------------------------------------------------------------------
// 企微 SCRM（《企微SCRM一体化方案》§6）：客户以企微为源、本表为本地镜像。
// 原生 SCRM 是唯一客户同步源（启用后暂停企点客户同步）；管理端点按组织键隔离。
// ---------------------------------------------------------------------------

/// 企业接入：一个组织一条（corpid + 两个 Secret + 回调凭据），凭据一律 AES 加密落库
model ScrmCorp {
  id                   Int       @id @default(autoincrement())
  orgType              String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId            String    @map("org_user_id") @db.VarChar(64)
  corpId               String    @map("corp_id") @db.VarChar(64)
  corpName             String    @default("") @map("corp_name") @db.VarChar(120)
  agentId              String    @default("") @map("agent_id") @db.VarChar(32)
  /// 「外部联系人」Secret
  contactSecretEnc     String    @default("") @map("contact_secret_enc") @db.Text
  /// 自建应用 Secret（发消息/素材/群发）
  appSecretEnc         String    @default("") @map("app_secret_enc") @db.Text
  callbackTokenEnc     String    @default("") @map("callback_token_enc") @db.Text
  aesKeyEnc            String    @default("") @map("aes_key_enc") @db.Text
  /// 回调 URL 里的随机串（32 hex），一个企业一个，避免在公开路径暴露组织键
  callbackKey          String    @unique @map("callback_key") @db.VarChar(32)
  /// 会话内容存档（选配）：Secret + RSA 私钥
  archiveSecretEnc     String    @default("") @map("archive_secret_enc") @db.Text
  archivePrivateKeyEnc String    @default("") @map("archive_private_key_enc") @db.LongText
  enabled              Boolean   @default(true)
  /// ACTIVE | DISABLED | ERROR
  status               String    @default("ACTIVE") @db.VarChar(16)
  /// SCRM（原生 SCRM 唯一同步源）
  syncSource           String    @default("SCRM") @map("sync_source") @db.VarChar(16)
  /// 启用原生 SCRM 后置 true，企点客户同步调度跳过
  qidianPaused         Boolean   @default(false) @map("qidian_paused")
  lastSyncAt           DateTime? @map("last_sync_at")
  lastSyncResult       String    @default("") @map("last_sync_result") @db.VarChar(500)
  createdBy            String    @default("") @map("created_by") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId], map: "scrm_corps_org_key")
  @@index([orgType, orgUserId, status], map: "scrm_corps_org_status_idx")
  @@map("scrm_corps")
}

/// 客户镜像：以 (组织, externalUserId) 幂等 upsert；LOST 为流失态（保留档案）
model ScrmContact {
