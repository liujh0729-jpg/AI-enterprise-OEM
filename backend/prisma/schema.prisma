  revision             Int       @default(1)
  quotedAt             DateTime? @map("quoted_at")
  /// 基础服务费
  baseAmount           Decimal   @default(0) @map("base_amount") @db.Decimal(14, 2)
  otherFees            Json      @default("[]") @map("other_fees")
  feeAmount            Decimal   @default(0) @map("fee_amount") @db.Decimal(14, 2)
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  quoteNote            String    @default("") @map("quote_note") @db.VarChar(500)
  /// 报价联系人（服务商/承办职员报价时必填，供企业确认前后商务磋商）
  providerContactName  String    @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String    @default("") @map("provider_contact_phone") @db.VarChar(32)
  confirmNote          String    @default("") @map("confirm_note") @db.VarChar(500)
  confirmedAt          DateTime? @map("confirmed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([enterpriseId, status])
  @@index([providerUserId, status])
  @@index([staffUserId, status])
  @@index([stationId, status])
  @@map("supply_bookings")
}

/// 供销网络 · 单据操作留痕（提交/报价/确认/驳回/修改，支持溯源核查）
model SupplyOrderLog {
  id             Int      @id @default(autoincrement())
  /// ORDER 订货单 | BOOKING 服务预约单
  bizType        String   @map("biz_type") @db.VarChar(16)
  bizId          Int      @map("biz_id")
  action         String   @db.VarChar(32)
  operatorUserId String   @map("operator_user_id") @db.VarChar(64)
  operatorName   String   @default("") @map("operator_name") @db.VarChar(64)
  /// 操作内容（如「报价 12,300.00 元」）
  detail         String   @default("") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([bizType, bizId])
  @@map("supply_order_logs")
}

/// GEO 分析 · 品牌项目（GEO优化大师技能包口径：品牌/竞品/监控平台）
model GeoProject {
  id               Int       @id @default(autoincrement())
  /// 创建人（企业用户本人，或代客作业的服务商/职员/平台管理员）
  ownerUserId      String    @map("owner_user_id") @db.VarChar(64)
  /// 企业档案 id（0 = 未绑定企业）
  enterpriseId     Int       @default(0) @map("enterprise_id")
  /// 品牌方当事人 userId（企业用户创建时=本人，数据可见性用）
  enterpriseUserId String    @default("") @map("enterprise_user_id") @db.VarChar(64)
  brand            String    @db.VarChar(120)
  /// 品牌别名（逗号分隔，用于回答中识别点名）
  brandAliases     String    @default("") @map("brand_aliases") @db.VarChar(300)
  industry         String    @default("") @db.VarChar(120)
  /// 竞品品牌名（JSON 数组）
  competitors      Json      @default("[]")
  /// 监控平台（JSON 数组，来自五平台常量）
  platforms        Json      @default("[]")
  status           String    @default("ACTIVE") @db.VarChar(16)
  /// 自动采集开关（1 = 每周日凌晨窗口自动采集本期问题 × 平台）
  autoCollect      Int       @default(0) @map("auto_collect")
  /// 开关操作人 / 时间
  autoCollectBy    String    @default("") @map("auto_collect_by") @db.VarChar(64)
  autoCollectAt    DateTime? @map("auto_collect_at")
  note             String    @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([enterpriseId])
  @@map("geo_projects")
}

/// GEO 分析 · 监控问题库（起步 30 条：12 品类 / 8 决策 / 8 对比 / 2 品牌）
model GeoQuestion {
  id                 Int      @id @default(autoincrement())
  projectId          Int      @map("project_id")
  /// 人类可读编号 P0-01 / P1-03
  seq                String   @default("") @db.VarChar(16)
  text               String   @db.Text
  /// 品类词 | 决策词 | 竞品对比词 | 品牌词
  type               String   @default("品类词") @db.VarChar(32)
  /// 真实决策场景（需求引导第二轮的用户原话场景）
  scenario           String   @default("") @db.VarChar(300)
  /// 期望答案形态（如「清单/对比表」）
  expectedAnswerForm String   @default("") @map("expected_answer_form") @db.VarChar(200)
  priority           String   @default("P1") @db.VarChar(8)
  status             String   @default("ACTIVE") @db.VarChar(16)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("geo_questions")
}

/// GEO 分析 · 采集批次（通道 A 人工 / B 自动化 / C AI 采集；数据性质 simulated 必须标注）
model GeoBatch {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  periodLabel String   @map("period_label") @db.VarChar(64)
  /// A 人工 | B 自动化 | C AI 采集（每周自动采集建出的批次）
  channel     String   @default("A") @db.VarChar(8)
  /// simulated 模拟数据 | real 真实采集
  dataNature  String   @default("simulated") @map("data_nature") @db.VarChar(16)
  /// 本期监控平台（JSON 数组）
  platforms   Json     @default("[]")
  note        String   @db.Text
  createdBy   String   @default("") @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("geo_batches")
}

/// GEO 分析 · 观测记录（问题 × 平台 一条回答）
model GeoObservation {
  id              Int      @id @default(autoincrement())
  batchId         Int      @map("batch_id")
  questionId      Int      @map("question_id")
  platform        String   @db.VarChar(32)
  /// 品牌是否被点名（0/1）
  brandMentioned  Int      @default(0) @map("brand_mentioned")
  /// 上榜名次（未上榜为空）
  rankPosition    Int?     @map("rank_position")
  /// 正面 | 中性 | 负面 | 未提及
  sentiment       String   @default("未提及") @db.VarChar(16)
  /// 报告 | 官网 | 评测 | 百科 | 社区 | 无
  citationGenre   String   @default("无") @map("citation_genre") @db.VarChar(16)
  citationDomains String   @default("") @map("citation_domains") @db.VarChar(500)
  modelVersion    String   @default("") @map("model_version") @db.VarChar(64)
  answerExcerpt   String   @map("answer_excerpt") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([batchId])
  @@index([questionId])
  @@map("geo_observations")
}

/// GEO 分析 · 差距选题池（四维评分：缺口强度30% + AI可引性30% + 商业价值25% + 供给难度15%）
model GeoTopic {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  title         String   @db.VarChar(200)
  /// 引用真空点 | 竞品覆盖点 | 弱覆盖点 | 品牌被错误描述点 | 无缺口
  gapType       String   @default("引用真空点") @map("gap_type") @db.VarChar(32)
  /// 来源问题 id（可空：用户自拟题材）
  questionId    Int      @default(0) @map("question_id")
  /// 命中平台数（≥3 平台同现缺口，缺口强度 +2）
  platformCount Int      @default(0) @map("platform_count")
  /// 四维原始分（1-10）+ 加成
  gapScore      Int      @default(0) @map("gap_score")
  citableScore  Int      @default(0) @map("citable_score")
  businessScore Int      @default(0) @map("business_score")
  supplyScore   Int      @default(0) @map("supply_score")
  /// 内容形态加成（干货/对比/数据 +2、案例 +1）
  styleBonus    Int      @default(0) @map("style_bonus")
  /// 加权总分（后端按公式计算，不取前端值）
  totalScore    Float    @default(0) @map("total_score")
  /// 黑名单题材：判 0 分淘汰
  blacklisted   Int      @default(0)
  /// CANDIDATE 候选 | SELECTED 已选 | REJECTED 淘汰
  status        String   @default("CANDIDATE") @db.VarChar(16)
  note          String   @default("") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("geo_topics")
}

/// GEO 采集平台 API Key（每个账号在「营销工具」里配自己的）：
/// key_cipher 只存 AES-256-GCM 密文（iv:tag:payload），明文不落库、不回传前端；
/// 严格按 user_id 归属取用，不共享、不回落到别人的 Key，也没有环境变量回退。
model GeoProviderSetting {
  userId    String   @map("user_id") @db.VarChar(64)
  code      String   @db.VarChar(32)
  /// 模型名 / 方舟接入点（ep-xxx），空则该平台不可用
  model     String   @default("") @db.VarChar(128)
  /// 接口地址覆盖，空则用平台默认
  baseUrl   String   @default("") @map("base_url") @db.VarChar(255)
  keyCipher String?  @map("key_cipher") @db.Text
  updatedBy String   @default("") @map("updated_by") @db.VarChar(64)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, code])
  @@index([userId])
  @@map("geo_provider_settings")
}

/// GEO 分析 · 每周自动采集任务（一个项目一周一期）：
/// 周日凌晨 02:00 窗口开跑，06:00 停；没跑完的项顺延到次日同窗口继续，直到全部有终态。
model GeoCollectRun {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  /// 本期归属周的周日 00:00（本地时区），一个项目一周只有一期
  weekStart   DateTime  @map("week_start")
  /// 期次标签（如 2026-W39），同时作为自动批次的 period_label
  periodLabel String    @map("period_label") @db.VarChar(64)
  /// PENDING 已排期待跑 | RUNNING 窗口内执行中 | DONE 本期收口（含部分失败）| CANCELLED 关停自动采集
  status      String    @default("PENDING") @db.VarChar(16)
  /// 计划项数（ACTIVE 问题 × 可用平台）/ 已落观测 / 重试耗尽
  planned     Int       @default(0)
  done        Int       @default(0)
  failed      Int       @default(0)
  /// 本期自动建出的采集批次（0 = 尚未建）
  batchId     Int       @default(0) @map("batch_id")
  /// 首次开跑 / 全部终态时间
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  /// 当前这次窗口的起止（周日晚 02:00–06:00，顺延日为次日同窗口）
  windowStart DateTime? @map("window_start")
  windowEnd   DateTime? @map("window_end")
  /// 多实例防重复：执行实例标识 + 心跳（RUNNING 且心跳过期才能被其它实例接管）
  claimedBy   String    @default("") @map("claimed_by") @db.VarChar(64)
  heartbeatAt DateTime? @map("heartbeat_at")
  /// 最近一次窗口级错误（如全平台密钥缺失），供管理端排查
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, weekStart])
  @@index([status])
  @@index([weekStart])
  @@map("geo_collect_runs")
}

/// GEO 分析 · 自动采集逐项明细（问题 × 平台一条）：
/// 先向该平台提问（原始回答存 rawAnswer，解析失败可只重解析不重复计费），
/// 再用豆包解析成观测字段，直接落真实观测并把 observationId 记回本行。
model GeoCollectItem {
  id            Int       @id @default(autoincrement())
  runId         Int       @map("run_id")
  projectId     Int       @map("project_id")
  questionId    Int       @map("question_id")
  platform      String    @db.VarChar(32)
  /// PENDING 待采 | DONE 已落观测 | FAILED 重试耗尽
  status        String    @default("PENDING") @db.VarChar(16)
  attempts      Int       @default(0)
  /// 最近一次错误（平台报错 / 解析失败 / 超时）
  error         String    @default("") @db.VarChar(500)
  observationId Int       @default(0) @map("observation_id")
  /// 采集平台本次回答所用模型（观测的 model_version 取此值）
  modelVersion  String    @default("") @map("model_version") @db.VarChar(64)
  /// 平台原始回答（留档：解析失败时复用它重试，不再重复提问；NULL = 尚未拿到回答）
  rawAnswer     String?   @map("raw_answer") @db.Text
  answeredAt    DateTime? @map("answered_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([runId, questionId, platform])
  @@index([runId, status])
  @@map("geo_collect_items")
}

/// Atomic per-day document sequences. Initialized from the maximum existing document number.
model DocumentCounter {
  key   String @id @db.VarChar(32)
  value Int

  @@map("document_counters")
}

// ---------------------------------------------------------------------------
// 自动化工具：多维表格 / RPA / Workbuddy 企业版 / AI 调用账号
// 归属口径：全部按「账号」（createdBy / userId）归属，不挂企业档案。
// ---------------------------------------------------------------------------

model DataTable {
  id          Int      @id @default(autoincrement())
  /// 归属账号：建表人即归属人，结构与授权只归他管
  createdBy   String   @map("created_by") @db.VarChar(64)
  name        String   @db.VarChar(200)
  description String   @default("") @db.VarChar(500)
  /// 内建应用实体表：>0 表示由低代码实体创建，归属项目
  projectId   Int      @default(0) @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([projectId])
  @@map("data_tables")
}

model DataTableGrant {
  id            Int      @id @default(autoincrement())
  tableId       Int      @map("table_id")
  /// 被授权账号（必须是归属人的旗下成员）
  granteeUserId String   @map("grantee_user_id") @db.VarChar(64)
  canRead       Boolean  @default(false) @map("can_read")
  canCreate     Boolean  @default(false) @map("can_create")
  canUpdate     Boolean  @default(false) @map("can_update")
  canDelete     Boolean  @default(false) @map("can_delete")
  grantedBy     String   @map("granted_by") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tableId, granteeUserId])
  @@index([granteeUserId])
  @@map("data_table_grants")
}

model DataTableField {
  id        Int      @id @default(autoincrement())
  tableId   Int      @map("table_id")
  /// 列名（界面表头，可改）
  name      String   @db.VarChar(200)
  /// 列键：小写字母/数字/下划线，表内唯一，同时是行数据 JSON 的键
  fieldKey  String   @map("field_key") @db.VarChar(64)
  /// 列类型：text / number / boolean / date / url / email / json / select
  fieldType String   @default("text") @map("field_type") @db.VarChar(16)
  /// 列序（「字段排序」按全量列顺序提交后重排）
  sortOrder Int      @default(0) @map("sort_order")
  /// 类型专属配置：select ＝ { "choices": ["…"] }
  options   Json     @default("{}")
  required  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tableId, fieldKey])
  @@index([tableId, sortOrder])
  @@map("data_table_fields")
}

model DataTableRow {
  id        Int      @id @default(autoincrement())
  tableId   Int      @map("table_id")
  /// 行数据：{ 列键: 值 }
  data      Json
  createdBy String   @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tableId, createdAt])
  @@map("data_table_rows")
}

/// 表格视图：一张表可存多个视图（网格 / 看板 / 汇总），与列定义、行数据共用一份。
/// 视图只影响呈现，不改数据；看板按某个单选列分组，汇总按数字列做合计。
model DataTableView {
  id        Int      @id @default(autoincrement())
  tableId   Int      @map("table_id")
  createdBy String   @map("created_by") @db.VarChar(64)
  name      String   @db.VarChar(200)
  /// GRID | KANBAN | DASHBOARD
  type      String   @default("GRID") @db.VarChar(16)
  /// 视图配置：看板＝{ groupBy }，汇总＝{ metrics:[{key,agg}] }，网格＝{ filters, sort }
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tableId, createdAt])
  @@map("data_table_views")
}

/// 多维表格 ↔ 飞书多维表格同步绑定：表归属账号配置，凭据 AES-256-GCM 密文落库。
/// 一个本地表可绑多个飞书表；方向 pull（飞书→本地）/ push（本地→飞书）/ both（双向）。
model DataTableFeishuSync {
  id                Int       @id @default(autoincrement())
  tableId           Int       @map("table_id")
  createdBy         String    @map("created_by") @db.VarChar(64)
  /// pull | push | both
  direction         String    @default("both") @db.VarChar(16)
  /// 飞书自建应用 App ID
  appId             String    @map("app_id") @db.VarChar(128)
  /// App Secret 密文：base64(iv):base64(tag):base64(payload)
  appSecretCipher   String    @map("app_secret_cipher") @db.Text
  /// 飞书多维表格 app_token（表格 URL「/base/」后的串）
  appToken          String    @map("app_token") @db.VarChar(191)
  /// 飞书数据表 table_id（tbl 开头）
  feishuTableId     String    @map("feishu_table_id") @db.VarChar(191)
  /// 事件订阅 Verification Token（可空；填了则回调报文必须带同值）
  verificationToken String    @default("") @map("verification_token") @db.VarChar(191)
  /// 事件订阅 Encrypt Key 密文（可空；填了则回调报文加密）
  encryptKeyCipher  String    @default("") @map("encrypt_key_cipher") @db.Text
  /// 字段映射：[{ localKey, feishuName }]
  fieldMapping      Json      @default("[]") @map("field_mapping")
  /// active | paused
  status            String    @default("active") @db.VarChar(16)
  /// 回调路径里的随机串（每个绑定唯一，用来定位是哪个绑定）
  webhookToken      String    @unique @map("webhook_token") @db.VarChar(64)
  lastSyncAt        DateTime? @map("last_sync_at")
  lastError         String    @default("") @map("last_error") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tableId])
  @@index([appToken, feishuTableId])
  @@map("data_table_feishu_syncs")
}

/// 本地行 ↔ 飞书记录 的对应关系（双向同步定位与「哪边更新」判定）。
model DataTableFeishuRowLink {
  id              Int       @id @default(autoincrement())
  syncId          Int       @map("sync_id")
  localRowId      Int       @map("local_row_id")
  feishuRecordId  String    @map("feishu_record_id") @db.VarChar(191)
  /// 上一次同步时的两侧时间戳；本地较新则推、飞书较新则拉
  localUpdatedAt  DateTime? @map("local_updated_at")
  feishuUpdatedAt DateTime? @map("feishu_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([syncId, localRowId])
  @@unique([syncId, feishuRecordId])
  @@index([syncId])
  @@map("data_table_feishu_row_links")
}

/// 同步执行记录（界面「同步记录」；每个绑定只保留最近 50 条）。
model DataTableFeishuSyncLog {
  id        Int      @id @default(autoincrement())
  syncId    Int      @map("sync_id")
  /// pull | push | webhook
  trigger   String   @db.VarChar(16)
  /// success | failed
  status    String   @db.VarChar(16)
  /// 计数：{ pulled, pushed, created, updated, deleted, skipped }
  stats     Json     @default("{}")
  message   String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([syncId, createdAt])
  @@map("data_table_feishu_sync_logs")
}

model RpaScript {
  id           Int      @id @default(autoincrement())
  createdBy    String   @map("created_by") @db.VarChar(64)
  name         String   @db.VarChar(200)
  description  String   @default("") @db.VarChar(500)
  /// 业务分组（自由文本，界面按它归类）
  category     String   @default("") @db.VarChar(64)
  tags         Json     @default("[]")
  /// 目标设备：pc（比特浏览器窗口）| android（安卓云手机）| iphone（iPhone 云手机）
  deviceType   String   @default("pc") @map("device_type") @db.VarChar(16)
  /// 脚本类型，取值按设备收窄：pc＝automa_json|bitbrowser_rpa|javascript|python，android＝bitphone_json|javascript|python，iphone＝javascript|python
  fileType     String   @default("automa_json") @map("file_type") @db.VarChar(24)
  /// 厂商侧流程 ID：pc 的 bitbrowser_rpa 存比特浏览器 RPA 任务 ID（POST /rpa/run 的 id），android 的 bitphone_json 存云手机 RPA 流程 ID
  vendorFlowId String   @default("") @map("vendor_flow_id") @db.VarChar(64)
  /// 生命周期：draft | testing | published | archived
  status       String   @default("draft") @db.VarChar(16)
  /// 脚本正文，任务认领时原样交给本地执行器
  content      String   @db.Text
  /// 运行参数定义：{ 参数键: { label, required, default } }，新建任务按它渲染输入并校验必填
  paramsSchema Json     @default("{}") @map("params_schema")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([createdBy, fileType])
  @@index([createdBy, status])
  @@index([createdBy, deviceType, status])
  @@map("rpa_scripts")
}

model RpaAccount {
  id                  Int       @id @default(autoincrement())
  createdBy           String    @map("created_by") @db.VarChar(64)
  /// 目标平台 URL（比特浏览器 /browser/add 的 platform 字段），如 https://www.facebook.com
  platform            String    @db.VarChar(500)
  /// 比特浏览器分组 ID（/browser/add 的 groupId）或云手机分组 ID
  groupId             String    @default("") @map("group_id") @db.VarChar(128)
  nickname            String    @default("") @db.VarChar(128)
  username            String    @db.VarChar(191)
  /// 登录口令密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM
  keyCipher           String    @map("key_cipher") @db.Text
  loginUrl            String    @default("") @map("login_url") @db.VarChar(500)
  /// 云手机计费方式（对齐比特浏览器 envType）：0＝套餐计费，1＝按时计费
  envType             Int       @default(1) @map("env_type")
  /// active | disabled | banned | pending
  status              String    @default("active") @db.VarChar(16)
  /// 代理方式（对齐比特浏览器 proxyMethod）：2＝自定义代理，3＝提取 IP
  proxyMethod         Int       @default(2) @map("proxy_method")
  /// 代理类型（对齐比特浏览器 proxyType）：noproxy / http / https / socks5 / ssh
  proxyType           String    @default("noproxy") @map("proxy_type") @db.VarChar(16)
  proxyHost           String    @default("") @map("proxy_host") @db.VarChar(255)
  proxyPort           Int       @default(0) @map("proxy_port")
  proxyUserName       String    @default("") @map("proxy_user_name") @db.VarChar(200)
  /// 代理口令密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM；只有任务派发链路解密
  proxyPasswordCipher String    @default("") @map("proxy_password_cipher") @db.Text
  notes               String    @default("") @db.VarChar(500)
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([createdBy, platform])
  @@map("rpa_accounts")
}

model RpaTask {
  id                Int       @id @default(autoincrement())
  createdBy         String    @map("created_by") @db.VarChar(64)
  name              String    @db.VarChar(200)
  /// 绑定的脚本；被任务引用的脚本禁止删除
  scriptId          Int       @map("script_id")
  /// 运行设备：创建时由绑定脚本带出并与脚本一致，pc | android | iphone
  deviceType        String    @default("pc") @map("device_type") @db.VarChar(16)
  /// 绑定的 RPA 账号 ID 数组
  accountIds        Json      @default("[]") @map("account_ids")
  /// 运行参数：{ 参数键: 值 }，按脚本 paramsSchema 校验必填
  params            Json      @default("{}")
  /// pending | running | completed | failed | cancelled
  status            String    @default("pending") @db.VarChar(16)
  /// once | scheduled | recurring
  scheduleType      String    @default("once") @map("schedule_type") @db.VarChar(16)
  /// 排期配置：{ freq, time "HH:MM", weekdays [1-7], day, tz_offset }
  scheduleConfig    Json      @default("{}") @map("schedule_config")
  /// 手机任务跑完后的动作：keep（保持开机）| shutdown（关机）| suspend（挂起）；pc 任务固定 keep
  phoneFinishAction String    @default("keep") @map("phone_finish_action") @db.VarChar(16)
  scheduledAt       DateTime? @map("scheduled_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  lastRunAt         DateTime? @map("last_run_at")
  /// 最近一次失败原因（来自执行回传或超时判定）
  lastError         String    @default("") @map("last_error") @db.VarChar(500)
  maxRetries        Int       @default(0) @map("max_retries")
  /// 超过该时长仍未回传结果的执行判为 timeout，任务自动退回 pending 供重新认领
  timeoutSeconds    Int       @default(3600) @map("timeout_seconds")
  /// deviceType=chrome 时绑定的本地 Chrome 设备号（RpaChromeDevice.clientId）；其他设备固定空串
  chromeClientId    String    @default("") @map("chrome_client_id") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([createdBy, deviceType, status])
  @@index([scriptId])
  @@map("rpa_tasks")
}

model RpaTaskExecution {
  id               Int       @id @default(autoincrement())
  taskId           Int       @map("task_id")
  /// 任务归属账号，冗余一份让机器通道能按 Key 直接收窄可见范围
  createdBy        String    @map("created_by") @db.VarChar(64)
  /// 设备类型快照（pc | android | iphone）：任务改绑不影响历史记录，报表按它分设备统计
  deviceType       String    @default("pc") @map("device_type") @db.VarChar(16)
  /// running | success | failed | cancelled | timeout
  status           String    @default("running") @db.VarChar(16)
  attempt          Int       @default(1)
  /// 执行端标识（比特浏览器窗口 ID 或本机名），认领时由执行器带上
  executor         String    @default("") @db.VarChar(64)
  /// 本次执行用的比特浏览器窗口 ID（PC 任务，执行时动态创建）
  browserProfileId String    @default("") @map("browser_profile_id") @db.VarChar(64)
  /// 本次执行用的云手机环境 ID（云手机任务，执行时动态创建）
  cloudPhoneId     String    @default("") @map("cloud_phone_id") @db.VarChar(64)
  output           Json      @default("{}")
  errorMessage     String    @default("") @map("error_message") @db.VarChar(500)
  logText          String    @default("") @map("log_text") @db.Text
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  durationMs       Int?      @map("duration_ms")

  @@index([taskId, startedAt])
  @@index([createdBy, status])
  @@map("rpa_task_executions")
}

model RpaLlmSetting {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  /// 历史按模块存的模型 Key 密文：保留存量，不再读写；平台 Key 统一走 Java 侧 sk_
  keyCipher String?  @map("key_cipher") @db.Text
  model     String   @default("") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rpa_llm_settings")
}

model RpaSetting {
  id                     Int      @id @default(autoincrement())
  createdBy              String   @unique @map("created_by") @db.VarChar(64)
  /// 比特浏览器 API 地址（执行端本地地址，如 http://127.0.0.1:54345）
  bitbrowserApiEndpoint  String   @default("http://127.0.0.1:54345") @map("bitbrowser_api_endpoint") @db.VarChar(500)
  /// 比特浏览器 API Key（可选，加密存储）
  bitbrowserApiKeyCipher String   @default("") @map("bitbrowser_api_key_cipher") @db.Text
  /// 默认分组 ID（账号不填时用这个，从 /group/list 获取）
  bitbrowserGroupId      String   @default("") @map("bitbrowser_group_id") @db.VarChar(128)
  /// 云手机默认区域 ID（从 /phone/region/list 获取）
  bitphoneRegionId       String   @default("") @map("bitphone_region_id") @db.VarChar(64)
  /// 云手机默认配置（如 standard / high，从 /phone/compute/list 获取）
  bitphoneComputeType    String   @default("") @map("bitphone_compute_type") @db.VarChar(64)
  /// 本地 Chrome 插件 RPA 的设置（maxSteps / 超时 / 黑名单 / 敏感确认 / 截图保留天数），JSON 存
  chromeSettings         Json     @default("{}") @map("chrome_settings")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("rpa_settings")
}

/// 本地 Chrome 插件设备（docs/本地Chrome插件RPA控制方案.md §5.1）：插件用本站账号登录后
/// 成为该用户名下的一台设备，心跳维持在线，云端据此下发动作指令。令牌只存 sha256 哈希。
model RpaChromeDevice {
  id               Int       @id @default(autoincrement())
  /// 归属用户（本站账户 userId）
  createdBy        String    @map("created_by") @db.VarChar(64)
  /// 插件本地生成的稳定设备号（安装时 uuid，重装即换）
  clientId         String    @map("client_id") @db.VarChar(64)
  /// 设备显示名（默认「Chrome · 主机名」）
  name             String    @default("") @db.VarChar(80)
  /// 登录时用的本站域（校验插件确实连的是同一套系统）
  domain           String    @default("") @db.VarChar(200)
  /// 设备令牌哈希：sha256(明文)；明文只在登录响应里出现一次
  tokenHash        String    @map("token_hash") @db.VarChar(64)
  extensionVersion String    @default("") @map("extension_version") @db.VarChar(24)
  /// ONLINE | DISABLED（OFFLINE 由心跳超时折算，不落库）
  status           String    @default("ONLINE") @db.VarChar(16)
  /// 插件最近一次心跳回报的打开页面 [{ tabId, url, title }]，仅界面展示
  pages            Json      @default("[]")
  lastSeenAt       DateTime? @map("last_seen_at")
  lastIp           String    @default("") @map("last_ip") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([createdBy, clientId])
  @@index([createdBy, status])
  @@map("rpa_chrome_devices")
}

/// 云端 → 插件的动作指令队列：心跳顺带领取，按 commandCode 幂等回执。
/// 敏感动作先进 PENDING_CONFIRM，等本人在插件弹窗点「允许本次」再转 DISPATCHED。
model RpaChromeCommand {
  id           Int       @id @default(autoincrement())
  createdBy    String    @map("created_by") @db.VarChar(64)
  clientId     String    @map("client_id") @db.VarChar(64)
  sessionId    Int       @default(0) @map("session_id")
  stepIndex    Int       @default(0) @map("step_index")
  /// 服务端生成的指令码，插件回执按它幂等（唯一）
  commandCode  String    @unique @map("command_code") @db.VarChar(40)
  /// 闭集动作（契约 RC_ACTIONS）及其参数
  action       Json      @default("{}")
  /// PENDING | DISPATCHED | PENDING_CONFIRM | DONE | FAILED | TIMEOUT | CANCELLED
  status       String    @default("PENDING") @db.VarChar(16)
  /// 敏感确认状态：NONE | PENDING | ALLOWED | DENIED
  confirmState String    @default("NONE") @map("confirm_state") @db.VarChar(16)
  /// 插件回执：{ ok, data, errorMessage, elapsedMs, code }
  result       Json      @default("{}")
  dispatchedAt DateTime? @map("dispatched_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([clientId, status, id])
  @@index([sessionId, stepIndex])
  @@map("rpa_chrome_commands")
}

/// 一次「本地 Chrome 自动操作」会话：goal（自然语言）→ 云端 LLM 逐步决策 → 插件执行并回观测。
/// 也可带确定性动作序列（script），此时逐步回放、不调 LLM。
model RpaChromeSession {
  id           Int       @id @default(autoincrement())
  createdBy    String    @map("created_by") @db.VarChar(64)
  clientId     String    @map("client_id") @db.VarChar(64)
  /// 关联的 RPA 任务 ID（页面直接开会话时为 0）
  taskId       Int       @default(0) @map("task_id")
  /// 由任务发起的会话对应的执行记录 ID（直接开会话时为 0）；收尾时按它回写 RpaTaskExecution
  executionId  Int       @default(0) @map("execution_id")
  goal         String    @db.Text
  startUrl     String    @default("") @map("start_url") @db.VarChar(2000)
  /// 能力档：act 操作 / crawl 顺链接批量抓取 / extract 抽取结构化结果
  mode         String    @default("act") @db.VarChar(16)
  /// RUNNING | WAITING_CONFIRM | PAUSED | COMPLETED | FAILED | CANCELLED | TIMEOUT
  status       String    @default("RUNNING") @db.VarChar(16)
  stepCount    Int       @default(0) @map("step_count")
  maxSteps     Int       @default(25) @map("max_steps")
  /// 决策用模型（确定性回放时为空）
  model        String    @default("") @db.VarChar(128)
  /// 结束原因：done | max_steps | no_action | offline | timeout | stopped | error
  stopReason   String    @default("") @map("stop_reason") @db.VarChar(32)
  errorMessage String    @default("") @map("error_message") @db.VarChar(500)
  /// 确定性动作序列（给出时逐步回放，不走 LLM、不产生 AI 积分）
  script       Json      @default("[]")
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status, createdAt])
  @@index([clientId, status])
  @@map("rpa_chrome_sessions")
}

/// 会话的每一步：动作 + LLM 思考 + 页面观测（页面地图/截图）留痕，供界面回放与审计。
model RpaChromeStep {
  id            Int      @id @default(autoincrement())
  sessionId     Int      @map("session_id")
  createdBy     String   @map("created_by") @db.VarChar(64)
  stepIndex     Int      @map("step_index")
  commandCode   String   @default("") @map("command_code") @db.VarChar(40)
  action        Json     @default("{}")
  /// LLM 决策理由（确定性回放时为空）
  thought       String   @default("") @db.VarChar(1000)
  /// 动作后的页面观测（页面地图 + 元素 + 截图 key），供 LLM 下一步决策
  observation   Json     @default("{}")
  /// 截图对象存储 key（保留 N 天，超期清理）
  screenshotKey String   @default("") @map("screenshot_key") @db.VarChar(200)
  /// RUNNING | DONE | FAILED | TIMEOUT | CANCELLED
  status        String   @default("RUNNING") @db.VarChar(16)
  elapsedMs     Int      @default(0) @map("elapsed_ms")
  errorMessage  String   @default("") @map("error_message") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, stepIndex])
  @@index([sessionId, createdAt])
  @@map("rpa_chrome_steps")
}

/// 浏览器代理会话（docs/浏览器代理插件升级方案.md）：侧边栏 Agent 的编排在插件侧，
/// 云端只存台账与消息流，用于跨设备查看、审计与额度对账。
model RpaChromeAgent {
  id            Int       @id @default(autoincrement())
  createdBy     String    @map("created_by") @db.VarChar(64)
  clientId      String    @map("client_id") @db.VarChar(64)
  /// 插件侧生成的会话本地号（同一设备内稳定），用于幂等 upsert
  clientAgentId String    @default("") @map("client_agent_id") @db.VarChar(64)
  /// act | crawl | extract
  mode          String    @default("act") @db.VarChar(16)
  goal          String    @db.Text
  /// RUNNING | WAITING_CONFIRM | PAUSED | COMPLETED | FAILED | CANCELLED | TIMEOUT
  status        String    @default("RUNNING") @db.VarChar(16)
  stepCount     Int       @default(0) @map("step_count")
  maxSteps      Int       @default(25) @map("max_steps")
  model         String    @default("") @db.VarChar(128)
  /// 本会话累计消耗（先时长卡后积分，与站内 AI 用量同口径）
  credits       Int       @default(0)
  stopReason    String    @default("") @map("stop_reason") @db.VarChar(32)
  errorMessage  String    @default("") @map("error_message") @db.VarChar(500)
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([createdBy, clientId, clientAgentId])
  @@index([createdBy, status, createdAt])
  @@map("rpa_chrome_agents")
}

/// 代理会话消息流：一条卡片一行（思考 / 动作 / 工具 / 结果 / 截图 / 错误 / 追问）。
model RpaChromeMessage {
  id            Int      @id @default(autoincrement())
  agentId       Int      @map("agent_id")
  createdBy     String   @map("created_by") @db.VarChar(64)
  /// 会话内自增序号（界面排序与断点续传的锚点）
  seq           Int      @default(0)
  role          String   @default("agent") @db.VarChar(16)
  kind          String   @default("text") @db.VarChar(16)
  content       String   @default("") @db.Text
  /// 卡片结构化内容（动作参数 / 工具入参回执 / 结果表格）
  payload       Json     @default("{}")
  screenshotKey String   @default("") @map("screenshot_key") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([agentId, seq])
  @@index([agentId, createdAt])
  @@map("rpa_chrome_messages")
}

/// 插件侧沉淀的技能（personal 个人偏好/工作流 / site 站点操作知识）；site 默认本账号私有。
model RpaChromeSkill {
  id          Int      @id @default(autoincrement())
  createdBy   String   @map("created_by") @db.VarChar(64)
  name        String   @db.VarChar(120)
  /// personal | site
  kind        String   @default("personal") @db.VarChar(16)
  description String   @default("") @db.VarChar(500)
  /// markdown 正文
  content     String   @db.Text
  /// site 类技能的归属站点（hostname）；personal 为空
  site        String   @default("") @db.VarChar(200)
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([createdBy, name])
  @@index([createdBy, kind, updatedAt])
  @@map("rpa_chrome_skills")
}

/// 录制 → 生成的可复用工具：一次成功操作沉淀为闭集动作序列（chrome_actions）。
model RpaChromeRecording {
  id        Int      @id @default(autoincrement())
  createdBy String   @map("created_by") @db.VarChar(64)
  name      String   @db.VarChar(120)
  site      String   @default("") @db.VarChar(200)
  actions   Json     @default("[]")
  stepCount Int      @default(0) @map("step_count")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([createdBy, name])
  @@index([createdBy, updatedAt])
  @@map("rpa_chrome_recordings")
}

/// 抽取结果：一次 Extract 的结构化产物（落库供导出/投递），按会话归属个人。
model RpaChromeExtract {
  id            Int      @id @default(autoincrement())
  createdBy     String   @map("created_by") @db.VarChar(64)
  agentId       Int      @default(0) @map("agent_id")
  url           String   @default("") @db.VarChar(2000)
  /// 抽取口径说明（要了哪些字段 / 怎么抽的）
  schemaNote    String   @default("") @map("schema_note") @db.VarChar(2000)
  data          Json     @default("{}")
  rows          Json     @default("[]")
  screenshotKey String   @default("") @map("screenshot_key") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdBy, agentId, createdAt])
  @@map("rpa_chrome_extracts")
}

/// 浏览器代理的计划任务：到点让本人某台在线设备按同一套会话引擎跑一个目标。
/// 绿灯闸——设备离线（插件没开）当轮跳过，不排队补跑；账号停用即自动暂停（isStanding 复权）。
model RpaChromeSchedule {
  id             Int       @id @default(autoincrement())
  createdBy      String    @map("created_by") @db.VarChar(64)
  /// 目标设备号；执行时按它取在线设备，离线即跳过本轮
  clientId       String    @default("") @map("client_id") @db.VarChar(64)
  title          String    @db.VarChar(80)
  /// 每轮交给会话引擎的一句话目标（自包含，不看历史）
  goal           String    @db.Text
  /// 能力档：act 操作 / crawl 顺链接批量抓取 / extract 抽取结构化结果
  mode           String    @default("act") @db.VarChar(16)
  startUrl       String    @default("") @map("start_url") @db.VarChar(2000)
  /// 确定性动作序列：给了就逐步回放（不走 LLM），空则走 LLM 决策
  script         Json      @default("[]")
  /// 决策用模型（空＝「模型设置」默认文本槽位）
  model          String    @default("") @db.VarChar(128)
  maxSteps       Int       @default(25) @map("max_steps")
  /// scheduled＝定时一次；recurring＝周期重复（计划任务不允许 once）
  scheduleType   String    @default("recurring") @map("schedule_type") @db.VarChar(16)
  scheduleConfig Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻；定时一次跑完即置空
  scheduledAt    DateTime? @map("scheduled_at")
  /// enabled | paused
  status         String    @default("enabled") @db.VarChar(16)
  lastRunAt      DateTime? @map("last_run_at")
  /// 最近一次结果：running | succeeded | failed | skipped；空串＝还没跑过
  lastStatus     String    @default("") @map("last_status") @db.VarChar(16)
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  /// 最近一次执行产生的会话 id（0＝无），界面据此查看结果
  lastSessionId  Int       @default(0) @map("last_session_id")
  runCount       Int       @default(0) @map("run_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([status, scheduleType, scheduledAt])
  @@map("rpa_chrome_schedules")
}

model WorkbuddyAccount {
  id              Int                    @id @default(autoincrement())
  createdBy       String                 @map("created_by") @db.VarChar(64)
  /// 用户自己起的名，便于在派发时区分「哪把 key」
  name            String                 @db.VarChar(128)
  secretIdCipher  String                 @map("secret_id_cipher") @db.Text
  secretKeyCipher String                 @map("secret_key_cipher") @db.Text
  /// 资源所在地域（API Explorer 按地域选，如 ap-beijing / ap-nanjing）；所有接口本身不强制 Region
  region          String                 @default("ap-guangzhou") @db.VarChar(32)
  /// active | disabled：停用后不再参与派发，历史任务与消息保留
  status          String                 @default("active") @db.VarChar(16)
  /// 最近一次「连通性校验」成功时间（DescribeAgentList 实调通过才更新）
  lastVerifiedAt  DateTime?              @map("last_verified_at")
  /// 校验失败原因，界面提示用
  lastError       String                 @default("") @map("last_error") @db.VarChar(500)
  notes           String                 @default("") @db.VarChar(500)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  aiCallBindings  AiCallAccountBinding[]

  @@index([createdBy, status])
  @@map("workbuddy_accounts")
}

model WorkbuddyLlmSetting {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  /// 历史按模块存的模型 Key 密文：保留存量，不再读写；平台 Key 统一走 Java 侧 sk_
  keyCipher String?  @map("key_cipher") @db.Text
  model     String   @default("") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workbuddy_llm_settings")
}

model WorkbuddyPlan {
  id             Int       @id @default(autoincrement())
  createdBy      String    @map("created_by") @db.VarChar(64)
  /// 新建方式：ai＝和 AI 沟通分析并确定任务；direct＝明确生成任务；scheduled＝定时任务
  kind           String    @default("ai") @db.VarChar(16)
  title          String    @db.VarChar(200)
  /// 用户原始表述（含多轮澄清的完整对话），回看与重新拆解用
  rawInput       String    @default("") @map("raw_input") @db.Text
  /// 澄清后的任务书：{ goal, steps[], deliverable, acceptance }
  spec           Json      @default("{}")
  /// 拆解出的执行任务数（0 = 还没拆）
  taskCount      Int       @default(0) @map("task_count")
  /// 派发方式：single（单账号）| fan_out（多账号并行，一份任务书各跑一遍）
  strategy       String    @default("single") @db.VarChar(16)
  /// 参与的 Workbuddy 账号 ID 数组（fan_out 时多于 1 个）
  accountIds     Json      @default("[]") @map("account_ids")
  /// 排期方式：once＝不排期；scheduled＝定时一次；recurring＝周期重复（与 RPA 任务同一套字段口径）
  scheduleType   String    @default("once") @map("schedule_type") @db.VarChar(16)
  /// 周期重复配置：{ freq, time, weekdays, day, minute }
  scheduleConfig Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻（定时一次＝用户选的时间；周期重复＝调度器推算出来的下一轮）
  scheduledAt    DateTime? @map("scheduled_at")
  /// draft | clarifying | ready | running | succeeded | failed | cancelled
  status         String    @default("draft") @db.VarChar(16)
  /// 汇总产出（跑完后由各任务结果收口）
  summary        String    @default("") @db.Text
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([createdBy, kind])
  @@index([kind, scheduleType, scheduledAt])
  @@map("workbuddy_plans")
}

model WorkbuddyTask {
  id           Int       @id @default(autoincrement())
  planId       Int       @map("plan_id")
  createdBy    String    @map("created_by") @db.VarChar(64)
  /// 任务类型，跟随所属计划：ai | direct | scheduled（列表按它筛选）
  kind         String    @default("ai") @db.VarChar(16)
  /// 计划内序号，界面按它排序
  seq          Int       @default(1)
  /// 派发用的 Workbuddy 账号（腾讯云凭据），执行期只在这条链路上解密
  accountId    Int       @map("account_id")
  /// 远程 Agent ID / 版本 ID（腾讯云侧主键，字符串）
  agentId      String    @default("") @map("agent_id") @db.VarChar(64)
  versionId    String    @default("") @map("version_id") @db.VarChar(64)
  /// CreateAgentSession 回传的会话 ID 与聊天入口（执行走会话端点，不是 OpenAPI）
  sessionId    String    @default("") @map("session_id") @db.VarChar(128)
  endpoint     String    @default("") @db.VarChar(500)
  /// 本次要交给 Agent 的完整指令（任务书里分给这一段的内容）
  instruction  String    @default("") @db.Text
  /// pending | running | succeeded | failed | cancelled
  status       String    @default("pending") @db.VarChar(16)
  /// 已同步到的消息事件水位（DescribeMessageEventList 的最后一个 seq）
  lastEventSeq Int       @default(0) @map("last_event_seq")
  output       Json      @default("{}")
  lastError    String    @default("") @map("last_error") @db.VarChar(500)
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([planId])
  @@index([createdBy, status])
  @@index([accountId])
  @@map("workbuddy_tasks")
}

model WorkbuddyTaskEvent {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  /// 腾讯云侧事件序号，唯一约束保证重复轮询不写两遍
  seq        Int
  /// user | tool | assistant
  eventType  String   @map("event_type") @db.VarChar(16)
  content    String   @default("") @db.Text
  toolName   String   @default("") @map("tool_name") @db.VarChar(128)
  toolInput  String   @default("") @map("tool_input") @db.Text
  toolOutput String   @default("") @map("tool_output") @db.Text
  /// TokenUsage：{ input, output, total }
  tokenUsage Json     @default("{}") @map("token_usage")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@unique([taskId, seq])
  @@map("workbuddy_task_events")
}

model AiCallAccount {
  id             Int                    @id @default(autoincrement())
  createdBy      String                 @map("created_by") @db.VarChar(64)
  /// 便于在任务里认出「用哪个账号」
