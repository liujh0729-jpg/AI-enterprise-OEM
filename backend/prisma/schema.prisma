// ---------------------------------------------------------------------------
// 附录 B 补齐（2026-11-07）：权益配额 / 预约忙闲 / 邮件模板 / 页面助手 /
// 语音转写 / 工时审计 / 商城三点 / 三方同步 / 条款留痕 / 入职引导 /
// 产品更新日志 / 主体切换 / 使用埋点。
// 组织域一律带 (orgType, orgUserId)；表间引用用普通 INT 列，级联在服务层做。
// ---------------------------------------------------------------------------

/// 套餐目录（B1#2）：套餐本身是数据，功能可用性与数量上限写在 EntitlementQuota
model EntitlementPlan {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(32)
  name         String   @db.VarChar(64)
  /// USER 个人版 | ENTERPRISE 企业版 | PROVIDER 服务商版
  audience     String   @default("ENTERPRISE") @db.VarChar(16)
  description  String   @default("") @db.VarChar(500)
  priceMonthly Decimal  @default(0) @map("price_monthly") @db.Decimal(18, 2)
  /// ACTIVE | ARCHIVED
  status       String   @default("ACTIVE") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([audience, status])
  @@map("entitlement_plans")
}

/// 套餐权益明细：featureCode 对应 FeatureCatalog.code；limitCount=-1 表示不限
model EntitlementQuota {
  id          Int      @id @default(autoincrement())
  planCode    String   @map("plan_code") @db.VarChar(32)
  featureCode String   @map("feature_code") @db.VarChar(64)
  /// allowed | denied
  access      String   @default("allowed") @db.VarChar(8)
  limitCount  Int      @default(-1) @map("limit_count")
  /// 计数单位（人 / 次 / GB / 个项目）
  unit        String   @default("") @db.VarChar(16)
  note        String   @default("") @db.VarChar(200)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([planCode, featureCode], map: "entitlement_quotas_plan_feature_key")
  @@map("entitlement_quotas")
}

/// 组织当前套餐（手动指定；无行时按 audience 取平台默认套餐）
model OrgEntitlement {
  id        Int       @id @default(autoincrement())
  orgType   String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId String    @map("org_user_id") @db.VarChar(64)
  planCode  String    @map("plan_code") @db.VarChar(32)
  /// MANUAL | DEFAULT
  source    String    @default("MANUAL") @db.VarChar(16)
  /// ACTIVE | EXPIRED
  status    String    @default("ACTIVE") @db.VarChar(16)
  startedAt DateTime  @default(now()) @map("started_at")
  expiresAt DateTime? @map("expires_at")
  updatedBy String    @default("") @map("updated_by") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId], map: "org_entitlements_org_key")
  @@index([planCode, status])
  @@map("org_entitlements")
}

/// 配额用量（按自然月）；写操作前由服务校验 limitCount，超限抛 403
model EntitlementUsage {
  id          Int      @id @default(autoincrement())
  orgType     String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
