  requestId        String   @default("") @map("request_id") @db.VarChar(64)
  refId            String   @default("") @map("ref_id") @db.VarChar(64)
  endpoint         String   @default("") @db.VarChar(64)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  /// 命中缓存的输入 tokens（上游 cache_read）
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  /// 写入缓存的输入 tokens（上游 cache_write）
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  /// 非 token 计费单位的实际用量（张 / 秒 / 次）
  billingQuantity  Decimal  @default(0) @map("billing_quantity") @db.Decimal(18, 6)
  /// 本次结算使用的计费单位
  billingUnit      String   @default("") @map("billing_unit") @db.VarChar(16)
  pointsCost       Decimal  @default(0) @map("points_cost") @db.Decimal(18, 4)
  rmbCost          Decimal  @default(0) @map("rmb_cost") @db.Decimal(18, 6)
  elapsedMs        Int      @default(0) @map("elapsed_ms")
  isStream         Boolean  @default(false) @map("is_stream")
  /// SUCCESS | FAILED
  status           String   @default("SUCCESS") @db.VarChar(16)
  message          String   @default("") @db.VarChar(200)
  /// 本次从哪张时长卡扣的额度（空＝没用到卡）
  userCardId       Int?     @map("user_card_id")
  /// 本次从卡里实际扣掉的量（单位同 billingUnit，已含规格倍率）
  cardDeduct       Decimal  @default(0) @map("card_deduct") @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([catalogId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([userCardId])
  @@map("model_usage_logs")
}

/// 智能硬件·型号（平台级目录，管理员维护）：硬件广场的卡片与工具/MCP 的归属
model HwModel {
  id        Int      @id @default(autoincrement())
  /// 型号编码（进 MCP 工具名 hw__<code>__<tool>，白名单小写字母数字连字符）
  code      String   @unique @db.VarChar(48)
  name      String   @db.VarChar(80)
  vendor    String   @default("") @db.VarChar(60)
  chip      String   @default("") @db.VarChar(60)
  category  String   @default("") @db.VarChar(40)
  summary   String   @default("") @db.VarChar(500)
  coverUrl  String   @default("") @map("cover_url") @db.VarChar(500)
  /// 能力 / 接口 / 尺寸等结构化规格
  spec      Json     @default("{}")
  featured  Boolean  @default(false)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdBy String   @default("") @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, sortOrder])
  @@map("hw_models")
}

/// 智能硬件·开发包（型号 × 版本）：管理员上传 zip，用户下载（SDK + 固件 + 文档）
model HwDevKit {
  id            Int      @id @default(autoincrement())
  modelId       Int      @map("model_id")
  version       String   @db.VarChar(40)
  /// STABLE | BETA
  channel       String   @default("STABLE") @db.VarChar(8)
  fileName      String   @map("file_name") @db.VarChar(160)
  fileSize      Int      @default(0) @map("file_size")
  /// 对象存储完整键（StorageService 口径）
  ossKey        String   @map("oss_key") @db.VarChar(400)
  /// 上传时算出的 SHA-256，页面展示供用户校验
  sha256        String   @default("") @db.VarChar(64)
  changelog     String   @default("") @db.VarChar(1000)
  docUrl        String   @default("") @map("doc_url") @db.VarChar(500)
  minFirmware   String   @default("") @map("min_firmware") @db.VarChar(40)
  downloadCount Int      @default(0) @map("download_count")
  enabled       Boolean  @default(true)
  createdBy     String   @default("") @map("created_by") @db.VarChar(64)
