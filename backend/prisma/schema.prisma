/// 模型广场·可售模型目录：人民币价为每百万 tokens（CALL 类为每次），积分价 0＝按汇率自动换算
model ModelCatalog {
  id                 Int      @id @default(autoincrement())
  upstreamId         Int      @default(0) @map("upstream_id")
  provider           String   @default("AIPDD") @db.VarChar(24)
  modelKey           String   @map("model_key") @db.VarChar(128)
  /// 转发上游时用的真实模型名；空＝与 modelKey 相同
  upstreamModelKey   String   @default("") @map("upstream_model_key") @db.VarChar(128)
  displayName        String   @default("") @map("display_name") @db.VarChar(128)
  vendor             String   @default("") @db.VarChar(64)
  description        String   @default("") @db.VarChar(500)
  /// TOKEN | CALL（历史字段，按 billingUnit 派生）
  quotaType          String   @default("TOKEN") @map("quota_type") @db.VarChar(16)
  /// 上游计费单位：token | image | second | call（与 aipdd.pricing.billing_unit 一致）
  billingUnit        String   @default("token") @map("billing_unit") @db.VarChar(16)
  /// 能力分类：text | image | video | audio | embedding | other
  category           String   @default("text") @db.VarChar(16)
  /// 官方输入价（元 / 百万 tokens，billingUnit=token）
  inputRmbPrice      Decimal  @default(0) @map("input_rmb_price") @db.Decimal(18, 6)
  /// 官方输出价（元 / 百万 tokens，billingUnit=token）
  outputRmbPrice     Decimal  @default(0) @map("output_rmb_price") @db.Decimal(18, 6)
  /// 官方单位价（元 / 张、/ 秒、/ 次，billingUnit≠token）
  callRmbPrice       Decimal  @default(0) @map("call_rmb_price") @db.Decimal(18, 6)
  /// 官方缓存读价（元 / 百万 tokens）
  cacheReadRmbPrice  Decimal  @default(0) @map("cache_read_rmb_price") @db.Decimal(18, 6)
  /// 官方缓存写价（元 / 百万 tokens）
  cacheWriteRmbPrice Decimal  @default(0) @map("cache_write_rmb_price") @db.Decimal(18, 6)
  /// 单次最低收费（元），上游 minimum_rmb
  minimumRmb         Decimal  @default(0) @map("minimum_rmb") @db.Decimal(18, 6)
  /// 上游分档价：[{ match: { quality|size|video_resolution }, unitRmb }]
  tiers              Json?
  /// 上游附加计费：[{ code, freeUnits, unit, unitRmb, tiers }]
  components         Json?
  /// 平台折扣：0.8 = 8 折；1 = 官方原价
  discountRate       Decimal  @default(1) @map("discount_rate") @db.Decimal(6, 4)
  /// 历史积分覆写价（已停用，保留列用于兼容旧数据）
  inputPointsPrice   Decimal  @default(0) @map("input_points_price") @db.Decimal(18, 6)
  outputPointsPrice  Decimal  @default(0) @map("output_points_price") @db.Decimal(18, 6)
  callPointsPrice    Decimal  @default(0) @map("call_points_price") @db.Decimal(18, 6)
  contextWindow      Int      @default(0) @map("context_window")
  maxOutputTokens    Int      @default(0) @map("max_output_tokens")
  /// { input: ["text","image"], output: ["text"] }
  modalities         Json     @default("{}")
  /// ["/chat/completions", "/embeddings"]
  endpoints          Json     @default("[]")
  tags               Json     @default("[]")
  enabled            Boolean  @default(false)
  sort               Int      @default(0)
  remark             String   @default("") @db.VarChar(200)
  createdBy          String   @default("") @map("created_by") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([provider, modelKey])
  @@index([upstreamId])
  @@index([enabled, sort])
  @@map("model_catalog")
}

/// 模型广场·用量流水：站内试用（IN_APP）与对外 /v1 调用（API）共用一张表
model ModelUsageLog {
  id               Int      @id @default(autoincrement())
