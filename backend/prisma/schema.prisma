/// 供销网络 · 订货单（门店/企业订货 → 服务商或承办职员报价 → 企业确认/重提/否决）
model SupplyOrder {
  id                   Int       @id @default(autoincrement())
  orderNo              String    @unique @map("order_no") @db.VarChar(32)
  enterpriseId         Int       @map("enterprise_id")
  enterpriseName       String    @default("") @map("enterprise_name") @db.VarChar(200)
  createdBy            String    @map("created_by") @db.VarChar(64)
  providerUserId       String    @map("provider_user_id") @db.VarChar(64)
  /// 承办职员（服务商指派的报价/履约人；未指派时由服务商账号本人承办）
  staffUserId          String    @default("") @map("staff_user_id") @db.VarChar(64)
  stationId            Int       @map("station_id")
  stationName          String    @default("") @map("station_name") @db.VarChar(120)
  /// 订货联系人（企业侧必填，供服务商报价前后商务磋商）
  contactName          String    @default("") @map("contact_name") @db.VarChar(64)
  contactPhone         String    @default("") @map("contact_phone") @db.VarChar(32)
  /// 期望到货时间（企业必填，履约预期）
  expectedDate         String    @map("expected_date") @db.VarChar(16)
  remark               String    @default("") @db.VarChar(500)
  /// DRAFT 草稿 | SUBMITTED 已提交·待报价 | QUOTED 已报价·待确认 | ACTIVE 订单生效
  /// | RETURNED 已驳回·待重新报价 | VETOED 已否决 | CANCELLED 已取消
  status               String    @default("SUBMITTED") @db.VarChar(16)
  /// 磋商轮次（企业修改重提 / 服务商重新报价各自递增）
  revision             Int       @default(1)
  quotedAt             DateTime? @map("quoted_at")
  /// 服务商承诺发货日期
  promisedShipDate     String    @default("") @map("promised_ship_date") @db.VarChar(16)
  quoteNote            String    @default("") @map("quote_note") @db.VarChar(500)
  /// 报价联系人（服务商/承办职员报价时必填，供企业确认前后商务磋商）
  providerContactName  String    @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String    @default("") @map("provider_contact_phone") @db.VarChar(32)
  /// 商品明细合计
  productAmount        Decimal   @default(0) @map("product_amount") @db.Decimal(14, 2)
  /// 其他费用科目 [{ name, amount, note }]（正数增收 / 负数减免）
  otherFees            Json      @default("[]") @map("other_fees")
  /// 其他费用合计（含负值抵扣）
  feeAmount            Decimal   @default(0) @map("fee_amount") @db.Decimal(14, 2)
  /// 总金额 = 商品明细合计 + 其他费用合计
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// 企业确认/驳回/否决说明
  confirmNote          String    @default("") @map("confirm_note") @db.VarChar(500)
  confirmedAt          DateTime? @map("confirmed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([enterpriseId, status])
  @@index([providerUserId, status])
  @@index([staffUserId, status])
  @@index([stationId, status])
  @@map("supply_orders")
}

/// 供销网络 · 订货单明细（逐条录入，报价时可微调价格/数量并标注缺货）
model SupplyOrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  productId    Int      @map("product_id")
  skuId        Int      @default(0) @map("sku_id")
  productName  String   @map("product_name") @db.VarChar(200)
  specName     String   @default("") @map("spec_name") @db.VarChar(120)
  unit         String   @default("件") @db.VarChar(16)
  /// 报价单价（服务商可微调供货价）
  price        Decimal  @default(0) @db.Decimal(14, 2)
  /// 报价数量（服务商可微调采购数量）
  quantity     Decimal  @default(1) @db.Decimal(14, 2)
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  /// SUFFICIENT 库存充足 | PARTIAL 部分缺货 | SHORTAGE 缺货
  stockState   String   @default("SUFFICIENT") @map("stock_state") @db.VarChar(16)
  /// 缺货原因
  shortageNote String   @default("") @map("shortage_note") @db.VarChar(300)
  /// 补货周期
  restockCycle String   @default("") @map("restock_cycle") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("supply_order_items")
}

/// 供销网络 · 线下服务预约单（作业地点/体量 → 服务商报价 → 企业确认）
model SupplyBooking {
  id                   Int       @id @default(autoincrement())
  bookingNo            String    @unique @map("booking_no") @db.VarChar(32)
  enterpriseId         Int       @map("enterprise_id")
