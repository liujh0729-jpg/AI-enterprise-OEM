// ---------------------------------------------------------------------------
// 内建应用（低代码）：项目即隔离域，实体落多维表格表（data_tables.project_id），
// 权限模型在项目内独立成立（角色 → 资源权限 → 行级数据规则）。
// ---------------------------------------------------------------------------

model LowCodeProject {
  id          Int      @id @default(autoincrement())
  /// 项目创建者（项目内固定所有者）
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  /// 组织归属：ENTERPRISE / PROVIDER；空＝个人项目（仅本人可用）
  orgType     String   @default("") @map("org_type") @db.VarChar(16)
  orgUserId   String   @default("") @map("org_user_id") @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(500)
  /// 图标键（前端图标名）
  icon        String   @default("appstore") @db.VarChar(64)
  /// BLANK / OA / CRMISH / TASK / ASSET
  type        String   @default("BLANK") @db.VarChar(16)
  /// ACTIVE / ARCHIVED
  status      String   @default("ACTIVE") @db.VarChar(16)
  /// 项目设置：{ aiChannelId, aiModel, aiPrompt }
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([orgType, orgUserId])
  @@map("lowcode_projects")
}

model LowCodeProjectMember {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  memberUserId String   @map("member_user_id") @db.VarChar(64)
  /// 0 ＝ 尚未分角色（按内置 MEMBER 处理）
  roleId       Int      @default(0) @map("role_id")
  /// 成员部门快照（OA 项目取自 org_staff.department）
  department   String   @default("") @db.VarChar(100)
  title        String   @default("") @db.VarChar(100)
  /// ACTIVE / REMOVED
  status       String   @default("ACTIVE") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([projectId, memberUserId])
  @@index([memberUserId])
  @@map("lowcode_project_members")
}

model LowCodeRole {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  /// OWNER / ADMIN / MEMBER / VIEWER 或自定义键
  key         String   @db.VarChar(32)
  name        String   @db.VarChar(50)
  builtin     Boolean  @default(false)
  description String   @default("") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([projectId, key])
  @@map("lowcode_roles")
}

model LowCodeRolePermission {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  roleId       Int      @map("role_id")
  /// PAGE / ENTITY / FIELD / ACTION
  resourceType String   @map("resource_type") @db.VarChar(16)
  /// 页面 id / 实体 id / 字段键 / 动作键；空串代表通配
  resourceId   String   @default("") @map("resource_id") @db.VarChar(64)
  /// ["read","create","update","delete","export","hide","readonly"]
  actions      Json     @default("[]")

  @@unique([roleId, resourceType, resourceId])
  @@map("lowcode_role_permissions")
}

model LowCodeDataRule {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  /// 0 ＝ 适用全部实体
  entityId  Int      @default(0) @map("entity_id")
  /// 0 ＝ 适用全部自定义角色；内置角色不参与行级规则
  roleId    Int      @default(0) @map("role_id")
  field     String   @db.VarChar(64)
  /// = != > >= < <= IN LIKE BETWEEN
  op        String   @db.VarChar(16)
  /// 值，支持 #{me} / #{myDept} / #{myOrg}
  value     String   @default("") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, entityId])
  @@map("lowcode_data_rules")
}

model LowCodeEntity {
