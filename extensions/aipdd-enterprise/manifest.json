{
  "manifest_version": 3,
  "name": "AIPDD Enterprise",
  "version": "1.2.0",
  "description": "多平台内容分发助手：从 AIPDD Enterprise 营销工具接收内容，在你的浏览器里已登录的微博 / 小红书 / 抖音 / 知乎 / 今日头条 / 快手 / 视频号 / 知识星球 / 公众号 / 百家号 / B站 / 简书 / 豆瓣创作页自动填充并发布，账号凭据不出本机。",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AIPDD Enterprise 分发助手"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://weibo.com/*",
        "https://creator.xiaohongshu.com/*",
        "https://creator.douyin.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://mp.toutiao.com/*",
        "https://cp.kuaishou.com/*",
        "https://channels.weixin.qq.com/*",
        "https://wx.zsxq.com/*",
        "https://mp.weixin.qq.com/*",
        "https://baijiahao.baidu.com/*",
        "https://member.bilibili.com/*",
        "https://www.jianshu.com/*",
        "https://www.douban.com/*"
      ],
      "js": ["publisher.js"],
      "run_at": "document_idle"
    }
  ]
}
